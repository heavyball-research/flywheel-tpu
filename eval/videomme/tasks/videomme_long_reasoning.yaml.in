# Video-MME long videos, the Temporal Reasoning / Information Synopsis /
# Action Reasoning / Object Reasoning questions, answered with one letter.
# run_videomme.sh renders this template with the local parquet path.
task: videomme_long_reasoning
dataset_path: parquet
dataset_kwargs:
  data_files:
    test: __VIDEOMME_PARQUET__
test_split: test
output_type: generate_until
cluster_key: videoID
process_docs: !function utils.process_docs
doc_to_visual: !function utils.doc_to_visual
doc_to_text: !function utils.doc_to_text
doc_to_target: "answer"
generation_kwargs:
  max_new_tokens: 1
  temperature: 0
  top_p: 1.0
  num_beams: 1
  do_sample: false
process_results: !function utils.process_results
metric_list:
  - metric: videomme_perception_score
    aggregation: !function utils.aggregate_results
    higher_is_better: true
# lmms-eval's Qwen3-VL prompt for videomme (after VLMEvalKit's).
lmms_eval_specific_kwargs:
  default:
    format: "qwen3_vl"
    pre_prompt: "Question: "
    post_prompt: "Answer with the option letter only."
metadata:
  - version: 0.0
