+# SPDX-License-Identifier: Apache-2.0
+"""Startup config check for USE_FLYWHEEL_TPU_KERNEL."""
+
+from unittest.mock import MagicMock
+
+import pytest
+
+from tpu_inference.platforms.tpu_platform import TpuPlatform
+
+
+def make_config(
+    *,
+    block_size: int = 128,
+    cache_dtype: str = "auto",
+    enable_prefix_caching: bool = False,
+    max_num_batched_tokens: int = 8192,
+    model_dtype: str = "bfloat16",
+    head_dim: int = 128,
+    use_mla: bool = False,
+    speculative_config: MagicMock | None = None,
+    kv_transfer_config: MagicMock | None = None,
+    additional_config: dict[str, bool] | None = None,
+    pcp_size: int = 1,
+) -> MagicMock:
+    """An engine config the backend accepts unless an override breaks it."""
+    if additional_config is None:
+        additional_config = {}
+    config = MagicMock()
+    config.cache_config.block_size = block_size
+    config.cache_config.cache_dtype = cache_dtype
+    config.cache_config.enable_prefix_caching = enable_prefix_caching
+    config.scheduler_config.max_num_batched_tokens = max_num_batched_tokens
+    config.model_config.dtype = model_dtype
+    config.model_config.get_head_size.return_value = head_dim
+    config.model_config.use_mla = use_mla
+    config.speculative_config = speculative_config
+    config.kv_transfer_config = kv_transfer_config
+    config.parallel_config.prefill_context_parallel_size = pcp_size
+    # Note (david): a bare MagicMock returns a truthy object from .get(), which
+    # the check would read as continue_decode being enabled.
+    config.additional_config = additional_config
+    return config
+
+
+@pytest.fixture(autouse=True)
+def flywheel_tpu_env(monkeypatch):
+    monkeypatch.setenv("USE_FLYWHEEL_TPU_KERNEL", "1")
+    # Note (david): the accepting tests must not depend on PREFILL_SLICES
+    # being unset in the ambient environment.
+    monkeypatch.delenv("PREFILL_SLICES", raising=False)
+
+
+@pytest.mark.parametrize("enable_prefix_caching", [False, True])
+@pytest.mark.parametrize("max_num_batched_tokens", [256, 8192])
+def test_accepts_prefix_caching_and_chunked_prefill(enable_prefix_caching,
+                                                    max_num_batched_tokens):
+    TpuPlatform._check_flywheel_tpu_config(
+        make_config(enable_prefix_caching=enable_prefix_caching,
+                    max_num_batched_tokens=max_num_batched_tokens))
+
+
+def test_flag_off_skips_check(monkeypatch):
+    monkeypatch.setenv("USE_FLYWHEEL_TPU_KERNEL", "0")
+    TpuPlatform._check_flywheel_tpu_config(make_config(block_size=16))
+
+
+@pytest.mark.parametrize("overrides,match", [
+    ({
+        "block_size": 16
+    }, "block-size"),
+    ({
+        "block_size": 64
+    }, "block-size"),
+    ({
+        "cache_dtype": "fp8"
+    }, "bfloat16"),
+    ({
+        "model_dtype": "float16"
+    }, "bfloat16"),
+    ({
+        "use_mla": True
+    }, "MLA"),
+    ({
+        "head_dim": 64
+    }, "head_dim 64"),
+    ({
+        "head_dim": 192
+    }, "head_dim 192"),
+    ({
+        "speculative_config": MagicMock()
+    }, "speculative"),
+    ({
+        "kv_transfer_config": MagicMock()
+    }, "kv_transfer"),
+    ({
+        "additional_config": {
+            "enable_continue_decode": True
+        }
+    }, "continue_decode"),
+])
+def test_rejects_unsupported_config(overrides, match):
+    with pytest.raises(ValueError, match=match):
+        TpuPlatform._check_flywheel_tpu_config(make_config(**overrides))
+
+
+@pytest.mark.parametrize("pcp_size", [1, 2, 4, 8])
+def test_accepts_disaggregated_prefill_decode(monkeypatch, pcp_size):
+    monkeypatch.setenv("PREFILL_SLICES", "2x2,2x2")
+    TpuPlatform._check_flywheel_tpu_config(make_config(pcp_size=pcp_size))
+
+
+@pytest.mark.parametrize("pcp_size", [1, 2, 4, 8])
+@pytest.mark.parametrize("module_path",
+                         [None, "tpu_inference.distributed.tpu_connector"])
+def test_accepts_tpu_connector(pcp_size, module_path):
+    connector = MagicMock(kv_connector="TPUConnector",
+                          kv_connector_module_path=module_path)
+    TpuPlatform._check_flywheel_tpu_config(
+        make_config(kv_transfer_config=connector, pcp_size=pcp_size))
+
+
+@pytest.mark.parametrize("name,module_path", [
+    ("TPUConnectorHMA", "tpu_inference.distributed.tpu_connector_hma"),
+    ("TPUOffloadConnector", None),
+    ("RaidenOffloadConnector", None),
+    ("TPUConnector", "tpu_inference.distributed.tpu_raiden_connector"),
+])
+def test_rejects_unvalidated_connectors(name, module_path):
+    connector = MagicMock(kv_connector=name,
+                          kv_connector_module_path=module_path)
+    with pytest.raises(ValueError, match="only supports TPUConnector"):
+        TpuPlatform._check_flywheel_tpu_config(
+            make_config(kv_transfer_config=connector))
