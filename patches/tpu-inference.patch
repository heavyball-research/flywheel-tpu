+# SPDX-License-Identifier: Apache-2.0
+"""Correctness tests for the fused conv1d + GDN Pallas kernel."""
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+
+from flywheel_tpu.linear_attention.gdn.wrapper import fused_conv1d_gdn
+
+STATIC_ARGNAMES = ["n_kq", "n_v", "d_k", "d_v", "kernel_size"]
+N_KQ, N_V, D_K, D_V, KERNEL_SIZE = 2, 8, 128, 128, 4
+DIM = N_KQ * D_K * 2 + N_V * D_V
+# Note (david): mirrors the eps that the kernel's own l2_norm folds in.
+L2_NORM_EPS = 1e-6
+BF16_TOLERANCE = {"rtol": 2e-2, "atol": 2e-2}
+# Note (david): the state-slot tests compare two runs of the same bf16 kernel,
+# so a gap wider than this is a stale state leaking in, not rounding.
+SAME_KERNEL_TOLERANCE = {"rtol": 1e-5, "atol": 1e-5}
+
+
+@pytest.fixture(autouse=True)
+def require_tpu() -> None:
+    if jax.default_backend() != "tpu":
+        pytest.skip("Fused Pallas GDN requires TPU")
+
+
+def make_activations(
+    **activations: jax.Array,
+) -> tuple[dict[str, jax.Array], dict[str, jax.Array]]:
+    """Returns the bf16 activations the kernel takes and their f32 copies."""
+    kernel_acts = {
+        name: value.astype(jnp.bfloat16)
+        for name, value in activations.items()
+    }
+    ref_acts = {
+        name: value.astype(jnp.float32)
+        for name, value in kernel_acts.items()
+    }
+    return kernel_acts, ref_acts
+
+
+def l2_normalize(x: jax.Array) -> jax.Array:
+    x_f32 = x.astype(jnp.float32)
+    norm = jnp.sqrt(
+        jnp.sum(x_f32 * x_f32, axis=-1, keepdims=True) + L2_NORM_EPS)
+    return (x_f32 / norm).astype(x.dtype)
+
+
+def gdn_attention_ref(
+    qkv: jax.Array,
+    b: jax.Array,
+    a: jax.Array,
+    conv_state: jax.Array,
+    recurrent_state: jax.Array,
+    conv_weight: jax.Array,
+    conv_bias: jax.Array,
+    a_log: jax.Array,
+    dt_bias: jax.Array,
+    query_start_loc: jax.Array,
+    state_indices: jax.Array,
+    read_state_indices: jax.Array,
+    seq_lens: jax.Array,
+    seq_indices: range,
+    is_per_token_checkpoint: bool,
+    n_kq: int,
+    n_v: int,
+    d_k: int,
+    d_v: int,
+    kernel_size: int,
+) -> tuple[tuple[jax.Array, jax.Array], jax.Array]:
+    """Eager GDN over the sequences in seq_indices; f32 in, f32 out.
+
+    Sequence s reads slot read_state_indices[s] (zero when it has no context)
+    and checkpoints to state_indices[s], or to state_indices[s] + t for every
+    window position t when is_per_token_checkpoint is set.
+    """
+    new_conv_state = jnp.array(conv_state)
+    new_recurrent_state = jnp.array(recurrent_state)
+    output = jnp.zeros((qkv.shape[0], n_v * d_v), dtype=qkv.dtype)
+    decay_rate = -jnp.exp(a_log.astype(jnp.float32))[None, :]
+
+    def _step(
+        carry_state: jax.Array,
+        xs: tuple[jax.Array, jax.Array, jax.Array, jax.Array, jax.Array],
+    ) -> tuple[jax.Array, tuple[jax.Array, jax.Array]]:
+        q_t, k_t, v_t, beta_t, g_t = xs
+        q_scaled = q_t * (d_k**-0.5)
+        exp_g = jnp.exp(g_t)
+
+        k_state = jnp.einsum("hd, hdm -> hm", k_t, carry_state)
+        v_new = beta_t[:, None] * (v_t - exp_g[:, None] * k_state)
+
+        q_state = jnp.einsum("hd, hdm -> hm", q_scaled, carry_state)
+        q_k = jnp.sum(q_scaled * k_t, axis=-1, keepdims=True)
+        out_step = exp_g[:, None] * q_state + q_k * v_new
+
+        new_state = (carry_state * exp_g[:, None, None] +
+                     jnp.einsum("hd, hm -> hdm", k_t, v_new))
+        new_state = new_state.astype(recurrent_state.dtype)
+        return new_state, (out_step.astype(qkv.dtype), new_state)
+
+    for seq_idx in seq_indices:
+        start = int(query_start_loc[seq_idx])
+        end = int(query_start_loc[seq_idx + 1])
+        query_len = end - start
+        if query_len <= 0:
+            continue
+
+        read_slot = int(read_state_indices[seq_idx])
+        has_context = bool((seq_lens[seq_idx] - query_len) > 0)
+        if has_context:
+            initial_conv = conv_state[read_slot]
+            initial_recurrent = recurrent_state[read_slot]
+        else:
+            initial_conv = jnp.zeros_like(conv_state[read_slot])
+            initial_recurrent = jnp.zeros_like(recurrent_state[read_slot])
+
+        x_full = jnp.concatenate([initial_conv, qkv[start:end]], axis=0)
+        conv_accum = jnp.zeros((query_len, qkv.shape[-1]), dtype=jnp.float32)
+        for k in range(kernel_size):
+            conv_accum += (x_full[k:k + query_len].astype(jnp.float32) *
+                           conv_weight[:, 0, k].astype(jnp.float32)[None, :])
+        conv_accum += conv_bias.astype(jnp.float32)[None, :]
+        conv_act = jax.nn.silu(conv_accum).astype(qkv.dtype)
+
+        key_dim = n_kq * d_k
+        repeat_factor = n_v // n_kq
+        q_seq = l2_normalize(
+            jnp.repeat(conv_act[:, :key_dim].reshape(query_len, n_kq, d_k),
+                       repeat_factor,
+                       axis=1))
+        k_seq = l2_normalize(
+            jnp.repeat(conv_act[:, key_dim:key_dim * 2].reshape(
+                query_len, n_kq, d_k),
+                       repeat_factor,
+                       axis=1))
+        v_seq = conv_act[:, key_dim * 2:].reshape(query_len, n_v,
+                                                  d_v).astype(jnp.float32)
+
+        beta_seq = jax.nn.sigmoid(b[start:end].astype(jnp.float32))
+        g_seq = decay_rate * jax.nn.softplus(a[start:end].astype(
+            jnp.float32) + dt_bias.astype(jnp.float32)[None, :])
+
+        _, (out_seq,
+            step_states) = jax.lax.scan(_step, initial_recurrent,
+                                        (q_seq, k_seq, v_seq, beta_seq, g_seq))
+        output = output.at[start:end].set(out_seq.reshape(
+            query_len, n_v * d_v))
+
+        base_slot = int(state_indices[seq_idx])
+        if is_per_token_checkpoint:
+            for t in range(query_len):
+                slot = base_slot + t
+                new_conv_state = new_conv_state.at[slot].set(
+                    x_full[t + 1:t + kernel_size])
+                new_recurrent_state = new_recurrent_state.at[slot].set(
+                    step_states[t])
+        else:
+            new_conv_state = new_conv_state.at[base_slot].set(
+                x_full[-(kernel_size - 1):])
+            new_recurrent_state = new_recurrent_state.at[base_slot].set(
+                step_states[-1])
+
+    return (new_conv_state, new_recurrent_state), output
+
+
+@pytest.mark.parametrize(
+    "max_reqs, lengths, token_starts, seq_distribution",
+    [
+        pytest.param(1, [8192], [0, 8192], [0, 0, 1], id="prefill"),
+        pytest.param(3, [256, 128, 128], [0, 256, 384, 512], [0, 3, 3],
+                     id="mixed"),
+        pytest.param(
+            64, [1] * 64, list(range(65)), [64, 64, 64], id="decode_only"),
+        pytest.param(11, [1] * 8 + [128, 128, 256],
+                     [0, 1, 2, 3, 4, 5, 6, 7, 8, 136, 264, 520], [8, 11, 11],
+                     id="mixed_prefill_decode"),
+        pytest.param(16, [128, 64, 32, 16, 8],
+                     [0, 128, 192, 224, 240, 248] + [1] * 11, [0, 5, 5],
+                     id="padded_mixed_prefill"),
+        pytest.param(512, [1] * 64,
+                     list(range(65)) + [1] * 448, [64, 64, 64],
+                     id="padded_decode_only"),
+    ],
+)
+def test_fused_matches_reference(max_reqs: int, lengths: list[int],
+                                 token_starts: list[int],
+                                 seq_distribution: list[int]) -> None:
+    num_tokens = sum(lengths)
+    query_start_loc = jnp.array(token_starts)
+    distribution = jnp.array(seq_distribution, dtype=jnp.int32)
+
+    # Note (david): slot 0 of both caches is the null block that padded and
+    # invalid tokens write to, so live sequences start at slot 1.
+    state_indices = jnp.arange(1, max_reqs + 1)
+    num_blocks = max_reqs + 1
+
+    rngs = iter(jax.random.split(jax.random.key(0), 12))
+    query = jax.random.normal(next(rngs), (num_tokens, N_KQ * D_K))
+    key = jax.random.normal(next(rngs), (num_tokens, N_KQ * D_K))
+    value = jax.random.normal(next(rngs), (num_tokens, N_V * D_V))
+    b = jax.random.normal(next(rngs), (num_tokens, N_V))
+    a = jax.random.normal(next(rngs), (num_tokens, N_V))
+
+    conv_weight_q = jax.random.normal(next(rngs), (N_KQ * D_K, 1, KERNEL_SIZE))
+    conv_weight_k = jax.random.normal(next(rngs), (N_KQ * D_K, 1, KERNEL_SIZE))
+    conv_weight_v = jax.random.normal(next(rngs), (N_V * D_V, 1, KERNEL_SIZE))
+    conv_bias_q = jax.random.normal(next(rngs), (N_KQ * D_K, ))
+    conv_bias_k = jax.random.normal(next(rngs), (N_KQ * D_K, ))
+    conv_bias_v = jax.random.normal(next(rngs), (N_V * D_V, ))
+    a_log = jax.random.normal(next(rngs), (N_V, ))
+    dt_bias = jax.random.normal(jax.random.key(0), (N_V, ))
+
+    mixed_qkv = jnp.concatenate([query, key, value], axis=-1)
+    conv_weight = jnp.concatenate(
+        [conv_weight_q, conv_weight_k, conv_weight_v], axis=0)
+    conv_bias = jnp.concatenate([conv_bias_q, conv_bias_k, conv_bias_v],
+                                axis=-1)
+
+    # Note (david): seq_lens == query_lens means context_len is 0, so every
+    # sequence starts from a zero state whatever its slot holds.
+    seq_lens = jnp.asarray(query_start_loc[1:max_reqs + 1] -
+                           query_start_loc[:max_reqs],
+                           dtype=jnp.int32)
+
+    kernel_acts, ref_acts = make_activations(qkv=mixed_qkv, b=b, a=a)
+    common_kwargs = {
+        "conv_state": jnp.zeros((num_blocks, KERNEL_SIZE - 1, DIM)),
+        "recurrent_state": jnp.zeros((num_blocks, N_V, D_K, D_V)),
+        "conv_weight": conv_weight,
+        "conv_bias": conv_bias,
+        "a_log": a_log,
+        "dt_bias": dt_bias,
+        "query_start_loc": query_start_loc,
+        "state_indices": state_indices,
+        "read_state_indices": state_indices,
+        "seq_lens": seq_lens,
+        "n_kq": N_KQ,
+        "n_v": N_V,
+        "d_k": D_K,
+        "d_v": D_V,
+        "kernel_size": KERNEL_SIZE,
+    }
+
+    (conv_ref,
+     rec_ref), output_ref = gdn_attention_ref(**ref_acts,
+                                              **common_kwargs,
+                                              seq_indices=range(
+                                                  int(distribution[2])),
+                                              is_per_token_checkpoint=False)
+    fused = jax.jit(fused_conv1d_gdn, static_argnames=STATIC_ARGNAMES)
+    (conv_out, rec_out), output = fused(**kernel_acts,
+                                        **common_kwargs,
+                                        distribution=distribution)
+
+    np.testing.assert_allclose(output.astype(jnp.float32), output_ref,
+                               **BF16_TOLERANCE)
+    np.testing.assert_allclose(conv_out, conv_ref, **BF16_TOLERANCE)
+    np.testing.assert_allclose(rec_out, rec_ref, **BF16_TOLERANCE)
+
+
+@pytest.mark.parametrize(
+    "spec_lengths, spec_read_offsets, prefill_lengths",
+    [
+        pytest.param([5, 3, 1], [2, 0, 4], [], id="spec_windows"),
+        pytest.param([5, 1, 3, 2, 4], [0, 1, 2, 3, 4], [],
+                     id="spec_windows_padded"),
+        pytest.param([5, 2], [3, 1], [64], id="spec_and_prefill"),
+    ],
+)
+def test_spec_mode_checkpoints(spec_lengths: list[int],
+                               spec_read_offsets: list[int],
+                               prefill_lengths: list[int]) -> None:
+    """Spec windows read base + read_offset and checkpoint every position to
+    base + t, while prefills in the same batch keep the per-sequence
+    read/write of the base slot."""
+    num_spec_tokens = 4
+    window = num_spec_tokens + 1
+    lengths = list(spec_lengths) + list(prefill_lengths)
+    num_seqs = len(lengths)
+    num_spec_seqs = len(spec_lengths)
+    num_tokens = sum(lengths)
+
+    query_start_loc = jnp.array(np.concatenate([[0], np.cumsum(lengths)]),
+                                dtype=jnp.int32)
+    distribution = jnp.array([num_spec_seqs, num_spec_seqs, num_seqs],
+                             dtype=jnp.int32)
+    # Note (david): each sequence owns a run of window consecutive slots so a
+    # per-token checkpoint has somewhere to land; slot 0 is the null block.
+    state_indices = jnp.array([1 + i * window for i in range(num_seqs)],
+                              dtype=jnp.int32)
+    num_blocks = 1 + num_seqs * window
+    read_offsets = jnp.array(list(spec_read_offsets) +
+                             [0] * len(prefill_lengths),
+                             dtype=jnp.int32)
+    # Note (david): spec windows continue an existing context; prefills start
+    # fresh, which is what makes the two checkpoint modes meet in one batch.
+    seq_lens = jnp.array([16 + length
+                          for length in spec_lengths] + list(prefill_lengths),
+                         dtype=jnp.int32)
+
+    rngs = iter(jax.random.split(jax.random.key(3), 12))
+    mixed_qkv = jax.random.normal(next(rngs), (num_tokens, DIM))
+    b = jax.random.normal(next(rngs), (num_tokens, N_V))
+    a = jax.random.normal(next(rngs), (num_tokens, N_V))
+    # Note (david): every slot holds a distinct random state, so a read from
+    # or a write to the wrong slot shows up as a mismatch.
+    conv_state = jax.random.normal(next(rngs),
+                                   (num_blocks, KERNEL_SIZE - 1, DIM))
+    recurrent_state = jax.random.normal(next(rngs),
+                                        (num_blocks, N_V, D_K, D_V))
+    conv_weight = jax.random.normal(next(rngs), (DIM, 1, KERNEL_SIZE))
+    conv_bias = jax.random.normal(next(rngs), (DIM, ))
+    a_log = jax.random.normal(next(rngs), (N_V, ))
+    dt_bias = jax.random.normal(next(rngs), (N_V, ))
+
+    kernel_acts, ref_acts = make_activations(qkv=mixed_qkv, b=b, a=a)
+    fused = jax.jit(fused_conv1d_gdn,
+                    static_argnames=STATIC_ARGNAMES + ["num_spec_tokens"])
+    (conv_out, rec_out), output = fused(**kernel_acts,
+                                        conv_state=conv_state,
+                                        recurrent_state=recurrent_state,
+                                        conv_weight=conv_weight,
+                                        conv_bias=conv_bias,
+                                        a_log=a_log,
+                                        dt_bias=dt_bias,
+                                        query_start_loc=query_start_loc,
+                                        state_indices=state_indices,
+                                        distribution=distribution,
+                                        seq_lens=seq_lens,
+                                        read_state_indices=state_indices,
+                                        read_offsets=read_offsets,
+                                        n_kq=N_KQ,
+                                        n_v=N_V,
+                                        d_k=D_K,
+                                        d_v=D_V,
+                                        kernel_size=KERNEL_SIZE,
+                                        num_spec_tokens=num_spec_tokens)
+
+    common_kwargs = dict(**ref_acts,
+                         conv_weight=conv_weight,
+                         conv_bias=conv_bias,
+                         a_log=a_log,
+                         dt_bias=dt_bias,
+                         query_start_loc=query_start_loc,
+                         state_indices=state_indices,
+                         seq_lens=seq_lens,
+                         n_kq=N_KQ,
+                         n_v=N_V,
+                         d_k=D_K,
+                         d_v=D_V,
+                         kernel_size=KERNEL_SIZE)
+    (conv_ref, rec_ref), output_ref = gdn_attention_ref(
+        conv_state=conv_state,
+        recurrent_state=recurrent_state,
+        read_state_indices=state_indices + read_offsets,
+        seq_indices=range(num_spec_seqs),
+        is_per_token_checkpoint=True,
+        **common_kwargs)
+    if prefill_lengths:
+        (conv_ref, rec_ref), tail_output = gdn_attention_ref(
+            conv_state=conv_ref,
+            recurrent_state=rec_ref,
+            read_state_indices=state_indices,
+            seq_indices=range(num_spec_seqs, num_seqs),
+            is_per_token_checkpoint=False,
+            **common_kwargs)
+        tail_start = int(query_start_loc[num_spec_seqs])
+        output_ref = output_ref.at[tail_start:].set(tail_output[tail_start:])
+
+    np.testing.assert_allclose(output.astype(jnp.float32), output_ref,
+                               **BF16_TOLERANCE)
+
+    touched_slots = set()
+    for i, length in enumerate(spec_lengths):
+        base_slot = int(state_indices[i])
+        touched_slots.update(range(base_slot, base_slot + length))
+    touched_slots.update(
+        int(state_indices[num_spec_seqs + i])
+        for i in range(len(prefill_lengths)))
+    for slot in range(num_blocks):
+        if slot in touched_slots:
+            expected_conv = conv_ref[slot]
+            expected_rec = rec_ref[slot]
+        else:
+            expected_conv = conv_state[slot]
+            expected_rec = recurrent_state[slot]
+        np.testing.assert_allclose(conv_out[slot],
+                                   expected_conv,
+                                   **BF16_TOLERANCE,
+                                   err_msg=f"conv slot {slot}")
+        np.testing.assert_allclose(rec_out[slot],
+                                   expected_rec,
+                                   **BF16_TOLERANCE,
+                                   err_msg=f"recurrent slot {slot}")
+
+
+def test_stale_slot_is_ignored_without_context() -> None:
+    """A prefill landing on a slot that a freed request left dirty must match
+    the same prefill on a zeroed slot: vLLM's mamba pool hands out slots
+    without clearing them."""
+    max_reqs = 2
+    lengths = [64, 64]
+    num_tokens = sum(lengths)
+    num_blocks = max_reqs + 1
+    state_indices = jnp.arange(1, max_reqs + 1)
+
+    rngs = iter(jax.random.split(jax.random.key(7), 12))
+    query = jax.random.normal(next(rngs), (num_tokens, N_KQ * D_K))
+    key = jax.random.normal(next(rngs), (num_tokens, N_KQ * D_K))
+    value = jax.random.normal(next(rngs), (num_tokens, N_V * D_V))
+    b = jax.random.normal(next(rngs), (num_tokens, N_V))
+    a = jax.random.normal(next(rngs), (num_tokens, N_V))
+    stale_conv = jax.random.normal(next(rngs),
+                                   (num_blocks, KERNEL_SIZE - 1, DIM))
+    stale_recurrent = jax.random.normal(next(rngs),
+                                        (num_blocks, N_V, D_K, D_V))
+    conv_weight = jax.random.normal(next(rngs), (DIM, 1, KERNEL_SIZE))
+    conv_bias = jax.random.normal(next(rngs), (DIM, ))
+    a_log = jax.random.normal(next(rngs), (N_V, ))
+    dt_bias = jax.random.normal(next(rngs), (N_V, ))
+
+    conv_state_fresh = jnp.zeros((num_blocks, KERNEL_SIZE - 1, DIM))
+    recurrent_state_fresh = jnp.zeros((num_blocks, N_V, D_K, D_V))
+    # Note (david): slot 0 is the null block and stays zero in both runs.
+    conv_state_stale = conv_state_fresh.at[1:].set(stale_conv[1:])
+    recurrent_state_stale = recurrent_state_fresh.at[1:].set(
+        stale_recurrent[1:])
+
+    kernel_acts, _ = make_activations(qkv=jnp.concatenate([query, key, value],
+                                                          axis=-1),
+                                      b=b,
+                                      a=a)
+    fused = jax.jit(fused_conv1d_gdn, static_argnames=STATIC_ARGNAMES)
+    common_kwargs = dict(**kernel_acts,
+                         conv_weight=conv_weight,
+                         conv_bias=conv_bias,
+                         a_log=a_log,
+                         dt_bias=dt_bias,
+                         query_start_loc=jnp.array([0, lengths[0],
+                                                    num_tokens]),
+                         state_indices=state_indices,
+                         distribution=jnp.array([0, 2, 2], dtype=jnp.int32),
+                         seq_lens=jnp.asarray(lengths, dtype=jnp.int32),
+                         read_state_indices=state_indices,
+                         n_kq=N_KQ,
+                         n_v=N_V,
+                         d_k=D_K,
+                         d_v=D_V,
+                         kernel_size=KERNEL_SIZE)
+
+    (conv_fresh,
+     rec_fresh), output_fresh = fused(conv_state=conv_state_fresh,
+                                      recurrent_state=recurrent_state_fresh,
+                                      **common_kwargs)
+    (conv_stale,
+     rec_stale), output_stale = fused(conv_state=conv_state_stale,
+                                      recurrent_state=recurrent_state_stale,
+                                      **common_kwargs)
+
+    np.testing.assert_allclose(output_fresh.astype(jnp.float32),
+                               output_stale.astype(jnp.float32),
+                               **SAME_KERNEL_TOLERANCE)
+    np.testing.assert_allclose(conv_fresh[1:max_reqs + 1],
+                               conv_stale[1:max_reqs + 1],
+                               **SAME_KERNEL_TOLERANCE)
+    np.testing.assert_allclose(rec_fresh[1:max_reqs + 1],
+                               rec_stale[1:max_reqs + 1],
+                               **SAME_KERNEL_TOLERANCE)
+
+
+def test_context_resumes_from_written_slot() -> None:
+    """Chunked prefill: a second chunk reported with a non-zero context_len
+    resumes from the slot the first chunk wrote, so the two chunks together
+    reproduce a single-shot prefill over the same tokens."""
+    chunk_len = 32
+    total_len = 64
+    num_blocks = 2
+    state_indices = jnp.array([1])
+
+    rngs = iter(jax.random.split(jax.random.key(11), 12))
+    query = jax.random.normal(next(rngs), (total_len, N_KQ * D_K))
+    key = jax.random.normal(next(rngs), (total_len, N_KQ * D_K))
+    value = jax.random.normal(next(rngs), (total_len, N_V * D_V))
+    b = jax.random.normal(next(rngs), (total_len, N_V))
+    a = jax.random.normal(next(rngs), (total_len, N_V))
+    conv_weight = jax.random.normal(next(rngs), (DIM, 1, KERNEL_SIZE))
+    conv_bias = jax.random.normal(next(rngs), (DIM, ))
+    a_log = jax.random.normal(next(rngs), (N_V, ))
+    dt_bias = jax.random.normal(next(rngs), (N_V, ))
+
+    kernel_acts, _ = make_activations(qkv=jnp.concatenate([query, key, value],
+                                                          axis=-1),
+                                      b=b,
+                                      a=a)
+    qkv, b, a = kernel_acts["qkv"], kernel_acts["b"], kernel_acts["a"]
+
+    conv_state_zero = jnp.zeros((num_blocks, KERNEL_SIZE - 1, DIM))
+    recurrent_state_zero = jnp.zeros((num_blocks, N_V, D_K, D_V))
+
+    fused = jax.jit(fused_conv1d_gdn, static_argnames=STATIC_ARGNAMES)
+    common_kwargs = {
+        "conv_weight": conv_weight,
+        "conv_bias": conv_bias,
+        "a_log": a_log,
+        "dt_bias": dt_bias,
+        "state_indices": state_indices,
+        "read_state_indices": state_indices,
+        "distribution": jnp.array([0, 1, 1], dtype=jnp.int32),
+        "n_kq": N_KQ,
+        "n_v": N_V,
+        "d_k": D_K,
+        "d_v": D_V,
+        "kernel_size": KERNEL_SIZE,
+    }
+
+    _, output_ref = fused(qkv=qkv,
+                          b=b,
+                          a=a,
+                          conv_state=conv_state_zero,
+                          recurrent_state=recurrent_state_zero,
+                          query_start_loc=jnp.array([0, total_len]),
+                          seq_lens=jnp.array([total_len], dtype=jnp.int32),
+                          **common_kwargs)
+    (conv_after_first, rec_after_first), output_first = fused(
+        qkv=qkv[:chunk_len],
+        b=b[:chunk_len],
+        a=a[:chunk_len],
+        conv_state=conv_state_zero,
+        recurrent_state=recurrent_state_zero,
+        query_start_loc=jnp.array([0, chunk_len]),
+        seq_lens=jnp.array([chunk_len], dtype=jnp.int32),
+        **common_kwargs)
+    # Note (david): seq_lens total_len against a query_len of chunk_len is
+    # what reports a non-zero context_len, so the kernel reads the slot the
+    # first chunk wrote instead of starting from zero.
+    _, output_second = fused(qkv=qkv[chunk_len:],
+                             b=b[chunk_len:],
+                             a=a[chunk_len:],
+                             conv_state=conv_after_first,
+                             recurrent_state=rec_after_first,
+                             query_start_loc=jnp.array([0, chunk_len]),
+                             seq_lens=jnp.array([total_len], dtype=jnp.int32),
+                             **common_kwargs)
+
+    output_ref = output_ref.astype(jnp.float32)
+    np.testing.assert_allclose(output_first.astype(jnp.float32),
+                               output_ref[:chunk_len], **BF16_TOLERANCE)
+    np.testing.assert_allclose(output_second.astype(jnp.float32),
+                               output_ref[chunk_len:], **BF16_TOLERANCE)
+
