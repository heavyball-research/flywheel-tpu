@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Backbone variants the FlyWheel backend warms for each token bucket."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from tpu_inference.layers.common.flywheel_tpu_attention import (
+    DECODE_PHASE, EXTEND_PHASE, PREFILL_PHASE, dense_prefill_shape,
+    single_request_dense_seq_len, varlen_block_span, varlen_block_spans)
+from tpu_inference.runner.compilation_manager import CompilationManager
+
+TOKEN_PADDINGS = [16, 128, 1024]
+MAX_NUM_REQS = 64
+# Note (david): a decode step carries one token per request, so 128 is the
+# smallest TOKEN_PADDINGS bucket that holds a full MAX_NUM_REQS batch.
+MAX_DECODE_BUCKET = 128
+
+
+def make_manager(dp_size: int = 1) -> CompilationManager:
+    manager = CompilationManager.__new__(CompilationManager)
+    manager.runner = SimpleNamespace(
+        num_tokens_paddings=TOKEN_PADDINGS,
+        max_num_reqs=MAX_NUM_REQS,
+        vllm_config=SimpleNamespace(sharding_config=SimpleNamespace(
+            total_dp_size=dp_size)))
+    return manager
+
+
+@pytest.mark.parametrize("num_tokens", TOKEN_PADDINGS)
+def test_every_phase_is_precompiled_at_every_bucket(monkeypatch, num_tokens):
+    monkeypatch.setenv("USE_FLYWHEEL_TPU_KERNEL", "1")
+    phases = {
+        phase
+        for phase, _, _ in make_manager()._flash_attn_variants(num_tokens)
+    }
+    assert EXTEND_PHASE in phases
+    assert PREFILL_PHASE in phases
+    assert (DECODE_PHASE in phases) == (num_tokens <= MAX_DECODE_BUCKET)
+
+
+@pytest.mark.parametrize("num_tokens", TOKEN_PADDINGS)
+@pytest.mark.parametrize("dp_size", [1, 2])
+def test_every_reachable_span_is_precompiled(monkeypatch, num_tokens, dp_size):
+    """An unwarmed (phase, span) pair traces a fresh Pallas backbone
+    mid-serving, so every span the cost model can return must be warmed."""
+    monkeypatch.setenv("USE_FLYWHEEL_TPU_KERNEL", "1")
+    variants = make_manager(dp_size)._flash_attn_variants(num_tokens)
+    bucket = num_tokens // dp_size
+    spans = [
+        span for phase, span, dense_seq_len in variants
+        if phase == PREFILL_PHASE and dense_seq_len < 0
+    ]
+    assert sorted(spans) == sorted(varlen_block_spans(bucket))
+    # Note (david): a rank never schedules more than its bucket holds, so the
+    # probe clamps; the request counts reach the narrow spans a lone request
+    # never asks for now that the pad tail is charged.
+    for longest_seq_len in (1, 5, 137, 1024, 4096, 100000):
+        assert varlen_block_span([[min(longest_seq_len, bucket)]] * dp_size,
+                                 bucket) in spans
+    for count in (1, 2, 4, 8, 16, 32, 64):
+        if bucket // count:
+            assert varlen_block_span([[bucket // count] * count] * dp_size,
+                                     bucket) in spans
+
+
+@pytest.mark.parametrize("num_tokens", TOKEN_PADDINGS)
+def test_only_prefill_carries_a_block_span(monkeypatch, num_tokens):
+    monkeypatch.setenv("USE_FLYWHEEL_TPU_KERNEL", "1")
+    variants = make_manager()._flash_attn_variants(num_tokens)
+    assert {span
+            for phase, span, _ in variants if phase != PREFILL_PHASE} == {-1}
+
+
+@pytest.mark.parametrize("num_tokens", TOKEN_PADDINGS)
+@pytest.mark.parametrize("dp_size", [1, 2])
+def test_single_request_dense_row_is_precompiled(monkeypatch, num_tokens,
+                                                 dp_size):
+    """A lone prompt near the top of its bucket runs dense at (1, bucket),
+    so that row is warmed wherever dense_prefill_shape can return it."""
+    monkeypatch.setenv("USE_FLYWHEEL_TPU_KERNEL", "1")
+    variants = make_manager(dp_size)._flash_attn_variants(num_tokens)
+    bucket = num_tokens // dp_size
+    dense = [(phase, span, dense_seq_len)
+             for phase, span, dense_seq_len in variants if dense_seq_len > 0]
+    expected = single_request_dense_seq_len(bucket)
+    assert dense == ([(PREFILL_PHASE, -1, expected)] if expected > 0 else [])
+    for length in range(1, bucket + 1):
+        shape = dense_prefill_shape([[length]] * dp_size, bucket)
+        assert shape in {(-1, -1), (1, expected)}
+
+
+def test_other_backends_keep_empty_phase(monkeypatch):
+    monkeypatch.setenv("USE_FLYWHEEL_TPU_KERNEL", "0")
+    manager = CompilationManager.__new__(CompilationManager)
+    assert manager._flash_attn_variants(16) == [("", -1, -1)]
