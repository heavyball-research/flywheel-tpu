+    contiguous = np.arange(40, dtype=np.int32)
+    head_tail = contiguous[::-1]
+    for indices in (contiguous, head_tail):
+        np.testing.assert_array_equal(
+            _simulate_sparse_pcp_selection(array, indices, 4), array[indices])
+
+
+def test_sparse_pcp_selection_preserves_negative_and_clipped_indices():
+    array = np.arange(16 * 5, dtype=np.int32).reshape(16, 5)
+    indices = np.array([-17, -1, 0, 15, 16, 99], np.int32)
+    expected_indices = np.array([0, 15, 0, 15, 15, 15])
+    np.testing.assert_array_equal(
+        _simulate_sparse_pcp_selection(array, indices, 2),
+        array[expected_indices])
+
+
+def test_actual_sparse_selector_compiles_with_static_keyword(monkeypatch):
+    if len(jax.devices()) < 2:
+        pytest.skip("requires two CPU devices via XLA_FLAGS")
+    monkeypatch.setattr(sharding_mod.ShardingAxisName, "_cls",
