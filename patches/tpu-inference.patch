+# SPDX-License-Identifier: Apache-2.0
+"""Correctness tests for the fused conv1d + KDA Pallas kernel."""
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+
+from flywheel_tpu.linear_attention.kda.compute_kda import (
+    ChunkKDA, block_diag, pack_width, unpack_lanes)
+from flywheel_tpu.linear_attention.kda.wrapper import fused_conv1d_kda
+
+STATIC_ARGNAMES = [
+    "n_kq", "n_v", "d_k", "d_v", "kernel_size", "num_spec_tokens",
+    "lower_bound"
+]
+N_KQ, N_V, D_K, D_V, KERNEL_SIZE = 2, 8, 128, 128, 4
+DIM = N_KQ * D_K * 2 + N_V * D_V
+L2_NORM_EPS = 1e-6
+BF16_TOLERANCE = {"rtol": 2e-2, "atol": 2e-2}
+# Note (david): the gate lower bound the KDA attention layer defaults to, so
+# the safe-gate parametrization exercises the shape production actually runs.
+SAFE_GATE_LOWER_BOUND = -5.0
+# Note (david): Ling-3.0-tiny uses 16 equal Q/K/V heads of 128 channels, a
+# head layout the other parametrizations (2 kq heads, 8 v heads) never reach.
+LING_NUM_HEADS = 16
+
+
+def l2_normalize(x: jax.Array) -> jax.Array:
+    return x / jnp.sqrt(jnp.sum(x * x, axis=-1, keepdims=True) + L2_NORM_EPS)
+
+
+def make_inputs(
+    key: jax.Array,
+    num_tokens: int,
+    gate_scale: float,
+    n_kq: int,
+    n_v: int,
+) -> tuple[dict[str, jax.Array], dict[str, jax.Array], dict[str, jax.Array]]:
+    """Returns the bf16 activations, their f32 copies and the conv weights."""
+    keys = iter(jax.random.split(key, 8))
+    dim = n_kq * D_K * 2 + n_v * D_V
+    acts = {
+        "qkv":
+        jax.random.normal(next(keys), (num_tokens, dim)),
+        "b":
+        jax.random.normal(next(keys), (num_tokens, n_v)),
+        # Note (david): shifting the raw gate positive makes softplus about
+        # gate_scale, so a channel decays by e^-10..e^-30 per token and the
+        # kernel's gate accumulation is stressed rather than idling near 1.
+        "g":
+        jax.random.normal(next(keys),
+                          (num_tokens, n_v * D_K)) * gate_scale + gate_scale,
+    }
+    kernel_acts = {
+        name: value.astype(jnp.bfloat16)
+        for name, value in acts.items()
+    }
+    ref_acts = {
+        name: value.astype(jnp.float32)
+        for name, value in kernel_acts.items()
+    }
+    weights = {
+        "conv_weight": jax.random.normal(next(keys), (dim, 1, KERNEL_SIZE)),
+        "conv_bias": jax.random.normal(next(keys), (dim, )),
+        "a_log": jax.random.normal(next(keys), (n_v, )),
+        "dt_bias": jax.random.normal(next(keys), (n_v * D_K, )),
+    }
+    return kernel_acts, ref_acts, weights
+
+
+def kda_reference(
+    qkv: jax.Array,
+    b: jax.Array,
+    g: jax.Array,
+    conv_state: jax.Array,
+    recurrent_state: jax.Array,
+    conv_weight: jax.Array,
+    conv_bias: jax.Array,
+    a_log: jax.Array,
+    dt_bias: jax.Array,
+    query_start_loc: jax.Array,
+    state_indices: jax.Array,
+    read_state_indices: jax.Array,
+    seq_lens: jax.Array,
+    seq_indices: range,
+    is_per_token_checkpoint: bool,
+    n_kq: int,
+    n_v: int,
+    lower_bound: float | None,
+) -> tuple[tuple[jax.Array, jax.Array], jax.Array]:
+    """Eager KDA over the sequences in seq_indices; f32 in, f32 out.
+
+    Sequence s reads slot read_state_indices[s] (zero when it has no context)
+    and checkpoints to state_indices[s], or to state_indices[s] + t for every
+    window position t when is_per_token_checkpoint is set.
+    """
+    new_conv_state = jnp.array(conv_state)
+    new_recurrent_state = jnp.array(recurrent_state)
+    output = jnp.zeros((qkv.shape[0], n_v * D_V), jnp.float32)
+    exp_a = jnp.exp(a_log)[:, None]
+    dt_bias_per_channel = dt_bias.reshape(n_v, D_K)
+
+    def _step(
+        state: jax.Array,
+        xs: tuple[jax.Array, jax.Array, jax.Array, jax.Array, jax.Array],
+    ) -> tuple[jax.Array, tuple[jax.Array, jax.Array]]:
+        q_t, k_t, v_t, beta_t, g_t = xs
+        decayed = state * jnp.exp(g_t)[:, :, None]  # [n_v, d_k, d_v]
+        v_new = beta_t[:,
+                       None] * (v_t - jnp.einsum("hd,hdm->hm", k_t, decayed))
+        new_state = decayed + jnp.einsum("hd,hm->hdm", k_t, v_new)
+        out_step = jnp.einsum("hd,hdm->hm", q_t, new_state) * D_K**-0.5
+        return new_state, (out_step, new_state)
+
+    for seq_idx in seq_indices:
+        start = int(query_start_loc[seq_idx])
+        end = int(query_start_loc[seq_idx + 1])
+        query_len = end - start
+        if query_len <= 0:
+            continue
+
+        read_slot = int(read_state_indices[seq_idx])
+        has_context = int(seq_lens[seq_idx]) - query_len > 0
+        if has_context:
+            initial_conv = conv_state[read_slot]
+            initial_recurrent = recurrent_state[read_slot]
+        else:
+            initial_conv = jnp.zeros_like(conv_state[read_slot])
+            initial_recurrent = jnp.zeros_like(recurrent_state[read_slot])
+
+        x_full = jnp.concatenate([initial_conv, qkv[start:end]], axis=0)
+        conv_out = sum(x_full[k:k + query_len] * conv_weight[:, 0, k][None]
+                       for k in range(KERNEL_SIZE)) + conv_bias[None]
+        conv_act = jax.nn.silu(conv_out)
+
+        key_dim = n_kq * D_K
+        repeat_factor = n_v // n_kq
+        q_seq = l2_normalize(conv_act[:, :key_dim].reshape(
+            query_len, n_kq, D_K)).repeat(repeat_factor, 1)
+        k_seq = l2_normalize(conv_act[:, key_dim:2 * key_dim].reshape(
+            query_len, n_kq, D_K)).repeat(repeat_factor, 1)
+        v_seq = conv_act[:, 2 * key_dim:].reshape(query_len, n_v, D_V)
+        beta_seq = jax.nn.sigmoid(b[start:end])
+        shifted_gate = (g[start:end].reshape(query_len, n_v, D_K) +
+                        dt_bias_per_channel)
+        if lower_bound is None:
+            gate_seq = -exp_a * jax.nn.softplus(shifted_gate)
+        else:
+            gate_seq = lower_bound * jax.nn.sigmoid(exp_a * shifted_gate)
+
+        _, (out_seq, step_states) = jax.lax.scan(
+            _step, initial_recurrent,
+            (q_seq, k_seq, v_seq, beta_seq, gate_seq))
+        output = output.at[start:end].set(out_seq.reshape(query_len, -1))
+
+        base_slot = int(state_indices[seq_idx])
+        if is_per_token_checkpoint:
+            for t in range(query_len):
+                slot = base_slot + t
+                new_conv_state = new_conv_state.at[slot].set(
+                    x_full[t + 1:t + KERNEL_SIZE])
+                new_recurrent_state = new_recurrent_state.at[slot].set(
+                    step_states[t])
+        else:
+            new_conv_state = new_conv_state.at[base_slot].set(
+                x_full[-(KERNEL_SIZE - 1):])
+            new_recurrent_state = new_recurrent_state.at[base_slot].set(
+                step_states[-1])
+
+    return (new_conv_state, new_recurrent_state), output
+
+
+def test_ling_safe_gate_prefill_to_decode() -> None:
+    """Ling-3.0 head layout with the safe gate: a 129-token prefill and the
+    decode step that follows it both track the eager reference, the decode
+    resuming from the slot the prefill checkpointed."""
+    if jax.default_backend() != "tpu":
+        pytest.skip("Fused Pallas KDA requires TPU")
+
+    ling_dim = LING_NUM_HEADS * D_K * 2 + LING_NUM_HEADS * D_V
+    conv_state = jnp.zeros((2, KERNEL_SIZE - 1, ling_dim), jnp.bfloat16)
+    recurrent_state = jnp.zeros((2, LING_NUM_HEADS, D_K, D_V), jnp.float32)
+    state_indices = jnp.array([1], jnp.int32)
+    _, _, weights = make_inputs(jax.random.key(0),
+                                1,
+                                1.0,
+                                n_kq=LING_NUM_HEADS,
+                                n_v=LING_NUM_HEADS)
+
+    total_tokens = 0
+    for query_len in (129, 1):
+        total_tokens += query_len
+        kernel_acts, ref_acts, _ = make_inputs(jax.random.key(total_tokens),
+                                               query_len,
+                                               1.0,
+                                               n_kq=LING_NUM_HEADS,
+                                               n_v=LING_NUM_HEADS)
+        query_start_loc = jnp.array([0, query_len], jnp.int32)
+        # Note (david): seq_lens accumulates across the two steps, so the
+        # decode reports a context and has to read the prefill's checkpoint.
+        seq_lens = jnp.array([total_tokens], jnp.int32)
+
+        expected_states, expected_out = kda_reference(
+            **ref_acts,
+            **weights,
+            conv_state=conv_state.astype(jnp.float32),
+            recurrent_state=recurrent_state,
+            query_start_loc=query_start_loc,
+            state_indices=state_indices,
+            read_state_indices=state_indices,
+            seq_lens=seq_lens,
+            seq_indices=range(1),
+            is_per_token_checkpoint=False,
+            n_kq=LING_NUM_HEADS,
+            n_v=LING_NUM_HEADS,
+            lower_bound=SAFE_GATE_LOWER_BOUND)
+        (conv_state, recurrent_state
+         ), output = fused_conv1d_kda(**kernel_acts,
+                                      **weights,
+                                      conv_state=conv_state,
+                                      recurrent_state=recurrent_state,
+                                      query_start_loc=query_start_loc,
+                                      state_indices=state_indices,
+                                      read_state_indices=state_indices,
+                                      distribution=jnp.array(
+                                          [int(query_len == 1), 1, 1],
+                                          jnp.int32),
+                                      seq_lens=seq_lens,
+                                      n_kq=LING_NUM_HEADS,
+                                      n_v=LING_NUM_HEADS,
+                                      d_k=D_K,
+                                      d_v=D_V,
+                                      kernel_size=KERNEL_SIZE,
+                                      lower_bound=SAFE_GATE_LOWER_BOUND)
+
+        for actual, expected in zip((output, conv_state, recurrent_state),
+                                    (expected_out, *expected_states),
+                                    strict=True):
+            np.testing.assert_allclose(actual.astype(jnp.float32), expected,
+                                       **BF16_TOLERANCE)
+
+
+@pytest.mark.parametrize("chunk_size, num_heads", [(4, 1), (16, 8), (64, 4),
+                                                   (128, 1)])
+@pytest.mark.parametrize("gate_scale", [0.0, 1.0, 20.0])
+def test_qk_kk_operands_match_reference(chunk_size: int, num_heads: int,
+                                        gate_scale: float) -> None:
+    """The packed decayed operands and their masks must reproduce the dense
+    causal sum_d q[i,d] k[j,d] exp(G[i,d] - G[j,d]) for both the Aqk and the
+    Akk term, covering each causal entry exactly once."""
+    head_dim = 16
+    rng = np.random.default_rng(0)
+    q, k = rng.normal(size=(2, num_heads, chunk_size,
+                            head_dim)).astype(np.float32)
+    q /= np.linalg.norm(q, axis=-1, keepdims=True)
+    k /= np.linalg.norm(k, axis=-1, keepdims=True)
+    beta = rng.uniform(size=(num_heads, chunk_size, 1)).astype(np.float32)
+    g_cumsum = -np.cumsum(
+        rng.uniform(size=k.shape).astype(np.float32) * gate_scale, axis=1)
+
+    # Note (david): __new__ skips the constructor, whose cumsum primitive is
+    # TPU only, so operand preparation and its consumer can run on CPU.
+    chunk_kda = ChunkKDA.__new__(ChunkKDA)
+    chunk_kda.chunk = chunk_size
+    chunk_kda.pack = pack_width(chunk_size, num_heads)
+    chunk_kda.groups = num_heads // chunk_kda.pack
+    chunk_kda.k_t_weight = block_diag(
+        chunk_kda.transposed(jnp.asarray(k)).astype(jnp.bfloat16), chunk_size)
+    chunk_kda.qk_kk_operands = chunk_kda.prepare_qk_kk_operands(
+        jnp.asarray(q), jnp.asarray(k * beta), jnp.asarray(k),
+        jnp.asarray(g_cumsum))
+    chunk_kda.akk_parts, chunk_kda.aqk_parts = [], []
+    chunk_kda.num_kkt_groups_done = 0
+
+    causal_mask = np.tri(chunk_size, dtype=bool)
+    mask_coverage = sum(
+        np.asarray(mask, dtype=np.int32)
+        for _, _, _, mask in chunk_kda.qk_kk_operands)
+    np.testing.assert_array_equal(mask_coverage,
+                                  np.tile(causal_mask, (1, 1, chunk_kda.pack)))
+
+    # Note (david): run_pipelined advances the head groups a few at a time, so
+    # a call for a group that is already done has to be a no-op.
+    chunk_kda.kkt_qk(1)
+    chunk_kda.kkt_qk(1)
+    chunk_kda.kkt_qk()
+
+    gate_diff = g_cumsum[:, :, None, :] - g_cumsum[:, None, :, :]
+    decay = np.exp(np.where(causal_mask[None, :, :, None], gate_diff, 0))
+    for left_operand, parts in ((q, chunk_kda.aqk_parts),
+                                (k * beta, chunk_kda.akk_parts)):
+        expected = np.sum(
+            left_operand[:, :, None, :] * k[:, None, :, :] * decay,
+            axis=-1) * causal_mask
+        actual = unpack_lanes(jnp.concatenate(parts, axis=0), chunk_kda.pack)
+        np.testing.assert_allclose(actual, expected, rtol=2e-2, atol=2e-3)
+
+
+@pytest.mark.parametrize("lower_bound", [None, SAFE_GATE_LOWER_BOUND],
