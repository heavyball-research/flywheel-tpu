+def reference_slices(cu_q_lens: np.ndarray, kv_lens: np.ndarray,
+                     page_indices: np.ndarray,
+                     page_size: int) -> list[tuple[int, int, int]]:
+    """build_kv_write_slices as a plain loop, one page piece at a time."""
+    max_num_seqs = len(kv_lens)
+    pages_per_seq = len(page_indices) // max_num_seqs
+    slices = []
+    for req in range(max_num_seqs):
+        q_len = cu_q_lens[req + 1] - cu_q_lens[req]
+        kv_start = kv_lens[req] - q_len
+        pos = kv_start
+        while pos < kv_lens[req]:
+            page_slot = pos // page_size
+            page_end = (page_slot + 1) * page_size
+            length = min(kv_lens[req], page_end) - pos
+            page = page_indices[req * pages_per_seq + page_slot]
+            slices.append((page * page_size + pos % page_size,
+                           cu_q_lens[req] + (pos - kv_start), length))
+            pos += length
+    return slices
+
+
+def build_metadata(
+    has_kv_write_table: bool = True,
+    attention_phase: str = fa.PREFILL_PHASE,
+) -> tuple[AttentionMetadata, SharedAttentionMetadata]:
+    """Metadata for a two-request prefill step of TOTAL_TOKENS tokens."""
+    seq_lens = jnp.array([5, 5, 0, 0], jnp.int32)
+    query_start_loc = jnp.array([0, 5, 10, 10, 10], jnp.int32)
+    distribution = jnp.array([0, 0, NUM_SEQS], jnp.int32)
+    kv_write_slices = kv_write_num_slices = None
+    if has_kv_write_table:
+        kv_write_slices = jnp.zeros((3 * KV_WRITE_BOUND, ), jnp.int32)
+        kv_write_num_slices = jnp.zeros((1, ), jnp.int32)
+    md = AttentionMetadata(input_positions=jnp.arange(TOTAL_TOKENS,
+                                                      dtype=jnp.int32),
+                           block_tables=jnp.zeros(
+                               (MAX_NUM_SEQS * MAX_BLOCKS_PER_SEQ, ),
+                               jnp.int32),
+                           seq_lens=seq_lens,
+                           query_start_loc=query_start_loc,
+                           request_distribution=distribution,
+                           varlen_block_span=TOTAL_TOKENS,
+                           attention_phase=attention_phase,
+                           kv_write_slices=kv_write_slices,
+                           kv_write_num_slices=kv_write_num_slices)
+    shared = SharedAttentionMetadata(input_positions=jnp.arange(
+        TOTAL_TOKENS, dtype=jnp.int32),
+                                     seq_lens=seq_lens,
+                                     query_start_loc=query_start_loc,
+                                     request_distribution=distribution)
+    return md, shared
+
+
+def build_step_metadata(
+    attention_phase: str,
+    dense_batch_size: int,
+    dense_seq_len: int,
+) -> tuple[AttentionMetadata, SharedAttentionMetadata]:
+    """build_metadata with an explicit dense-or-ragged kernel choice."""
+    md, shared = build_metadata(attention_phase=attention_phase)
+    md = AttentionMetadata(
+        input_positions=md.input_positions,
+        block_tables=md.block_tables,
+        seq_lens=md.seq_lens,
+        query_start_loc=md.query_start_loc,
+        request_distribution=md.request_distribution,
+        dense_batch_size=dense_batch_size,
+        dense_seq_len=dense_seq_len,
+        varlen_block_span=(-1 if dense_batch_size > 0 else TOTAL_TOKENS),
+        attention_phase=attention_phase,
+        kv_write_slices=md.kv_write_slices,
+        kv_write_num_slices=md.kv_write_num_slices)
+    return md, shared
