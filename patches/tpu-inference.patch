+def test_flywheel_pcp_transfers_only_full_logical_pages(flywheel_scheduler_factory,
+                                                     pcp_size, prompt_length):
+    producer = flywheel_scheduler_factory(pcp_size, is_producer=True)
+    logical_block_size = 128 * pcp_size
+    assert producer.block_size == logical_block_size
+    num_blocks = (prompt_length + logical_block_size - 1) // logical_block_size
+    block_ids = list(range(10, 10 + num_blocks))
+    request = SimpleNamespace(request_id="prefill",
+                              status=RequestStatus.FINISHED_LENGTH_CAPPED,
+                              num_computed_tokens=prompt_length)
+    delay_free, params = producer.request_finished(request, block_ids)
+    full_blocks = prompt_length // logical_block_size
+    assert delay_free == (full_blocks > 0)
+    if not full_blocks:
+        assert params == {}
+        assert not producer.reqs_to_send
+        return
+    assert params["remote_block_ids"] == block_ids[:full_blocks]
+    consumer = flywheel_scheduler_factory(pcp_size)
+    decode_request = SimpleNamespace(prompt_token_ids=[0] * prompt_length,
+                                     kv_transfer_params=params)
+    assert consumer.get_num_new_matched_tokens(
