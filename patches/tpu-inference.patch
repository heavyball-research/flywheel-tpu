+"""FlyWheel TPU prefill context parallelism."""
+
+import jax
+import jax.numpy as jnp
+from jax import lax
+from jax.sharding import Mesh
+from jax.sharding import PartitionSpec as P
+
+from flywheel_tpu import flash_attn_func, flash_attn_with_kvcache
+from flywheel_tpu.flash_attn_interface import (
+    _flash_attn_func_pcp_causal_offset)
+from tpu_inference.layers.common.attention_metadata import AttentionMetadata
+from tpu_inference.layers.common.sharding import ShardingAxisName
+from tpu_inference.utils import get_mesh_shape_product
+
+
+def _merge_states(out_a, lse_a, out_b, lse_b):
+    max_lse = jnp.maximum(lse_a, lse_b)
+    safe_max = jnp.where(jnp.isneginf(max_lse), 0.0, max_lse)
+    weight_a = jnp.exp(lse_a - safe_max)
+    weight_b = jnp.exp(lse_b - safe_max)
+    denominator = weight_a + weight_b
+    safe_denominator = jnp.where(denominator == 0, 1.0, denominator)
+    out = (out_a * weight_a[..., None] +
+           out_b * weight_b[..., None]) / safe_denominator[..., None]
+    lse = jnp.where(denominator == 0, -jnp.inf,
+                    safe_max + jnp.log(safe_denominator))
+    return out, lse
+
+
+def _head_major(x, heads_outer):
+    """[T, H, D] -> flash_attn_func's batch-1 (1, H, T, D), or heads-outer
+    (H, 1, T, D): the same transpose(1, 0, 2) either way."""
+    x_htd = x.transpose(1, 0, 2)
+    return x_htd[:, None] if heads_outer else x_htd[None]
+
+
+def _from_head_major(out):
+    """A batch-1 head-major output of either _head_major layout -> [T, H, D]."""
+    return out.reshape(-1, *out.shape[2:]).transpose(1, 0, 2)
+
+
+def _to_natural_order(x, pcp_size):
+    chunk_size = x.shape[0] // 2
+    gathered = lax.all_gather(x, ShardingAxisName.PREFILL_CONTEXT,
+                              axis=0, tiled=True)
+    gathered = gathered.reshape(pcp_size, 2, chunk_size, *x.shape[1:])
+    return jnp.concatenate((gathered[:, 0], gathered[::-1, 1]),
+                           axis=0).reshape(-1, *x.shape[1:])
+
+
+def _owned_current_kv(k_global, v_global, *, pcp_size, history_len,
+                      local_tokens):
+    rank = lax.axis_index(ShardingAxisName.PREFILL_CONTEXT)
+    start = (rank - history_len) % pcp_size
+    indices = start + jnp.arange(local_tokens, dtype=jnp.int32) * pcp_size
+    return (jnp.take(k_global, indices, axis=0, mode="fill", fill_value=0),
+            jnp.take(v_global, indices, axis=0, mode="fill", fill_value=0))
+
+
+def _current_attention_head_tail(q, k, v, *, pcp_size, sm_scale,
+                                 num_current_tokens, history_len,
+                                 need_lse=True):
+    rank = lax.axis_index(ShardingAxisName.PREFILL_CONTEXT)
+    chunk_size = q.shape[0] // 2
+    num_kv_heads = k.shape[1]
+    kv_global = _to_natural_order(jnp.concatenate((k, v), axis=1), pcp_size)
+    k_global, v_global = jnp.split(kv_global, (num_kv_heads, ), axis=1)
+
+    def make_branch(branch_rank):
+        visible_lengths = ((branch_rank + 1) * chunk_size,
+                           (2 * pcp_size - branch_rank) * chunk_size)
+
+        def branch(args):
+            q_arg, k_arg, v_arg = args
+            outputs = []
+            lses = []
+            for segment, visible_length in enumerate(visible_lengths):
+                q_segment = q_arg[segment * chunk_size:(segment + 1) *
+                                  chunk_size]
+                result = flash_attn_func(
+                    *(_head_major(x, heads_outer=not need_lse)
+                      for x in (q_segment, k_arg[:visible_length],
+                                v_arg[:visible_length])),
+                    softmax_scale=sm_scale,
+                    causal=True,
+                    return_softmax_lse=need_lse,
+                    token_major=False,
+                    heads_outer_fold=not need_lse)
+                if need_lse:
+                    out, lse = result
+                    lses.append(lse[0].transpose(1, 0))
+                else:
+                    out = result
+                outputs.append(_from_head_major(out))
+            return (jnp.concatenate(outputs),
+                    jnp.concatenate(lses) if need_lse else None)
+
+        return branch
+
+    # WORKAROUND: the switch gets its own materialized copy of the gathered
+    # K/V. When it shares k_global/v_global with _owned_current_kv below (which
+    # XLA schedules after the switch), rank 0's tail segment -- the only flash
+    # call that reads the gathered K/V unsliced -- returns wrong output:
+    # Qwen3-4B, 32k, TP=4/PCP=2 has a 61% relative error in the final hidden
+    # states, deterministic and silent. Both halves are needed: `* one` is a
+    # copy XLA cannot elide (jnp.copy is elided), and the barrier keeps it
+    # outside the branches (XLA otherwise sinks it into them, which restores
+    # the shared operand). Costs one elementwise pass over the gathered K/V.
+    # TODO: drop this once the XLA/libtpu cause is known, or once head_tail
+    # uses the runtime-offset kernel and needs no lax.switch. Re-check 32k
+    # TP=4/PCP=2 first-token logits against PCP=1 after any libtpu upgrade.
+    one = (num_current_tokens >= 0).astype(k_global.dtype)
+    attention_k, attention_v = lax.optimization_barrier(
+        (k_global * one, v_global * one))
+    output, lse = lax.switch(
+        rank, tuple(make_branch(r) for r in range(pcp_size)),
+        (q, attention_k, attention_v))
+    positions = jnp.concatenate((
+        rank * chunk_size + jnp.arange(chunk_size, dtype=jnp.int32),
+        (2 * pcp_size - 1 - rank) * chunk_size +
+        jnp.arange(chunk_size, dtype=jnp.int32)))
+    valid = positions < num_current_tokens
+    output = jnp.where(valid[:, None, None], output, 0)
+    if need_lse:
+        lse = jnp.where(valid[:, None], lse, -jnp.inf)
+    owned_k, owned_v = _owned_current_kv(
+        k_global,
+        v_global,
+        pcp_size=pcp_size,
+        history_len=history_len,
+        local_tokens=q.shape[0])
+    return output, lse, owned_k, owned_v
+
+
+def _current_attention_contiguous(q, k, v, *, pcp_size, sm_scale,
+                                  num_current_tokens, history_len,
+                                  need_lse=True):
+    axis = ShardingAxisName.PREFILL_CONTEXT
+    rank = lax.axis_index(axis)
+    local_tokens = q.shape[0]
+    num_kv_heads = k.shape[1]
+    kv_global = lax.all_gather(jnp.concatenate((k, v), axis=1),
+                               axis,
+                               axis=0,
+                               tiled=True)
+    k_global, v_global = jnp.split(kv_global, (num_kv_heads, ), axis=1)
+
+    result = _flash_attn_func_pcp_causal_offset(
+        *(_head_major(x, heads_outer=not need_lse)
+          for x in (q, k_global, v_global)),
+        rank * local_tokens,
+        softmax_scale=sm_scale,
+        return_softmax_lse=need_lse,
+        heads_outer_fold=not need_lse)
+    if need_lse:
+        output, lse = result
+        output = _from_head_major(output)
+        lse = lse[0].transpose(1, 0)
+    else:
+        output, lse = _from_head_major(result), None
+    positions = rank * local_tokens + jnp.arange(local_tokens,
+                                                  dtype=jnp.int32)
+    valid = positions < num_current_tokens
+    output = jnp.where(valid[:, None, None], output, 0)
+    if need_lse:
+        lse = jnp.where(valid[:, None], lse, -jnp.inf)
+    owned_k, owned_v = _owned_current_kv(
+        k_global,
+        v_global,
+        pcp_size=pcp_size,
+        history_len=history_len,
+        local_tokens=local_tokens)
+    return output, lse, owned_k, owned_v
+
+
+def _history_attention(q, kv_cache, block_table, history_len, *, pcp_size,
+                       sm_scale):
+    rank = lax.axis_index(ShardingAxisName.PREFILL_CONTEXT)
+    local_history_len = jnp.maximum(
+        0, (history_len + pcp_size - 1 - rank) // pcp_size)
+    out = jnp.zeros_like(q)
+    lse = jnp.full(q.shape[:2], -jnp.inf, dtype=jnp.float32)
+    permutation = tuple((r, (r + 1) % pcp_size) for r in range(pcp_size))
+
+    for _ in range(pcp_size):
+        partial_out, partial_lse, _ = flash_attn_with_kvcache(
+            q,
+            kv_cache,
+            None,
+            cache_seqlens=jnp.reshape(local_history_len, (1, )),
+            block_table=jnp.reshape(block_table, (1, -1)),
+            num_active=1,
+            cu_seqlens_q=jnp.array([0, q.shape[0]], dtype=jnp.int32),
+            softmax_scale=sm_scale,
+            causal=False,
+            return_softmax_lse=True)
+        partial_lse = partial_lse.transpose(1, 0)
+        out, lse = _merge_states(out, lse, partial_out, partial_lse)
+        q = lax.ppermute(q, ShardingAxisName.PREFILL_CONTEXT, permutation)
+        out = lax.ppermute(out, ShardingAxisName.PREFILL_CONTEXT, permutation)
+        lse = lax.ppermute(lse, ShardingAxisName.PREFILL_CONTEXT, permutation)
+    return out, lse
+
+
+def sharded_flywheel_tpu_pcp_attention(
+        mesh: Mesh,
+        q: jax.Array,
+        k: jax.Array,
+        v: jax.Array,
+        kv_cache: jax.Array,
+        md: AttentionMetadata,
+        *,
+        sm_scale: float,
+) -> tuple[jax.Array, jax.Array]:
+    """Runs the FlyWheel kernel over strided PCP cache shards and current tokens."""
+    pcp_axis = ShardingAxisName.PREFILL_CONTEXT
+    pcp_size = get_mesh_shape_product(mesh, pcp_axis)
+    if pcp_size <= 1:
+        raise ValueError("FlyWheel PCP attention requires pcp_size > 1.")
+    if q.shape[0] % (2 * pcp_size):
+        raise ValueError("The PCP token buffer must divide into 2 * pcp_size chunks.")
+    if kv_cache.ndim != 4:
+        raise ValueError(
+            "FlyWheel PCP expects a (pages, page_size, 2 * kv_heads, head_dim) "
+            f"cache; got {kv_cache.shape}.")
+    # Note (david): unlike flywheel_tpu_attention, this path does not pad
+    # Q/K/V up to the cache's 128-aligned head_dim.
+    if q.shape[-1] != kv_cache.shape[-1]:
+        raise NotImplementedError(
+            "FlyWheel PCP needs a head_dim that is a multiple of 128; got "
+            f"{q.shape[-1]} against a {kv_cache.shape[-1]}-wide cache.")
+    if md.pcp is None or md.pcp.num_current_tokens is None:
+        raise ValueError("FlyWheel PCP requires md.pcp.num_current_tokens.")
+
+    # GQA/MQA with fewer KV heads than the head shards: replicate them, as
+    # sharded_flywheel_tpu_attention does, so each shard owns one KV head.
+    tp_size = get_mesh_shape_product(mesh, ShardingAxisName.KV_HEAD)
+    num_kv_heads = k.shape[1]
+    if tp_size > 1 and num_kv_heads < tp_size:
+        if tp_size % num_kv_heads != 0:
+            raise ValueError(
+                f"For GQA/MQA, tp_size {tp_size} must be divisible by "
+                f"num_kv_heads {num_kv_heads}")
+        factor = tp_size // num_kv_heads
+        k = jnp.repeat(k, factor, axis=1)
+        v = jnp.repeat(v, factor, axis=1)
+
+    write_slices = md.kv_write_slices.reshape(pcp_size, 3, -1)
+    write_counts = md.kv_write_num_slices.reshape(pcp_size, 1)
+    num_request_slots = md.pcp.kv_cache_lens.shape[0]
+    block_table = md.block_tables.reshape(num_request_slots, -1)[
+        0, :md.pcp.cache_pages]
+    qkv_spec = P(ShardingAxisName.ATTN_DATA, ShardingAxisName.ATTN_HEAD, None)
+    kv_spec = P(ShardingAxisName.ATTN_DATA, ShardingAxisName.KV_HEAD, None)
+    cache_spec = P(ShardingAxisName.BATCH, ShardingAxisName.KV_CONTEXT,
+                   ShardingAxisName.KV_HEAD, None)
+
+    def shard_fn(q_local, k_local, v_local, cache_local, block_table,
+                 history_lens, num_current_tokens, local_write_slices,
+                 local_write_counts):
+        if md.pcp.cache_pages == 0:
+            history_out = jnp.zeros_like(q_local)
+            history_lse = jnp.full(q_local.shape[:2],
+                                   -jnp.inf,
+                                   dtype=jnp.float32)
+        else:
+            history_out, history_lse = _history_attention(
+                q_local,
+                cache_local,
+                block_table,
+                history_lens[0],
+                pcp_size=pcp_size,
+                sm_scale=sm_scale)
+        current_impl = {
+            "head_tail": _current_attention_head_tail,
+            "contiguous": _current_attention_contiguous,
+        }.get(md.pcp.query_layout)
+        if current_impl is None:
+            raise ValueError(
+                f"Unknown FlyWheel PCP query layout {md.pcp.query_layout!r}.")
+        current_out, current_lse, owned_k, owned_v = current_impl(
+            q_local, k_local, v_local, pcp_size=pcp_size, sm_scale=sm_scale,
+            num_current_tokens=num_current_tokens,
+            history_len=(history_lens[0]
+                         if md.pcp.cache_pages > 0 else 0),
+            need_lse=md.pcp.cache_pages > 0)
+        if md.pcp.cache_pages == 0:
+            output = current_out
+        else:
+            output, _ = _merge_states(history_out, history_lse, current_out,
+                                      current_lse)
+            output = jnp.where(jnp.isfinite(current_lse)[..., None], output,
+                               0)
+
+        from tpu_inference.layers.common.flywheel_tpu_attention import write_kv_cache
+        cache_local = write_kv_cache(owned_k, owned_v, cache_local,
+                                     local_write_slices[0],
+                                     local_write_counts[0])
+        # Note (david): tie the cache write to this layer's output. Nothing in
+        # the step reads the updated cache, so XLA otherwise sinks every
+        # layer's take + write to the end of the step and keeps each layer's
+        # gathered full-length K/V alive until then: 0.5 GiB per attention
+        # layer and chip at 512k tokens with PCP=2, 7.4 GiB over
+        # Qwen3.8-27B's 16 layers, which left the 524288-token prefill program
+        # 33 MB short of HBM on v6e.
+        cache_local, output = lax.optimization_barrier((cache_local, output))
+        return cache_local, output.astype(q_local.dtype)
+
+    return jax.shard_map(
+        shard_fn,
+        mesh=mesh,
+        in_specs=(qkv_spec, kv_spec, kv_spec, cache_spec, P(), P(), P(),
+                  P(pcp_axis, None, None), P(pcp_axis, None)),
+        out_specs=(cache_spec, qkv_spec),
+        check_vma=False)(q, k, v, kv_cache, block_table,
+                         md.pcp.kv_cache_lens, md.pcp.num_current_tokens,
+                         write_slices, write_counts)
