+class TestVarlenPrefill:
+
+    def run_varlen_prefill(
+            self, monkeypatch: pytest.MonkeyPatch, **overrides: object
+    ) -> tuple[jax.Array, tuple[jax.Array, jax.Array]]:
+        """flywheel_tpu_varlen_prefill on a two-request step. The decode
+        kernel raises: a prefill step carries no decode row."""
+        q = jnp.zeros((6, 4, 8), jnp.bfloat16)
+        k = jnp.zeros((6, 2, 8), jnp.bfloat16)
+        v = jnp.zeros_like(k)
+        cache = jnp.zeros((4, 128, 4, 8), jnp.bfloat16)
+        self.cu_q_lens = jnp.array([0, 4, 6], jnp.int32)
+        monkeypatch.setattr(fa, "write_kv_cache", lambda *args: args[2])
+
+        def _no_decode_kernel(*args, **kwargs):
+            raise AssertionError("ragged prefill must not run a decode kernel")
+
+        monkeypatch.setattr(fa, "flash_attn_with_kvcache", _no_decode_kernel)
+        kwargs = dict(sm_scale=0.5, varlen_block_span=4)
+        kwargs.update(overrides)
+        return cache, fa.flywheel_tpu_varlen_prefill(
+            q, k, v, cache, self.cu_q_lens, jnp.zeros((3, 8), jnp.int32),
+            jnp.zeros((1, ), jnp.int32), **kwargs)
+
+    def test_passes_the_runner_layout_head_major(self, monkeypatch):
+        seen = {}
+
+        def _fake_varlen(q_in, k_in, v_in, cu_q, cu_k, **kwargs):
+            seen.update(kwargs, cu_q=cu_q, cu_k=cu_k)
+            # Note (david): the runner's [T, N, D] rows reach the head-major
+            # API as (N, T, D).
+            assert q_in.shape == (4, 6, 8)
+            assert k_in.shape == (2, 6, 8)
+            assert v_in.shape == (2, 6, 8)
+            return jnp.full(q_in.shape, 3, q_in.dtype)
+
