+
+def test_core_rebinds_state_and_forwards_the_safe_gate_bound(monkeypatch):
+    num_tokens, num_heads, head_dim, conv_size = 8, 2, 128, 4
+    projection_dim = num_heads * head_dim
+    weight = jnp.arange(projection_dim * conv_size,
+                        dtype=jnp.float32).reshape(projection_dim, 1,
+                                                   conv_size)
+    layer = SimpleNamespace(num_heads=num_heads,
+                            head_dim=head_dim,
+                            conv_size=conv_size,
+                            safe_gate=True,
+                            lower_bound=-5.0,
+                            q_conv1d=SimpleNamespace(weight=weight),
+                            k_conv1d=SimpleNamespace(weight=weight + 100),
+                            v_conv1d=SimpleNamespace(weight=weight + 200),
+                            A_log=jnp.ones((1, 1, num_heads, 1)),
+                            dt_bias=jnp.ones(projection_dim))
+    metadata = SimpleNamespace(padded_num_reqs=1,
+                               query_start_loc=jnp.array([0, num_tokens]),
+                               seq_lens=jnp.array([num_tokens + 16]),
+                               request_distribution=jnp.array([0, 1, 1]),
+                               mamba_state_indices=jnp.array([2]),
+                               block_tables=jnp.array([[1, 2, 3]]))
+    old_conv = jnp.full((4, conv_size - 1, 3 * projection_dim), 7,
+                        jnp.bfloat16)
+    old_recurrent = jnp.full((4, num_heads, head_dim, head_dim), 8,
+                             jnp.float32)
+    vllm_context = SimpleNamespace(
+        kv_caches=[(old_conv, old_recurrent)],
+        layer_name_to_kvcache_index={LAYER_NAME: 0},
+        mesh=SimpleNamespace(shape={
+            "model": 1,
+            "data": 1
+        }),
+        vllm_config=SimpleNamespace(cache_config=SimpleNamespace(
+            mamba_cache_mode="align", mamba_block_size=8)))
+    monkeypatch.setattr(
+        kda_attention_op, "get_forward_context",
+        lambda: SimpleNamespace(attn_metadata={LAYER_NAME: metadata},
+                                no_compile_layers={LAYER_NAME: layer}))
+    monkeypatch.setattr(kda_attention_op, "get_vllm_model_wrapper_context",
+                        lambda: vllm_context)
+    monkeypatch.setattr(kda_attention_op, "jax_view", lambda value: value)
+    monkeypatch.setattr(kda_attention_op, "torch_view", lambda value: value)
+    q, k, v, gate = [
+        jnp.full((num_tokens, projection_dim), value, jnp.bfloat16)
+        for value in [1, 2, 3, -2]
+    ]
+    beta = jnp.full((num_tokens, num_heads), -3, jnp.bfloat16)
+    output = Mock(shape=(1, num_tokens, num_heads, head_dim))
+
+    def _fused(**kwargs):
+        np.testing.assert_array_equal(kwargs["j_mixed_qkv"],
+                                      jnp.concatenate((q, k, v), -1))
+        np.testing.assert_array_equal(kwargs["j_gate"], gate)
+        np.testing.assert_array_equal(kwargs["j_b"], beta)
+        np.testing.assert_array_equal(
+            kwargs["j_conv_weight"],
+            jnp.concatenate((weight, weight + 100, weight + 200), 0))
+        np.testing.assert_array_equal(kwargs["read_state_indices"], [2])
+        np.testing.assert_array_equal(kwargs["state_indices"], [3])
+        assert kwargs["j_A_log"].shape == (num_heads, )
+        assert kwargs["lower_bound"] == -5.0
+        assert kwargs["beta_is_activated"] is False
+        return (old_conv + 1, old_recurrent + 1), v
+
+    monkeypatch.setattr(kda_attention_op, "run_jax_kda_attention", _fused)
+    kda_attention_op.kda_attention_core_tpu(q, k, v, gate, beta, output,
+                                            LAYER_NAME)
+
+    np.testing.assert_array_equal(vllm_context.kv_caches[0][0], old_conv + 1)
+    np.testing.assert_array_equal(vllm_context.kv_caches[0][1],
+                                  old_recurrent + 1)
+    np.testing.assert_array_equal(output.copy_.call_args.args[0],
+                                  v.reshape(output.shape))
