+# SPDX-License-Identifier: Apache-2.0
+"""Hybrid MLA/KDA must use one latent cache, not two full-attention planes."""
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from tpu_inference.runner import kv_cache_manager as cache
+
+NUM_MLA_LAYERS = 6
+NUM_KDA_LAYERS = 18
+# Note (david): stands in for a KDA layer's unpadded state page; only its
+# share of the shared page matters to the assertions below.
+NATURAL_MAMBA_PAGE_BYTES = 1085440
+
+
+@pytest.mark.parametrize("is_transposed", [False, True])
+def test_ling_hybrid_page_sizes(monkeypatch, is_transposed):
+    monkeypatch.setattr(cache.tpu_envs, "MLA_TRANSPOSE_KV_CACHE",
+                        is_transposed)
+    text_config = SimpleNamespace(kv_lora_rank=512, qk_rope_head_dim=64)
+    runner = SimpleNamespace(
+        model_config=SimpleNamespace(use_mla=True, hf_text_config=text_config),
+        cache_config=SimpleNamespace(block_size=128,
+                                     mamba_page_size_padded=None),
+        mesh=SimpleNamespace(shape={"model": 2}),
+        kv_cache_dtype="bfloat16",
+        vllm_config=SimpleNamespace(),
+    )
+    manager = cache.KVCacheManager(runner)
+
+    mamba_spec = MagicMock(spec=cache.MambaSpec)
+    # Note (david): the manager reads the unpadded page size by rebuilding the
+    # spec as a dataclass, which a mock spec cannot answer on its own.
+    monkeypatch.setattr(
+        cache, "dataclasses",
+        SimpleNamespace(replace=lambda *args, **kwargs: SimpleNamespace(
+            page_size_bytes=NATURAL_MAMBA_PAGE_BYTES)))
+    set_num_blocks_override = MagicMock()
+    monkeypatch.setattr(manager,
+                        "_maybe_set_compact_mamba_num_blocks_override",
+                        set_num_blocks_override)
+    layers = {
+        f"mla.{i}": MagicMock(spec=cache.MLAAttention)
+        for i in range(NUM_MLA_LAYERS)
+    }
+    for i in range(NUM_KDA_LAYERS):
+        layer = MagicMock(spec=cache.MambaBase)
+        layer.get_kv_cache_spec.return_value = mamba_spec
+        layers[f"kda.{i}"] = layer
+
+    # Note (david): only the untransposed layout pads the RoPE half to a whole
+    # 128-lane register; the latent half is already 128-aligned.
+    padded_rope_dim = 64 if is_transposed else 128
+    expected_head_size = text_config.kv_lora_rank + padded_rope_dim
+
+    def attention_page_bytes(mesh, block_size, num_kv_heads, head_size, dtype,
+                             use_mla):
+        assert use_mla is True
+        assert num_kv_heads == 1
+        assert head_size == expected_head_size
+        return block_size * head_size * 2
+
+    monkeypatch.setattr(cache, "get_attention_page_size_bytes",
+                        attention_page_bytes)
+    manager.update_mamba_page_size_padded(layers)
+
+    attention_bytes = runner.cache_config.block_size * expected_head_size * 2
+    # Note (david): 18 KDA layers against 6 MLA ones group three to one, so a
+    # shared page holds one attention page and three mamba pages.
+    num_mamba_groups = NUM_KDA_LAYERS // NUM_MLA_LAYERS
+    expected_page_bytes = (attention_bytes +
+                           num_mamba_groups * NATURAL_MAMBA_PAGE_BYTES)
+    assert manager._hybrid_uniform_page_size_bytes == expected_page_bytes
+    assert runner.cache_config.mamba_page_size_padded == expected_page_bytes
+    set_num_blocks_override.assert_called_once_with(attention_bytes,
+                                                    NATURAL_MAMBA_PAGE_BYTES,
+                                                    NUM_MLA_LAYERS,
+                                                    NUM_KDA_LAYERS)
