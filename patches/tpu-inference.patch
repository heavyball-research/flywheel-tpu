+def test_fused_matches_reference(max_reqs: int, lengths: list[int],
+                                 token_starts: list[int],
+                                 seq_distribution: list[int],
+                                 gate_scale: float,
+                                 lower_bound: float | None) -> None:
+    if jax.default_backend() != "tpu":
+        pytest.skip("Fused Pallas KDA requires TPU")
+
+    num_tokens = sum(lengths)
+    query_start_loc = jnp.array(token_starts, dtype=jnp.int32)
+    distribution = jnp.array(seq_distribution, dtype=jnp.int32)
+    state_indices = jnp.arange(1, max_reqs + 1, dtype=jnp.int32)
+    conv_state = jnp.zeros((max_reqs + 1, KERNEL_SIZE - 1, DIM))
+    recurrent_state = jnp.zeros((max_reqs + 1, N_V, D_K, D_V))
+    # Note (david): seq_lens == query_lens means context_len is 0, so every
+    # sequence starts from a zero state whatever its slot holds.
+    seq_lens = query_start_loc[1:max_reqs + 1] - query_start_loc[:max_reqs]
+
+    kernel_acts, ref_acts, weights = make_inputs(jax.random.key(0),
+                                                 num_tokens,
+                                                 gate_scale,
+                                                 n_kq=N_KQ,
+                                                 n_v=N_V)
+    fused = jax.jit(fused_conv1d_kda, static_argnames=STATIC_ARGNAMES)
+    (conv_out, rec_out), output = fused(**kernel_acts,
+                                        **weights,
+                                        conv_state=conv_state,
+                                        recurrent_state=recurrent_state,
+                                        query_start_loc=query_start_loc,
+                                        state_indices=state_indices,
+                                        distribution=distribution,
+                                        seq_lens=seq_lens,
+                                        read_state_indices=state_indices,
+                                        n_kq=N_KQ,
+                                        n_v=N_V,
+                                        d_k=D_K,
+                                        d_v=D_V,
+                                        kernel_size=KERNEL_SIZE,
+                                        lower_bound=lower_bound)
+    (conv_ref,
+     rec_ref), output_ref = kda_reference(**ref_acts,
+                                          **weights,
+                                          conv_state=conv_state,
+                                          recurrent_state=recurrent_state,
+                                          query_start_loc=query_start_loc,
+                                          state_indices=state_indices,
+                                          read_state_indices=state_indices,
+                                          seq_lens=seq_lens,
+                                          seq_indices=range(
+                                              int(distribution[2])),
+                                          is_per_token_checkpoint=False,
+                                          n_kq=N_KQ,
+                                          n_v=N_V,
+                                          lower_bound=lower_bound)
+
+    np.testing.assert_allclose(output.astype(jnp.float32), output_ref,
+                               **BF16_TOLERANCE)
+    np.testing.assert_allclose(conv_out, conv_ref, **BF16_TOLERANCE)
+    np.testing.assert_allclose(rec_out, rec_ref, **BF16_TOLERANCE)
