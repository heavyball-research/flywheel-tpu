+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+from jax.sharding import Mesh
+from jax.sharding import PartitionSpec as P
+
+from flywheel_tpu import flash_attn_with_kvcache
+from flywheel_tpu.flash_attn_interface import \
+    _flash_attn_func_pcp_causal_offset
+from tpu_inference.layers.common import flywheel_pcp_attention as flywheel_pcp
+from tpu_inference.layers.common import flywheel_tpu_attention as flywheel_backend
+from tpu_inference.layers.common.attention_metadata import (AttentionMetadata,
+                                                            PCPMetadata)
+from tpu_inference.layers.common.flywheel_pcp_attention import _merge_states
+from tpu_inference.layers.common.sharding import ShardingAxisName
+
+
+@pytest.fixture(autouse=True)
+def pcp_axis_names():
+    ShardingAxisName.override(ATTN_DATA="pcp",
+                              ATTN_HEAD=None,
+                              KV_HEAD=None,
+                              BATCH=None,
+                              KV_CONTEXT="pcp",
+                              PREFILL_CONTEXT="pcp")
+    yield
+    ShardingAxisName.reset()
+
+
+def test_merge_states_matches_concatenated_softmax():
+    out_a = jnp.array([[[1.0], [3.0]]])
+    out_b = jnp.array([[[5.0], [7.0]]])
+    lse_a = jnp.log(jnp.array([[2.0, 4.0]]))
+    lse_b = jnp.log(jnp.array([[6.0, 4.0]]))
+    out, lse = _merge_states(out_a, lse_a, out_b, lse_b)
+    np.testing.assert_allclose(out[..., 0], [[4.0, 5.0]], atol=1e-6)
+    np.testing.assert_allclose(lse,
+                               jnp.log(jnp.array([[8.0, 8.0]])),
+                               atol=1e-6)
+
+
+def test_merge_states_handles_two_empty_spans():
+    out, lse = _merge_states(jnp.ones((2, 1, 3)),
+                             jnp.full((2, 1), -jnp.inf),
+                             jnp.ones((2, 1, 3)),
+                             jnp.full((2, 1), -jnp.inf))
+    np.testing.assert_array_equal(out, jnp.zeros_like(out))
+    np.testing.assert_array_equal(lse, jnp.full_like(lse, -jnp.inf))
+
+
+@pytest.mark.parametrize("q_len, kv_len, offset",
+                         [(128, 512, 0), (128, 512, 128),
+                          (128, 512, 384), (64, 512, 64), (32, 512, 96),
+                          (8, 16, 0), (8, 16, 8), (8, 32, 24),
+                          (16, 64, 48), (1, 16, 0)])
+def test_runtime_causal_offset_matches_reference(q_len, kv_len, offset):
+    q = jnp.arange(q_len * 2 * 128,
+                   dtype=jnp.float32).reshape(1, q_len, 2, 128)
+    q = (q % 17 / 17).astype(jnp.bfloat16)
+    k = jnp.arange(kv_len * 128,
+                   dtype=jnp.float32).reshape(1, kv_len, 1, 128)
+    k = (k % 13 / 13).astype(jnp.bfloat16)
+    v = jnp.flip(k, axis=1)
+    # Note (david): the helper takes flash_attn_func's head-major (batch,
+    # heads, seq, head_dim).
+    out = _flash_attn_func_pcp_causal_offset(
+        *(x.transpose(0, 2, 1, 3) for x in (q, k, v)),
+        jnp.array(offset, jnp.int32),
+        interpret=True)
+    repeated_k = jnp.repeat(k[0].astype(jnp.float32), 2, axis=1)
+    repeated_v = jnp.repeat(v[0].astype(jnp.float32), 2, axis=1)
+    scores = jnp.einsum("qhd,khd->hqk", q[0].astype(jnp.float32),
+                        repeated_k) / np.sqrt(128)
+    mask = jnp.arange(kv_len)[None, :] <= offset + jnp.arange(q_len)[:, None]
+    expected = jnp.einsum(
+        "hqk,khd->qhd",
+        jax.nn.softmax(jnp.where(mask[None], scores, -jnp.inf), axis=-1),
+        repeated_v)
+    np.testing.assert_allclose(out[0].transpose(1, 0, 2).astype(jnp.float32),
+                               expected,
+                               atol=3e-2,
+                               rtol=2e-2)
+
+
+def test_runtime_causal_offset_rejects_kv_shorter_than_q():
+    q = jnp.zeros((1, 1, 64, 128), jnp.bfloat16)
+    k = jnp.zeros((1, 1, 32, 128), jnp.bfloat16)
+    with pytest.raises(ValueError, match="kv_len >= q_len"):
+        _flash_attn_func_pcp_causal_offset(q, k, k, jnp.int32(0))
+
+
+def test_history_extend_matches_reference():
+    q = jnp.arange(8 * 2 * 128, dtype=jnp.float32).reshape(8, 2, 128)
+    q = (q % 17 / 17).astype(jnp.bfloat16)
+    key = jnp.arange(128 * 128, dtype=jnp.float32).reshape(128, 1, 128)
+    key = (key % 13 / 13).astype(jnp.bfloat16)
+    value = jnp.flip(key, axis=0)
+    cache = jnp.concatenate((key, value), axis=1)[None]
+    out, _, _ = flash_attn_with_kvcache(
+        q,
+        cache,
+        None,
+        cache_seqlens=jnp.array([37], jnp.int32),
+        block_table=jnp.array([[0]], jnp.int32),
+        num_active=1,
+        cu_seqlens_q=jnp.array([0, 8], jnp.int32),
+        softmax_scale=1 / np.sqrt(128),
+        causal=False,
+        return_softmax_lse=True,
+        interpret=True)
+    scores = jnp.einsum("qhd,khd->hqk", q.astype(jnp.float32),
+                        jnp.repeat(key[:37].astype(jnp.float32), 2, axis=1))
+    expected = jnp.einsum(
+        "hqk,khd->qhd", jax.nn.softmax(scores / np.sqrt(128), axis=-1),
+        jnp.repeat(value[:37].astype(jnp.float32), 2, axis=1))
+    np.testing.assert_allclose(out.astype(jnp.float32),
+                               expected,
+                               atol=3e-2,
+                               rtol=2e-2)
+
+
+@pytest.mark.parametrize("pcp_size", [2, 4])
+@pytest.mark.parametrize("kv_heads", [1, 2])
+@pytest.mark.parametrize("query_layout", ["head_tail", "contiguous"])
+def test_full_fresh_wrapper_output_and_cache(monkeypatch, pcp_size, kv_heads,
+                                             query_layout):
+    if jax.device_count() < pcp_size:
+        pytest.skip("requires simulated multi-device CPU")
+    chunk_size, q_heads, dim = 4, pcp_size, 8
+    total = 2 * pcp_size * chunk_size
+    num_current = total - 3
+    q_natural = jnp.arange(total * q_heads * dim,
+                           dtype=jnp.float32).reshape(total, q_heads, dim)
+    q_natural = (q_natural % 19 / 19).astype(jnp.bfloat16)
+    kv_natural = q_natural[:, :kv_heads]
+    if query_layout == "head_tail":
+        row_order = [chunk for rank in range(pcp_size)
+                     for chunk in (rank, 2 * pcp_size - 1 - rank)]
+    else:
+        row_order = list(range(2 * pcp_size))
+
+    def reorder(x):
+        return x.reshape(2 * pcp_size, chunk_size, *x.shape[1:])[
+            jnp.array(row_order)].reshape(total, *x.shape[1:])
+
+    q, k, v = reorder(q_natural), reorder(kv_natural), reorder(kv_natural)
+
+    def reference_flash(q_arg, k_arg, v_arg, *, return_softmax_lse,
+                        softmax_scale, causal_offset=None,
+                        heads_outer_fold=False, **unused):
+        del unused
+        # Note (david): head-major (batch, heads, seq, head_dim), or
+        # heads-outer (heads, batch, seq, head_dim) with heads_outer_fold.
+        if heads_outer_fold:
+            q_arg, k_arg, v_arg = (x.transpose(1, 0, 2, 3)
+                                   for x in (q_arg, k_arg, v_arg))
+        repeat = q_arg.shape[1] // k_arg.shape[1]
+        k_arg = jnp.repeat(k_arg, repeat, axis=1)
+        v_arg = jnp.repeat(v_arg, repeat, axis=1)
+        scores = jnp.einsum("bhqd,bhkd->bhqk", q_arg.astype(jnp.float32),
+                            k_arg.astype(jnp.float32)) * softmax_scale
+        if causal_offset is None:
+            causal_offset = k_arg.shape[2] - q_arg.shape[2]
+        mask = jnp.arange(k_arg.shape[2])[None, :] <= (
+            causal_offset + jnp.arange(q_arg.shape[2])[:, None])
+        scores = jnp.where(mask[None, None], scores, -jnp.inf)
+        lse = jax.nn.logsumexp(scores, axis=-1)
+        out = jnp.einsum("bhqk,bhkd->bhqd", jax.nn.softmax(scores, axis=-1),
+                         v_arg.astype(jnp.float32)).astype(q_arg.dtype)
+        if heads_outer_fold:
+            out = out.transpose(1, 0, 2, 3)
+        return (out, lse) if return_softmax_lse else out
+
+    def reference_writer(k_arg, v_arg, cache, slices, counts):
+        flat_cache = cache.reshape(-1, cache.shape[-2], dim)
+        # Note (david): stacked on a pair axis after the head axis so each row
+        # matches the backend writer's interleaved [k0, v0, k1, v1, ...] rows.
+        new_rows = jnp.stack((k_arg, v_arg), axis=2).reshape(
+            k_arg.shape[0], -1, dim)
+        for new_row in range(new_rows.shape[0]):
+            piece_matches = ((new_row >= slices[1]) &
+                             (new_row < slices[1] + slices[2]) &
+                             (jnp.arange(slices.shape[1]) < counts[0]))
+            is_written = jnp.any(piece_matches)
+            piece = jnp.argmax(piece_matches)
+            cache_row = slices[0, piece] + new_row - slices[1, piece]
+            old_row = flat_cache[cache_row]
+            flat_cache = flat_cache.at[cache_row].set(
+                jnp.where(is_written, new_rows[new_row], old_row))
+        return flat_cache.reshape(cache.shape)
+
+    monkeypatch.setattr(flywheel_pcp, "flash_attn_func", reference_flash)
+    monkeypatch.setattr(
+        flywheel_pcp, "_flash_attn_func_pcp_causal_offset",
+        lambda q, k, v, offset, **kwargs: reference_flash(
+            q, k, v, causal_offset=offset, **kwargs))
+    monkeypatch.setattr(flywheel_backend, "write_kv_cache", reference_writer)
+    page_size = 128 * pcp_size
+    cache = jnp.zeros((1, page_size, 2 * kv_heads, dim), jnp.bfloat16)
+    slices = np.zeros((pcp_size, 3, 1), np.int32)
+    counts = np.ones((pcp_size, 1), np.int32)
+    for rank in range(pcp_size):
+        slices[rank, :, 0] = (0, 0,
+                              max(0, (num_current + pcp_size - 1 - rank) //
+                                  pcp_size))
+    pcp = PCPMetadata(query_start_loc=jnp.zeros((pcp_size, 2), jnp.int32),
+                      kv_cache_lens=jnp.array([0], jnp.int32),
+                      q_pos_offsets=jnp.zeros((pcp_size, 1), jnp.int32),
+                      cache_pages=0,
+                      query_layout=query_layout,
+                      num_current_tokens=jnp.array(num_current, jnp.int32))
+    md = AttentionMetadata(input_positions=jnp.arange(total),
+                           block_tables=jnp.array([0], jnp.int32),
+                           seq_lens=jnp.array([num_current], jnp.int32),
+                           pcp=pcp,
+                           kv_write_slices=jnp.asarray(slices).reshape(-1),
+                           kv_write_num_slices=jnp.asarray(counts).reshape(-1))
+    mesh = Mesh(np.array(jax.devices()[:pcp_size]), ("pcp",))
+    updated, out = flywheel_pcp.sharded_flywheel_tpu_pcp_attention(
+        mesh, q, k, v, cache, md, sm_scale=1 / np.sqrt(dim))
+    assert updated.shape == cache.shape
+    assert out.shape == q.shape
+    positions = np.concatenate([
+        np.arange(chunk * chunk_size, (chunk + 1) * chunk_size)
+        for chunk in row_order
+    ])
+    repeated_kv = jnp.repeat(kv_natural,
+                             q_heads // kv_heads,
+                             axis=1).astype(jnp.float32)
+    scores = jnp.einsum("qhd,khd->hqk", q_natural.astype(jnp.float32),
+                        repeated_kv) / np.sqrt(dim)
+    causal = jnp.arange(total)[None, :] <= jnp.arange(total)[:, None]
+    natural_expected = jnp.einsum(
+        "hqk,khd->qhd",
+        jax.nn.softmax(jnp.where(causal[None], scores, -jnp.inf), axis=-1),
+        repeated_kv).astype(jnp.bfloat16)
+    expected_output = reorder(natural_expected)
+    expected_output = jnp.where((positions < num_current)[:, None, None],
+                                expected_output, 0)
+    np.testing.assert_allclose(out.astype(jnp.float32),
+                               expected_output.astype(jnp.float32),
+                               atol=2e-2,
+                               rtol=2e-2)
+    np.testing.assert_array_equal(out[positions >= num_current],
+                                  jnp.zeros_like(out[positions >= num_current]))
+    expected_cache = jnp.zeros_like(cache)
+    for position in range(num_current):
+        owner = position % pcp_size
+        slot = owner * 128 + position // pcp_size
+        # Note (david): K and V are the same rows here, so repeating each head
+        # twice builds the interleaved [k0, v0, k1, v1, ...] cache row.
+        expected_cache = expected_cache.at[0, slot].set(
+            jnp.repeat(kv_natural[position], 2, axis=0))
+    np.testing.assert_array_equal(updated, expected_cache)
+
+
+def test_full_history_wrapper_keeps_padded_queries_zero(monkeypatch):
+    pcp_size, local_tokens, heads, dim = 2, 4, 2, 8
+    if jax.device_count() < pcp_size:
+        pytest.skip("requires simulated multi-device CPU")
+
+    def fake_history(q, cache, block_table, history_len, **unused):
+        del cache, block_table, history_len, unused
+        return (jnp.ones_like(q),
+                jnp.zeros(q.shape[:2], dtype=jnp.float32))
+
+    def fake_current(q, k, v, **unused):
+        del k, v, unused
+        valid = jnp.arange(q.shape[0]) == 0
+        out = jnp.where(valid[:, None, None], jnp.full_like(q, 2), 0)
+        lse = jnp.where(valid[:, None],
+                        jnp.zeros(q.shape[:2], jnp.float32), -jnp.inf)
+        owned = jnp.zeros((q.shape[0], 1, q.shape[-1]), q.dtype)
+        return out, lse, owned, owned
+
+    monkeypatch.setattr(flywheel_pcp, "_history_attention", fake_history)
+    monkeypatch.setattr(flywheel_pcp, "_current_attention_head_tail", fake_current)
+    monkeypatch.setattr(flywheel_backend, "write_kv_cache",
+                        lambda k, v, cache, slices, counts: cache)
+    total = pcp_size * local_tokens
+    q = jnp.zeros((total, heads, dim), jnp.bfloat16)
+    k = v = jnp.zeros((total, 1, dim), jnp.bfloat16)
+    cache = jnp.zeros((1, 128 * pcp_size, 2, dim), jnp.bfloat16)
+    pcp = PCPMetadata(query_start_loc=jnp.zeros((pcp_size, 2), jnp.int32),
+                      kv_cache_lens=jnp.array([1], jnp.int32),
+                      q_pos_offsets=jnp.zeros((pcp_size, 1), jnp.int32),
+                      cache_pages=1,
+                      num_current_tokens=jnp.array(2, jnp.int32))
+    md = AttentionMetadata(input_positions=jnp.arange(total),
+                           block_tables=jnp.array([0], jnp.int32),
+                           seq_lens=jnp.array([3], jnp.int32),
+                           pcp=pcp,
+                           kv_write_slices=jnp.zeros(pcp_size * 3, jnp.int32),
+                           kv_write_num_slices=jnp.zeros(pcp_size, jnp.int32))
+    mesh = Mesh(np.array(jax.devices()[:pcp_size]), ("pcp",))
+    _, output = flywheel_pcp.sharded_flywheel_tpu_pcp_attention(
+        mesh, q, k, v, cache, md, sm_scale=1.0)
+    output = output.reshape(pcp_size, local_tokens, heads, dim)
+    assert jnp.all(output[:, 0] != 0)
+    np.testing.assert_array_equal(output[:, 1:],
+                                  jnp.zeros_like(output[:, 1:]))
diff --git a/tests/layers/common/test_flywheel_pcp_cache_layout.py b/tests/layers/common/test_flywheel_pcp_cache_layout.py
