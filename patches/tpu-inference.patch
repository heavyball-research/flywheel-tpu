 # limitations under the License.
 
+import functools
+
 DEFAULT_MAX_DECODE_STEPS = 10
 
 
+def patch_vllm_scheduler_for_tpu_pcp() -> None:
+    """Map TPU PCP cache accounting onto vLLM's supported DCP contract.
+
+    vLLM's V1 Scheduler currently hard-codes ``pcp_world_size=1`` when it
+    constructs KVCacheManager. TPU stores the same round-robin token shards as
+    DCP, so cache accounting must use DCP * PCP while model execution keeps the
+    original parallel configuration.
+    """
+    from vllm.v1.core.sched.scheduler import Scheduler
+
+    if getattr(Scheduler, "_tpu_pcp_cache_accounting_patched", False):
+        return
+    original_init = Scheduler.__init__
+
+    @functools.wraps(original_init)
+    def pcp_cache_aware_init(scheduler_self, vllm_config, *args, **kwargs):
+        parallel = vllm_config.parallel_config
+        pcp_size = parallel.prefill_context_parallel_size
+        from vllm.platforms import current_platform
+        from tpu_inference import envs
+        if (pcp_size <= 1 or not current_platform.is_tpu()
+                or not envs.NEW_MODEL_DESIGN):
+            return original_init(scheduler_self, vllm_config, *args, **kwargs)
+        dcp_size = parallel.decode_context_parallel_size
+        parallel.decode_context_parallel_size = dcp_size * pcp_size
+        parallel.prefill_context_parallel_size = 1
+        try:
+            result = original_init(scheduler_self, vllm_config, *args, **kwargs)
+        finally:
+            parallel.decode_context_parallel_size = dcp_size
+            parallel.prefill_context_parallel_size = pcp_size
+        scheduler_self.dcp_world_size = dcp_size
+        scheduler_self.pcp_world_size = pcp_size
+        return result
+
+    Scheduler.__init__ = pcp_cache_aware_init
+    Scheduler._tpu_pcp_cache_accounting_patched = True
+
+
