+# SPDX-License-Identifier: Apache-2.0
+
+import importlib.util
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+# This protocol module intentionally has no JAX/vLLM runtime dependency.
+_path = (Path(__file__).resolve().parents[2] / "tpu_inference" /
+         "distributed" / "flywheel_kv_transfer.py")
+_spec = importlib.util.spec_from_file_location("flywheel_kv_transfer", _path)
+_module = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_module)
+get_flywheel_kv_transfer_config = _module.get_flywheel_kv_transfer_config
+validate_flywheel_kv_transfer_config = _module.validate_flywheel_kv_transfer_config
+
+
+def make_config(pcp_size=4, tp_size=2, cache_dtype="auto"):
+    return SimpleNamespace(
+        model_config=SimpleNamespace(dtype="torch.bfloat16"),
+        cache_config=SimpleNamespace(block_size=128, cache_dtype=cache_dtype),
+        sharding_config=SimpleNamespace(tp_size=tp_size,
+                                        prefill_cp_size=pcp_size,
+                                        decode_cp_size=1,
+                                        expert_size=1,
+                                        model_dp_size=1,
+                                        attn_dp_size=1,
+                                        attn_dp_expert_size=1))
+
+
+@pytest.mark.parametrize("pcp_size", [1, 2, 4, 8])
+@pytest.mark.parametrize("tp_size", [1, 2, 4])
+def test_matching_config_survives_json_transport(pcp_size, tp_size):
+    local = get_flywheel_kv_transfer_config(make_config(pcp_size, tp_size))
+    remote = json.loads(json.dumps(local))
+    validate_flywheel_kv_transfer_config(local, remote)
+    assert local["pcp_size"] == pcp_size
+    assert local["tp_size"] == tp_size
+
+
+def test_auto_and_explicit_bfloat16_are_compatible():
+    local = get_flywheel_kv_transfer_config(make_config())
+    remote = get_flywheel_kv_transfer_config(make_config(cache_dtype="bfloat16"))
+    validate_flywheel_kv_transfer_config(local, remote)
+
+
+def test_uses_resolved_sharding_during_scheduler_pcp_shim():
+    config = make_config(pcp_size=4)
+    config.parallel_config = SimpleNamespace(prefill_context_parallel_size=1,
+                                             decode_context_parallel_size=4)
+    profile = get_flywheel_kv_transfer_config(config)
+    assert profile["pcp_size"] == 4
+    assert profile["dcp_size"] == 1
+
+
+@pytest.mark.parametrize("field,value", [
+    ("layout", "rpa"),
+    ("tp_size", 8),
+    ("pcp_size", 1),
+    ("dcp_size", 2),
+    ("expert_size", 2),
+    ("model_dp_size", 2),
+    ("attn_dp_size", 2),
+    ("attn_dp_expert_size", 2),
+    ("block_size", 256),
+    ("model_dtype", "float16"),
+    ("kv_dtype", "float32"),
+])
+def test_mismatched_config_fails_fast(field, value):
+    local = get_flywheel_kv_transfer_config(make_config())
+    remote = dict(local, **{field: value})
+    with pytest.raises(ValueError, match=field):
+        validate_flywheel_kv_transfer_config(local, remote)
+
+
+@pytest.mark.parametrize("missing_local", [False, True])
+def test_mixed_backend_or_missing_profile_fails_fast(missing_local):
+    profile = get_flywheel_kv_transfer_config(make_config())
+    local, remote = (None, profile) if missing_local else (profile, None)
+    with pytest.raises(ValueError, match="both endpoints"):
+        validate_flywheel_kv_transfer_config(local, remote)
+
+
+def test_missing_profile_field_fails_fast():
+    local = get_flywheel_kv_transfer_config(make_config())
+    remote = dict(local)
+    del remote["pcp_size"]
+    with pytest.raises(ValueError, match="pcp_size"):
+        validate_flywheel_kv_transfer_config(local, remote)
+
+
+def test_legacy_non_flywheel_endpoints_are_unchanged():
+    validate_flywheel_kv_transfer_config(None, None)
