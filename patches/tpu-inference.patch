+def test_split_read_write_state_slots() -> None:
+    """Mamba prefix caching (mamba_cache_mode align): resuming from the slot
+    cached at the last block boundary while checkpointing into the block that
+    covers the current position must not change the numerics, and must leave
+    the cached slot intact for later requests to hit."""
+    chunk_len = 32
+    total_len = 64
+    num_blocks = 3
+    read_slot, write_slot = 1, 2
+
+    rngs = iter(jax.random.split(jax.random.key(23), 12))
+    query = jax.random.normal(next(rngs), (total_len, N_KQ * D_K))
+    key = jax.random.normal(next(rngs), (total_len, N_KQ * D_K))
+    value = jax.random.normal(next(rngs), (total_len, N_V * D_V))
+    b = jax.random.normal(next(rngs), (total_len, N_V))
+    a = jax.random.normal(next(rngs), (total_len, N_V))
+    conv_weight = jax.random.normal(next(rngs), (DIM, 1, KERNEL_SIZE))
+    conv_bias = jax.random.normal(next(rngs), (DIM, ))
+    a_log = jax.random.normal(next(rngs), (N_V, ))
+    dt_bias = jax.random.normal(next(rngs), (N_V, ))
+
+    kernel_acts, _ = make_activations(qkv=jnp.concatenate([query, key, value],
+                                                          axis=-1),
+                                      b=b,
+                                      a=a)
+    qkv, b, a = kernel_acts["qkv"], kernel_acts["b"], kernel_acts["a"]
+
+    conv_state_zero = jnp.zeros((num_blocks, KERNEL_SIZE - 1, DIM))
+    recurrent_state_zero = jnp.zeros((num_blocks, N_V, D_K, D_V))
+
+    fused = jax.jit(fused_conv1d_gdn, static_argnames=STATIC_ARGNAMES)
+    common_kwargs = {
+        "conv_weight": conv_weight,
+        "conv_bias": conv_bias,
+        "a_log": a_log,
+        "dt_bias": dt_bias,
+        "distribution": jnp.array([0, 1, 1], dtype=jnp.int32),
+        "n_kq": N_KQ,
+        "n_v": N_V,
+        "d_k": D_K,
+        "d_v": D_V,
+        "kernel_size": KERNEL_SIZE,
+    }
+
+    _, output_ref = fused(qkv=qkv,
+                          b=b,
+                          a=a,
+                          conv_state=conv_state_zero,
+                          recurrent_state=recurrent_state_zero,
+                          query_start_loc=jnp.array([0, total_len]),
+                          state_indices=jnp.array([read_slot]),
+                          read_state_indices=jnp.array([read_slot]),
+                          seq_lens=jnp.array([total_len], dtype=jnp.int32),
+                          **common_kwargs)
+    (conv_after_first,
+     rec_after_first), _ = fused(qkv=qkv[:chunk_len],
+                                 b=b[:chunk_len],
+                                 a=a[:chunk_len],
+                                 conv_state=conv_state_zero,
+                                 recurrent_state=recurrent_state_zero,
+                                 query_start_loc=jnp.array([0, chunk_len]),
+                                 state_indices=jnp.array([read_slot]),
+                                 read_state_indices=jnp.array([read_slot]),
+                                 seq_lens=jnp.array([chunk_len],
+                                                    dtype=jnp.int32),
+                                 **common_kwargs)
+    (conv_after_second, rec_after_second), output_second = fused(
+        qkv=qkv[chunk_len:],
+        b=b[chunk_len:],
+        a=a[chunk_len:],
+        conv_state=conv_after_first,
+        recurrent_state=rec_after_first,
+        query_start_loc=jnp.array([0, chunk_len]),
+        state_indices=jnp.array([write_slot]),
+        read_state_indices=jnp.array([read_slot]),
+        seq_lens=jnp.array([total_len], dtype=jnp.int32),
+        **common_kwargs)
+
+    np.testing.assert_allclose(output_second.astype(jnp.float32),
+                               output_ref[chunk_len:].astype(jnp.float32),
+                               **BF16_TOLERANCE)
+    np.testing.assert_array_equal(conv_after_second[read_slot],
+                                  conv_after_first[read_slot])
+    np.testing.assert_array_equal(rec_after_second[read_slot],
+                                  rec_after_first[read_slot])
+    assert np.any(np.asarray(rec_after_second[write_slot]) != 0.0), (
+        "write_slot should hold the step's final recurrent state")
