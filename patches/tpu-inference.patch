@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from vllm.config import VllmConfig
+
+
+def get_flywheel_kv_transfer_config(
+        config: "VllmConfig") -> dict[str, str | int]:
+    sharding = config.sharding_config
+    model_dtype = str(config.model_config.dtype).removeprefix("torch.")
+    if config.cache_config.cache_dtype == "auto":
+        cache_dtype = model_dtype
+    else:
+        cache_dtype = config.cache_config.cache_dtype
+    # Note (david): use the resolved sharding, not parallel_config: the
+    # scheduler PCP shim temporarily folds PCP into DCP while constructing the
+    # connector.
+    return {
+        "layout": "flywheel_merged_kv_v2",
+        "tp_size": sharding.tp_size,
+        "pcp_size": sharding.prefill_cp_size,
+        "dcp_size": sharding.decode_cp_size,
+        "expert_size": sharding.expert_size,
+        "model_dp_size": sharding.model_dp_size,
+        "attn_dp_size": sharding.attn_dp_size,
+        "attn_dp_expert_size": sharding.attn_dp_expert_size,
+        "block_size": config.cache_config.block_size,
+        "model_dtype": model_dtype,
+        "kv_dtype": str(cache_dtype).removeprefix("torch."),
+    }
+
+
+def validate_flywheel_kv_transfer_config(
+    local: dict[str, Any] | None,
+    remote: dict[str, Any] | None,
+) -> None:
+    if local is None and remote is None:
+        return
+    if local is None or remote is None:
+        raise ValueError(
+            "FlyWheel PD requires both endpoints to use FlyWheel "
+            "and advertise their KV transfer configuration.")
+    if not isinstance(remote, dict):
+        raise ValueError("Invalid FlyWheel KV transfer configuration.")
+    mismatches = [
+        f"{key}: local={local.get(key)!r}, remote={remote.get(key)!r}"
+        for key in sorted(local.keys() | remote.keys())
+        if local.get(key) != remote.get(key)
+    ]
+    if mismatches:
+        raise ValueError("Incompatible FlyWheel PD configuration: " +
+                         "; ".join(mismatches))
