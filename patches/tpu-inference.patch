+def patch_kernels(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Run the real Pallas kernels, interpreted when there is no TPU."""
+    interpret = jax.default_backend() != "tpu"
+    for name, kernel in (
+        ("flash_attn_varlen_func", fa.flash_attn_varlen_func),
+        ("flash_attn_func", fa.flash_attn_func),
+        ("flash_attn_with_kvcache", fa.flash_attn_with_kvcache),
+    ):
+        monkeypatch.setattr(fa, name,
+                            functools.partial(kernel, interpret=interpret))
+
+
+def shared_prefix_batch(kv_heads: int) -> StepBatch:
+    """Two requests reading one shared prefix page, with new rows that cross a
+    page edge."""
+    rng = np.random.default_rng(81)
+
+    def _values(shape):
+        return jnp.asarray(rng.normal(size=shape), jnp.bfloat16)
+
+    num_tokens, num_pages = 32, 7
+    q = _values((num_tokens, QUERY_HEADS, HEAD_DIM))
+    k, v = (_values((num_tokens, kv_heads, HEAD_DIM)) for _ in range(2))
+    cache = _values((num_pages, PAGE_SIZE, 2 * kv_heads, HEAD_DIM))
+    return StepBatch(q=q,
+                     k=k,
+                     v=v,
+                     kv_cache=cache,
+                     block_table=np.array([[3, 1, 5], [3, 4, 2], [99, 99, 99]],
+                                          np.int32),
+                     cu_q_lens=np.array([0, 1, 20, 20], np.int32),
+                     kv_lens=np.array([129, 263, 0], np.int32),
+                     num_reqs=2)
+
+
+def reference_attention(batch: StepBatch) -> tuple[np.ndarray, np.ndarray]:
+    """Causal paged attention over the whole batch in numpy: the output rows
+    and the cache the step should leave behind."""
+    updated = np.array(batch.kv_cache)
+    output = np.zeros(batch.q.shape, np.float32)
+    kv_heads = batch.k.shape[1]
+    for req in range(batch.num_reqs):
+        start, end = batch.cu_q_lens[req:req + 2]
+        prefix = batch.kv_lens[req] - (end - start)
+        for row in range(start, end):
+            page, offset = divmod(prefix + row - start, PAGE_SIZE)
+            page = batch.block_table[req, page]
+            updated[page, offset] = np.stack(
+                [batch.k[row], batch.v[row]], axis=1).reshape(-1, HEAD_DIM)
+    for req in range(batch.num_reqs):
+        start, end = batch.cu_q_lens[req:req + 2]
+        keys, values = [], []
+        for pos in range(batch.kv_lens[req]):
+            page = batch.block_table[req, pos // PAGE_SIZE]
+            offset = pos % PAGE_SIZE
+            kv_pair = updated[page, offset].reshape(kv_heads, 2, HEAD_DIM)
+            key, value = kv_pair[:, 0], kv_pair[:, 1]
+            keys.append(key)
+            values.append(value)
+        keys, values = (np.repeat(np.array(kv_rows, np.float32),
+                                  QUERY_HEADS // kv_heads,
+                                  axis=1) for kv_rows in (keys, values))
+        for row in range(start, end):
+            num_visible = batch.kv_lens[req] - (end - row) + 1
+            scores = np.einsum("hd,khd->hk", np.array(
+                batch.q[row], np.float32), keys[:num_visible]) / np.sqrt(
+                    batch.q.shape[-1])
+            probs = np.exp(scores - scores.max(axis=-1, keepdims=True))
+            probs /= probs.sum(axis=-1, keepdims=True)
+            output[row] = np.einsum("hk,khd->hd", probs,
+                                    values[:num_visible])
+    return output, updated
+
+
+def slice_table_writer(executed_pieces: list[int]) -> Callable[..., jax.Array]:
+    """A write_kv_cache stand-in that runs the host slice table itself, so the
+    kernels under test must read the updated pages."""
+
+    def _write(k_in, v_in, kv_cache, kv_write_slices, kv_write_num_slices):
+        executed_pieces.append(int(kv_write_num_slices[0]))
+        updated_cache = kv_cache
+        for piece in range(int(kv_write_num_slices[0])):
+            cache_row_start, new_row_start, length = map(
+                int, kv_write_slices[:, piece])
+            for offset in range(length):
+                page, token = divmod(cache_row_start + offset, PAGE_SIZE)
+                new_row = new_row_start + offset
+                updated_cache = updated_cache.at[page, token].set(
+                    jnp.stack([k_in[new_row], v_in[new_row]],
+                              axis=1).reshape(-1, k_in.shape[-1]))
+        return updated_cache
+
+    return _write
+
+
+def build_slice_table(batch: StepBatch) -> tuple[np.ndarray, int]:
+    """The host slice table for this step's rows, and its piece count."""
+    bound = fa.kv_write_slice_bound(batch.q.shape[0], batch.kv_lens.size,
+                                    PAGE_SIZE)
+    slices = np.zeros((3, bound), np.int32)
+    count = fa.build_kv_write_slices(batch.cu_q_lens[:batch.num_reqs + 1],
+                                     batch.kv_lens[:batch.num_reqs],
+                                     batch.block_table[:batch.num_reqs],
+                                     page_size=PAGE_SIZE,
+                                     out=slices)
+    return slices, count
+
