index 000000000..90244df46
--- /dev/null
+++ b/tpu_inference/layers/common/linear_attention.py
@@ -0,0 +1,302 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Shared sharding contract for fused GDN and KDA state updates."""
+
+import functools
+from collections.abc import Callable
+
+import jax
+import jax.numpy as jnp
+from jax.sharding import PartitionSpec as P
+from vllm.config import CacheConfig
+
+from tpu_inference.layers.common.attention_metadata import AttentionMetadata
+from tpu_inference.layers.common.sharding import ShardingAxisName
+from tpu_inference.layers.common.utils import truncate_sharded_tensor
+from tpu_inference.utils import get_mesh_shape_product
+
+
+def _pcp_row_order(pcp_size: int) -> tuple[int, ...]:
+    return tuple(chunk for rank in range(pcp_size)
+                 for chunk in (rank, 2 * pcp_size - 1 - rank))
+
+
+def pcp_natural_to_rank_order(x: jax.Array, pcp_size: int) -> jax.Array:
+    """Permute natural sequence chunks into PCP head-tail rank order."""
+    return x[jnp.asarray(_pcp_row_order(pcp_size))]
+
+
+def pcp_rank_to_natural_order(x: jax.Array, pcp_size: int) -> jax.Array:
+    """Undo the PCP head-tail chunk permutation."""
+    inverse = tuple(
+        sorted(range(2 * pcp_size), key=_pcp_row_order(pcp_size).__getitem__))
+    return x[jnp.asarray(inverse)]
+
+
+def get_linear_attention_metadata(
+    metadata: AttentionMetadata,
+    cache_config: CacheConfig,
+    dp_size: int,
+) -> tuple[jax.Array, jax.Array, jax.Array, jax.Array, jax.Array]:
+    """Resolve per-DP-shard state slots without crossing a DP boundary.
+
+    Returns query_start_loc, seq_lens, request_distribution, and the write
+    and read state slots, which differ under prefix caching: a request
+    resumes from the last block boundary and writes its current block.
+    """
+    num_reqs_per_dp = metadata.padded_num_reqs // dp_size
+    query_start_loc = truncate_sharded_tensor(metadata.query_start_loc,
+                                              num_reqs_per_dp + 1, dp_size)
+    seq_lens = truncate_sharded_tensor(metadata.seq_lens, num_reqs_per_dp,
+                                       dp_size)
+    if cache_config.mamba_cache_mode == "align":
+        block_tables = metadata.block_tables.reshape(
+            metadata.seq_lens.shape[0], -1)
+        block_tables = block_tables.reshape(
+            dp_size, metadata.seq_lens.shape[0] // dp_size, -1)
+        block_tables = block_tables[:, :num_reqs_per_dp].reshape(
+            -1, block_tables.shape[-1])
+        query_lens = jnp.diff(query_start_loc.reshape(dp_size,
+                                                      num_reqs_per_dp + 1),
+                              axis=1).reshape(-1)
+        block_size = cache_config.mamba_block_size
+        read_column = jnp.maximum(seq_lens - query_lens - 1, 0) // block_size
+        write_column = jnp.maximum(seq_lens - 1, 0) // block_size
+        request_rows = jnp.arange(seq_lens.shape[0])
+        read_state_indices = block_tables[request_rows, read_column]
+        write_state_indices = block_tables[request_rows, write_column]
+    elif cache_config.mamba_cache_mode == "none":
+        write_state_indices = truncate_sharded_tensor(
+            metadata.mamba_state_indices.astype(jnp.int32), num_reqs_per_dp,
+            dp_size)
+        read_state_indices = write_state_indices
+    else:
+        raise ValueError("Unsupported linear attention cache mode: "
+                         f"{cache_config.mamba_cache_mode}")
+    return (query_start_loc, seq_lens, metadata.request_distribution,
+            write_state_indices, read_state_indices)
+
+
+def run_sharded_linear_attention(
+    kernel: Callable[..., tuple[tuple[jax.Array, jax.Array], jax.Array]],
+    j_mixed_qkv: jax.Array,
+    j_b: jax.Array,
+    j_gate: jax.Array,
+    conv_state: jax.Array,
+    recurrent_state: jax.Array,
+    j_conv_weight: jax.Array,
+    j_conv_bias: jax.Array | None,
+    j_A_log: jax.Array,
+    j_dt_bias: jax.Array,
+    state_indices: jax.Array,
+    query_start_loc: jax.Array,
+    distribution: jax.Array,
+    seq_lens: jax.Array,
+    n_kq: int,
+    n_v: int,
+    d_k: int,
+    d_v: int,
+    kernel_size: int,
+    mesh: jax.sharding.Mesh,
+    read_state_indices: jax.Array | None = None,
+    pcp_size: int = 1,
+    pcp_query_layout: str = "head_tail",
+) -> tuple[tuple[jax.Array, jax.Array], jax.Array]:
+    """Shard-map a fused linear attention kernel over the attention axes.
+
+    Heads split over ATTN_HEAD and requests over ATTN_DATA, so the kernel
+    sees per-shard head counts. read_state_indices defaults to
+    state_indices, i.e. resume from the slot that is written back. With
+    pcp_size > 1 the heads still split over ATTN_HEAD alone.
+    """
+    if read_state_indices is None:
+        read_state_indices = state_indices
+
+    if pcp_size > 1:
+        return _run_pcp_linear_attention(
+            kernel, j_mixed_qkv, j_b, j_gate, conv_state, recurrent_state,
+            j_conv_weight, j_conv_bias, j_A_log, j_dt_bias, state_indices,
+            query_start_loc, distribution, seq_lens, n_kq, n_v, d_k, d_v,
+            kernel_size, mesh, read_state_indices, pcp_size, pcp_query_layout)
+
+    in_specs = (
+        P(ShardingAxisName.ATTN_DATA,
+          ShardingAxisName.ATTN_HEAD),  # j_mixed_qkv
+        P(ShardingAxisName.ATTN_DATA, ShardingAxisName.ATTN_HEAD),  # j_b
+        P(ShardingAxisName.ATTN_DATA, ShardingAxisName.ATTN_HEAD),  # j_gate
+        P(ShardingAxisName.ATTN_DATA, None,
+          ShardingAxisName.ATTN_HEAD),  # conv_state
+        P(ShardingAxisName.ATTN_DATA, ShardingAxisName.ATTN_HEAD, None,
+          None),  # recurrent_state
+        P(ShardingAxisName.ATTN_HEAD, None, None),  # j_conv_weight
+        P(ShardingAxisName.ATTN_HEAD)
+        if j_conv_bias is not None else None,  # j_conv_bias
+        P(ShardingAxisName.ATTN_HEAD),  # j_A_log
+        P(ShardingAxisName.ATTN_HEAD),  # j_dt_bias
+        P(ShardingAxisName.ATTN_DATA),  # query_start_loc
+        P(ShardingAxisName.ATTN_DATA),  # state_indices
+        P(ShardingAxisName.ATTN_DATA),  # distribution
+        P(ShardingAxisName.ATTN_DATA),  # seq_lens
+        P(ShardingAxisName.ATTN_DATA),  # read_state_indices
+    )
+
+    out_specs = (
+        (
+            P(ShardingAxisName.ATTN_DATA, None,
+              ShardingAxisName.ATTN_HEAD),  # new_conv_state
+            P(ShardingAxisName.ATTN_DATA, ShardingAxisName.ATTN_HEAD, None,
+              None),  # new_recurrent_state
+        ),
+        P(ShardingAxisName.ATTN_DATA, ShardingAxisName.ATTN_HEAD),  # output
+    )
+
+    tp_size = get_mesh_shape_product(mesh, ShardingAxisName.ATTN_HEAD)
+    local_kernel = functools.partial(
+        kernel,
+        n_kq=n_kq // tp_size,
+        n_v=n_v // tp_size,
+        d_k=d_k,
+        d_v=d_v,
+        kernel_size=kernel_size,
+    )
+    mapped_fn = jax.shard_map(
+        local_kernel,
+        mesh=mesh,
+        in_specs=in_specs,
+        out_specs=out_specs,
+        check_vma=False,
+    )
+    return mapped_fn(
+        j_mixed_qkv,
+        j_b,
+        j_gate,
+        conv_state,
+        recurrent_state,
+        j_conv_weight,
+        j_conv_bias,
+        j_A_log,
+        j_dt_bias,
+        query_start_loc,
+        state_indices,
+        distribution,
+        seq_lens,
+        read_state_indices,
+    )
+
+
+def _run_pcp_linear_attention(
+    kernel: Callable[..., tuple[tuple[jax.Array, jax.Array], jax.Array]],
+    j_mixed_qkv: jax.Array,
+    j_b: jax.Array,
+    j_gate: jax.Array,
+    conv_state: jax.Array,
+    recurrent_state: jax.Array,
+    j_conv_weight: jax.Array,
+    j_conv_bias: jax.Array | None,
+    j_A_log: jax.Array,
+    j_dt_bias: jax.Array,
+    state_indices: jax.Array,
+    query_start_loc: jax.Array,
+    distribution: jax.Array,
+    seq_lens: jax.Array,
+    n_kq: int,
+    n_v: int,
+    d_k: int,
+    d_v: int,
+    kernel_size: int,
+    mesh: jax.sharding.Mesh,
+    read_state_indices: jax.Array,
+    pcp_size: int,
+    pcp_query_layout: str,
+) -> tuple[tuple[jax.Array, jax.Array], jax.Array]:
+    """Run the TP-only kernel on the whole request on every PCP rank.
+
+    The sequence is all-gathered over PCP into natural order, and each PCP
+    rank runs the same recurrence on its ATTN_HEAD shard of the heads, so the
+    states stay replicated over PCP and each rank keeps the output rows of
+    its own tokens.
+    """
+    if pcp_query_layout not in ("head_tail", "contiguous"):
+        raise ValueError(f"Unknown PCP query layout: {pcp_query_layout!r}.")
+    pcp_axis = ShardingAxisName.PREFILL_CONTEXT
+    in_specs = (
+        P(ShardingAxisName.ATTN_DATA,
+          ShardingAxisName.ATTN_HEAD),  # j_mixed_qkv
+        P(ShardingAxisName.ATTN_DATA, ShardingAxisName.ATTN_HEAD),  # j_b
+        P(ShardingAxisName.ATTN_DATA, ShardingAxisName.ATTN_HEAD),  # j_gate
+        P(ShardingAxisName.BATCH, None,
+          ShardingAxisName.ATTN_HEAD),  # conv_state
+        P(ShardingAxisName.BATCH, ShardingAxisName.ATTN_HEAD, None,
+          None),  # recurrent_state
+        P(ShardingAxisName.ATTN_HEAD, None, None),  # j_conv_weight
+        P(ShardingAxisName.ATTN_HEAD)
+        if j_conv_bias is not None else None,  # j_conv_bias
+        P(ShardingAxisName.ATTN_HEAD),  # j_A_log
+        P(ShardingAxisName.ATTN_HEAD),  # j_dt_bias
+        P(ShardingAxisName.BATCH),  # query_start_loc
+        P(ShardingAxisName.BATCH),  # state_indices
+        P(ShardingAxisName.BATCH),  # distribution
+        P(ShardingAxisName.BATCH),  # seq_lens
+        P(ShardingAxisName.BATCH),  # read_state_indices
+    )
+    out_specs = (
+        (
+            P(ShardingAxisName.BATCH, None,
+              ShardingAxisName.ATTN_HEAD),  # new_conv_state
+            P(ShardingAxisName.BATCH, ShardingAxisName.ATTN_HEAD, None,
+              None),  # new_recurrent_state
+        ),
+        P(ShardingAxisName.ATTN_DATA, ShardingAxisName.ATTN_HEAD),  # output
+    )
+    tp_size = get_mesh_shape_product(mesh, ShardingAxisName.ATTN_HEAD)
+
+    def to_natural_order(x):
+        if pcp_query_layout == "contiguous":
+            return x
+        chunks = x.reshape(2 * pcp_size, -1, *x.shape[1:])
+        return pcp_rank_to_natural_order(chunks, pcp_size).reshape(x.shape)
+
+    def to_local_rows(x, num_local_tokens):
+        if pcp_query_layout == "head_tail":
+            chunks = x.reshape(2 * pcp_size, -1, *x.shape[1:])
+            x = pcp_natural_to_rank_order(chunks, pcp_size).reshape(x.shape)
+        rank = jax.lax.axis_index(pcp_axis)
+        return jax.lax.dynamic_slice_in_dim(x, rank * num_local_tokens,
+                                            num_local_tokens)
+
+    def local_fn(qkv, b, gate, conv, recurrent, weight, bias, a_log, dt_bias,
+                 starts, slots, dist, lengths, read_slots):
+        gathered = jax.lax.all_gather((qkv, b, gate),
+                                      pcp_axis,
+                                      axis=0,
+                                      tiled=True)
+        full_qkv, full_b, full_gate = map(to_natural_order, gathered)
+        states, output = kernel(full_qkv,
+                                full_b,
+                                full_gate,
+                                conv,
+                                recurrent,
+                                weight,
+                                bias,
+                                a_log,
+                                dt_bias,
+                                starts,
+                                slots,
+                                dist,
+                                lengths,
+                                read_slots,
+                                n_kq=n_kq // tp_size,
+                                n_v=n_v // tp_size,
+                                d_k=d_k,
+                                d_v=d_v,
+                                kernel_size=kernel_size)
+        return states, to_local_rows(output, qkv.shape[0])
+
+    mapped_fn = jax.shard_map(local_fn,
+                              mesh=mesh,
+                              in_specs=in_specs,
+                              out_specs=out_specs,
+                              check_vma=False)
+    return mapped_fn(j_mixed_qkv, j_b, j_gate, conv_state, recurrent_state,
+                     j_conv_weight, j_conv_bias, j_A_log, j_dt_bias,
+                     query_start_loc, state_indices, distribution, seq_lens,
+                     read_state_indices)
