+        pytest.param(11, [1] * 8 + [128, 128, 256],
+                     [0, 1, 2, 3, 4, 5, 6, 7, 8, 136, 264, 520], [8, 11, 11],
+                     id="mixed_prefill_decode"),
+        pytest.param(16, [128, 64, 32, 16, 8],
+                     [0, 128, 192, 224, 240, 248] + [1] * 11, [0, 5, 5],
