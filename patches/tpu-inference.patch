+@pytest.mark.parametrize("num_kv_heads", [2, 4])
+def test_merged_multihead_extend_history_matches_reference(num_kv_heads):
+    num_query_heads, head_dim, num_visible_tokens = 8, 128, 37
+    q = (jnp.arange(8 * num_query_heads * head_dim, dtype=jnp.float32).reshape(
+        8, num_query_heads, head_dim) % 17 / 17).astype(jnp.bfloat16)
+    key = (jnp.arange(128 * num_kv_heads * head_dim,
+                      dtype=jnp.float32).reshape(128, num_kv_heads, head_dim) %
+           13 / 13).astype(jnp.bfloat16)
+    value = jnp.flip(key, axis=0)
+    cache = jnp.stack((key, value), axis=2).reshape(
+        128, 2 * num_kv_heads, head_dim)[None]
+    out, lse, _ = flash_attn_with_kvcache(
+        q,
+        cache,
+        None,
+        cache_seqlens=jnp.array([num_visible_tokens], jnp.int32),
+        block_table=jnp.array([[0]], jnp.int32),
+        num_active=1,
+        cu_seqlens_q=jnp.array([0, 8], jnp.int32),
+        softmax_scale=1 / np.sqrt(head_dim),
+        causal=False,
+        return_softmax_lse=True,
+        interpret=True)
+    num_q_per_kv = num_query_heads // num_kv_heads
+    keys = jnp.repeat(key[:num_visible_tokens].astype(jnp.float32),
+                      num_q_per_kv,
+                      axis=1)
+    values = jnp.repeat(value[:num_visible_tokens].astype(jnp.float32),
+                        num_q_per_kv,
+                        axis=1)
+    scores = jnp.einsum("qhd,khd->hqk", q.astype(jnp.float32), keys)
+    scaled_scores = scores / np.sqrt(head_dim)
+    expected = jnp.einsum("hqk,khd->qhd", jax.nn.softmax(scaled_scores,
+                                                         axis=-1), values)
+    expected_lse = jax.scipy.special.logsumexp(scaled_scores, axis=-1)
+    np.testing.assert_allclose(out.astype(jnp.float32),
+                               expected,
+                               atol=3e-2,
+                               rtol=2e-2)
+    np.testing.assert_allclose(lse, expected_lse, atol=2e-4, rtol=2e-4)
+
