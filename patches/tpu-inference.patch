+# SPDX-License-Identifier: Apache-2.0
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+from jax.sharding import Mesh
+from types import SimpleNamespace
+
+from tpu_inference.layers.common import linear_attention
+from tpu_inference.layers.common.sharding import ShardingAxisName
+from tpu_inference.layers.common.utils import reorder_concatenated_tensor_for_sharding
+from tpu_inference.layers.vllm.custom_ops import gdn_attention_op
+from tpu_inference.kernels.gdn.v3 import wrapper as gdn_wrapper
+from tpu_inference.runner import kv_cache_manager
+
+
+@pytest.mark.parametrize("pcp_size", [2, 4])
+def test_pcp_chunk_permutation_round_trip(pcp_size):
+    chunks = jnp.arange(2 * pcp_size * 3).reshape(2 * pcp_size, 3)
+    rank_order = linear_attention.pcp_natural_to_rank_order(chunks, pcp_size)
+    restored = linear_attention.pcp_rank_to_natural_order(rank_order, pcp_size)
+    np.testing.assert_array_equal(restored, chunks)
+
+
+@pytest.mark.parametrize("pcp_size", [2, 4])
+def test_pcp_rank_to_natural_restores_head_tail_order(pcp_size):
+    natural = jnp.arange(2 * pcp_size)
+    row_order = [
+        c for rank in range(pcp_size) for c in (rank, 2 * pcp_size - 1 - rank)
+    ]
+    rank_order = natural[jnp.array(row_order)]
+    restored = linear_attention.pcp_rank_to_natural_order(rank_order, pcp_size)
+    np.testing.assert_array_equal(restored, natural)
+
+
+@pytest.mark.parametrize("query_layout", ["head_tail", "contiguous"])
+def test_pcp_runs_tp_only_kernel_on_whole_natural_sequence(
+        monkeypatch, query_layout):
+    ShardingAxisName.override(
+        ATTN_DATA=("data", "pcp", "attn_dp", "attn_dp_expert"),
+        ATTN_HEAD=("model", "expert", "dcp"),
+        BATCH=("data", "attn_dp", "attn_dp_expert"),
+        PREFILL_CONTEXT="pcp",
+    )
+    devices = jax.devices("cpu")
+    if len(devices) < 4:
+        pytest.skip("Requires four CPU devices")
+    pcp_size, tp_size = 2, 2
+    mesh = Mesh(
+        np.array(devices[:4]).reshape(1, pcp_size, 1, 1, tp_size, 1, 1),
+        ("data", "pcp", "attn_dp", "attn_dp_expert", "model", "expert", "dcp"))
+    num_tokens = 8
+    num_heads = 4
+    local_heads = num_heads // tp_size
+    token = jnp.arange(num_tokens, dtype=jnp.float32)[:, None]
+    head = jnp.arange(num_heads, dtype=jnp.float32)[None, :]
+    q = token * 100 + head
+    k = q + 1000
+    v = q + 2000
+    natural_qkv = reorder_concatenated_tensor_for_sharding(
+        jnp.concatenate((q, k, v), axis=1), [num_heads] * 3, tp_size, -1)
+
+    def to_rank_order(x):
+        if query_layout == "contiguous":
+            return x
+        return linear_attention.pcp_natural_to_rank_order(
+            x.reshape(2 * pcp_size, -1, x.shape[1]),
+            pcp_size).reshape(x.shape)
+
+    def kernel(qkv, b, a, conv_state, recurrent_state, conv_weight, conv_bias,
+               a_log, dt_bias, query_start_loc, state_indices, distribution,
+               seq_lens, read_state_indices, *, n_kq, n_v, d_k, d_v,
+               kernel_size):
+        del a, conv_weight, conv_bias, dt_bias, read_state_indices
+        # Every PCP rank sees the whole request with its ATTN_HEAD shard only.
+        assert qkv.shape == (num_tokens, 3 * local_heads)
+        assert b.shape == (num_tokens, local_heads)
+        assert a_log.shape == (local_heads, )
+        assert n_kq == n_v == local_heads
+        assert d_k == d_v == 1
+        assert kernel_size == 4
+        # An order-dependent causal scan stands in for the recurrence.
+        output = jnp.cumsum(qkv[:, 2 * local_heads:], axis=0)
+        marker = jnp.sum(qkv[:, :local_heads], axis=0)
+        conv_state = conv_state.at[state_indices[0], :, :local_heads].set(
+            marker)
+        recurrent_state = recurrent_state.at[state_indices[0], :, 0,
+                                             0].set(marker)
+        return (conv_state, recurrent_state), output
+
+    conv_state = jnp.zeros((3, 3, 3 * num_heads), jnp.float32)
+    recurrent_state = jnp.zeros((3, num_heads, 1, 1), jnp.float32)
+    all_gather_calls = 0
+    original_all_gather = jax.lax.all_gather
+
+    def count_all_gather(*args, **kwargs):
+        nonlocal all_gather_calls
+        all_gather_calls += 1
+        return original_all_gather(*args, **kwargs)
+
+    monkeypatch.setattr(linear_attention.jax.lax, "all_gather",
+                        count_all_gather)
+    (new_conv,
+     new_recurrent), output = linear_attention.run_sharded_linear_attention(
+         kernel,
+         to_rank_order(natural_qkv),
+         to_rank_order(q),
+         to_rank_order(q),
+         conv_state,
+         recurrent_state,
+         jnp.ones((3 * num_heads, 1, 4), jnp.float32),
+         None,
+         jnp.ones((num_heads, ), jnp.float32),
+         jnp.ones((num_heads, ), jnp.float32),
+         jnp.array([1], jnp.int32),
+         jnp.array([0, num_tokens], jnp.int32),
+         jnp.array([0, 0, 1], jnp.int32),
+         jnp.array([num_tokens], jnp.int32),
+         num_heads,
+         num_heads,
+         1,
+         1,
+         4,
+         mesh,
+         pcp_size=pcp_size,
+         pcp_query_layout=query_layout,
+     )
+    np.testing.assert_array_equal(output, to_rank_order(jnp.cumsum(v,
+                                                                   axis=0)))
+    np.testing.assert_array_equal(new_recurrent[1, :, 0, 0], jnp.sum(q,
+                                                                    axis=0))
+    np.testing.assert_array_equal(new_recurrent[0], 0)
+    np.testing.assert_array_equal(new_recurrent[2], 0)
+    assert all_gather_calls == 1
+    # Every PCP rank ran the same recurrence, so its state replicas agree.
+    for state in (new_conv, new_recurrent):
+        replicas = {}
+        for shard in state.addressable_shards:
+            key = tuple((s.start, s.stop) for s in shard.index)
+            replicas.setdefault(key, []).append(np.asarray(shard.data))
+        assert all(len(group) == pcp_size for group in replicas.values())
+        for group in replicas.values():
+            for replica in group[1:]:
+                np.testing.assert_array_equal(replica, group[0])
+
+
+@pytest.mark.parametrize(("num_current", "expected_distribution"), [
+    (7, [0, 0, 1]),
+    (1, [1, 1, 1]),
+])
+def test_pcp_gdn_metadata_is_one_natural_sequence(num_current,
+                                                  expected_distribution):
+    metadata = SimpleNamespace(
+        pcp=SimpleNamespace(
+            num_current_tokens=jnp.asarray(num_current, jnp.int32),
+            kv_cache_lens=jnp.array([16, 16], jnp.int32),
+        ),
+        mamba_state_indices=jnp.array([5, 0], jnp.int32),
+        block_tables=jnp.array([[10, 11, 12], [10, 11, 12]], jnp.int32),
+    )
+    cache = SimpleNamespace(mamba_cache_mode="none", mamba_block_size=8)
+    starts, lengths, distribution, write, read = (
+        gdn_attention_op.get_pcp_gdn_metadata(metadata, cache))
+    np.testing.assert_array_equal(starts, [0, num_current])
+    np.testing.assert_array_equal(lengths, [16 + num_current])
+    np.testing.assert_array_equal(distribution, expected_distribution)
+    np.testing.assert_array_equal(write, [5])
+    np.testing.assert_array_equal(read, [5])
+
+
+def test_pcp_gdn_metadata_uses_prefix_cache_state_slots():
+    metadata = SimpleNamespace(
+        pcp=SimpleNamespace(
+            num_current_tokens=jnp.asarray(9, jnp.int32),
