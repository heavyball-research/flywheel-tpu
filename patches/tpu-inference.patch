+    outgoing = [copy for copy in copies if copy[0][0] is scratch]
+    assert len(outgoing) == scratch.shape[0]
+    assert all(copy[1][0] is output_cache for copy in outgoing)
+    assert all(copy[1][0] is not input_cache for copy in outgoing)
diff --git a/tests/kernels/test_gdn_metadata_smem.py b/tests/kernels/test_gdn_metadata_smem.py
new file mode 100644
index 000000000..8b19479b3
--- /dev/null
+++ b/tests/kernels/test_gdn_metadata_smem.py
@@ -0,0 +1,113 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Per-sequence GDN/KDA metadata records are sized by tiles, not by tokens."""
+
+import importlib
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+
+GDN_V3_PACKAGE = "tpu_inference.kernels.gdn.v3"
+KDA_PACKAGE = "flywheel_tpu.linear_attention.kda"
+KERNEL_PACKAGES = (GDN_V3_PACKAGE,
+                   "flywheel_tpu.linear_attention.gdn", KDA_PACKAGE)
+MAX_SEQS = 8
+TILE_SIZE = 64
+QUERY_LENS = (100, 70)
+SMALL_TOKEN_BUDGET = 2048
+FULL_CONTEXT_TOKENS = 262144
+BYTES_PER_WORD = 4
+# Note (david): SMEM holds 1 MiB on v6e and every scalar buffer of the kernel
+# shares it, so the per-tile records may claim at most a 64 KiB slice of it.
+SMEM_RECORD_BUDGET_BYTES = 64 * 1024
+
+
+def compute_tile_records(package: str,
+                         batch_size: int) -> tuple[int, np.ndarray]:
+    """Tile count and packed [tiles, words] records of a two-sequence batch."""
+    config = importlib.import_module(f"{package}.config")
+    metadata = importlib.import_module(f"{package}.metadata")
+    memory_ref = importlib.import_module(f"{package}.memory_ref")
+    if package == KDA_PACKAGE:
+        # Note (david): the KDA package names its dataclasses KDAConfig and
+        # KDAMode, but compute_per_seq_metadata reads the same fields.
+        config_cls, mode = config.KDAConfig, config.KDAMode.PER_SEQ
+    else:
+        config_cls, mode = config.GDNConfig, config.GDNMode.PER_SEQ
+    dtypes = config.Dtypes(act_in=jnp.bfloat16,
+                           act_out=jnp.bfloat16,
+                           compute=jnp.float32,
+                           recurrent_state=jnp.float32,
+                           conv_state=jnp.bfloat16)
+    config_fields = {
+        "mode": mode,
+        "dtypes": dtypes,
+        "batch_size": batch_size,
+        "dim_size": 256,
+        "kernel_size": 4,
+        "tile_size": TILE_SIZE,
+        "num_kq_heads": 2,
+        "num_v_heads": 4,
+        "kq_head_dim": 64,
+        "v_head_dim": 64,
+    }
+    if package != GDN_V3_PACKAGE:
+        # Note (david): only the newer kernels split the DMA tile size from
+        # the compute chunk size.
+        config_fields["compute_chunk_size"] = TILE_SIZE
+
+    query_start_loc = np.zeros(MAX_SEQS + 1, np.int32)
+    query_start_loc[1:len(QUERY_LENS) + 1] = np.cumsum(QUERY_LENS)
+    query_start_loc[len(QUERY_LENS) + 1:] = query_start_loc[len(QUERY_LENS)]
+    seq_lens = np.zeros(MAX_SEQS, np.int32)
+    seq_lens[:len(QUERY_LENS)] = QUERY_LENS
+    state_indices = jnp.arange(1, MAX_SEQS + 1, dtype=jnp.int32)
+    with jax.default_device(jax.devices("cpu")[0]):
+        meta = metadata.compute_per_seq_metadata(
+            cfg=config_cls(**config_fields),
+            seq_lens=jnp.asarray(seq_lens),
+            query_start_loc=jnp.asarray(query_start_loc),
+            state_indices=state_indices,
+            start_seq=jnp.int32(0),
+            end_seq=jnp.int32(len(QUERY_LENS)),
+            read_indices=state_indices,
+        )
+    words = np.asarray(meta.records).reshape(
+        -1, memory_ref.PackedPIdRecord.STRUCT_SIZE)
+    return int(meta.num_tiles), words
+
+
+@pytest.mark.parametrize("package", KERNEL_PACKAGES)
+def test_records_fit_smem_at_full_context(package):
+    _, words = compute_tile_records(package, FULL_CONTEXT_TOKENS)
+    assert words.size * BYTES_PER_WORD < SMEM_RECORD_BUDGET_BYTES
+
+
+@pytest.mark.parametrize("package", KERNEL_PACKAGES)
+def test_records_cover_every_query_tile(package):
+    record = importlib.import_module(f"{package}.memory_ref").PackedPIdRecord
+    num_tiles, words = compute_tile_records(package, SMALL_TOKEN_BUDGET)
+    r_base = words[:num_tiles, 0]
+    packed = words[:num_tiles, 1]
+    s_idx = (packed >> record.S_IDX_SHIFT) & record.S_IDX_MASK
+    r_size = (packed >> record.R_SIZE_SHIFT) & record.R_SIZE_MASK
+
+    assert num_tiles == sum(-(-length // TILE_SIZE) for length in QUERY_LENS)
+    assert s_idx.tolist() == [0, 0, 1, 1]
+    assert r_size.sum() == sum(QUERY_LENS)
+    # Note (david): only the first tile of each sequence has a base that all
+    # three packages agree on. gdn.v3 places every later tile at
+    # query_start_loc + t * tile_size, while the linear_attention kernels lay
+    # them on a sublane-aligned grid starting below the sequence start, so
+    # their trailing bases are lower.
+    assert r_base[0] == 0
+    assert r_base[2] == QUERY_LENS[0]
+
+
+@pytest.mark.parametrize("package", KERNEL_PACKAGES)
+def test_valid_records_do_not_depend_on_the_token_budget(package):
+    num_tiles, small_words = compute_tile_records(package, SMALL_TOKEN_BUDGET)
+    _, large_words = compute_tile_records(package, FULL_CONTEXT_TOKENS)
+    np.testing.assert_array_equal(small_words[:num_tiles],
+                                  large_words[:num_tiles])
