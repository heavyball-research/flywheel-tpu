+def build_pcp_kv_write_slices(
+    *,
+    history: int,
+    num_current: int,
+    pcp_size: int,
+    page_size: int,
+    block_table: np.ndarray,
+    bound: int,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Build one local strided-cache write table for every PCP rank."""
+    if min(history, num_current) < 0 or pcp_size < 1:
+        raise ValueError(
+            "history/current must be nonnegative and pcp_size positive")
+    if block_table.ndim != 1:
+        raise ValueError("PCP block_table must be one replicated request row")
+    slices = np.zeros((pcp_size, 3, bound), dtype=np.int32)
+    counts = np.zeros((pcp_size, ), dtype=np.int32)
+    for rank in range(pcp_size):
+        local_history = max(0, (history + pcp_size - 1 - rank) // pcp_size)
+        local_total = max(
+            0, (history + num_current + pcp_size - 1 - rank) // pcp_size)
+        new_len = local_total - local_history
+        counts[rank] = build_kv_write_slices(
+            np.asarray([0, new_len], dtype=np.int32),
+            np.asarray([local_total], dtype=np.int32),
+            block_table[None, :],
+            page_size=page_size,
+            out=slices[rank],
+        )
+    return slices.reshape(-1), counts
