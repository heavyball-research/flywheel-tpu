+def get_pcp_gdn_metadata(attn_metadata, cache_config):
+    """Build the single natural-order sequence metadata required by GDN."""
+    num_current = jnp.asarray(attn_metadata.pcp.num_current_tokens,
+                              dtype=jnp.int32)
+    history = jnp.asarray(attn_metadata.pcp.kv_cache_lens[0], dtype=jnp.int32)
