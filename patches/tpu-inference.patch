+    shape = tuple(2 if axis == "pcp" else 1 for axis in MESH_AXIS_NAMES)
+    mesh = Mesh(np.asarray(jax.devices()[:2]).reshape(shape), MESH_AXIS_NAMES)
+    array_np = np.arange(16 * 3, dtype=np.float32).reshape(16, 3)
+    indices_np = np.array([0, 3, 7, 8, 10, 12, 14, 15], np.int32)
+    array = jax.device_put(
+        array_np,
+        NamedSharding(mesh, PartitionSpec(ShardingAxisName.ATTN_DATA, None)))
+    indices = jax.device_put(
+        indices_np,
+        NamedSharding(mesh, PartitionSpec(ShardingAxisName.BATCH)))
+    selected = TPUModelRunner._select_from_array_fn(
+        array,
+        indices,
+        mesh,
+        2,
+        pcp_sparse_gather=True,
+    )
+    np.testing.assert_array_equal(np.asarray(selected), array_np[indices_np])
+
+
+def test_runtime_select_call_surface_matches_sparse_and_legacy_primers():
+    select = MagicMock(return_value="selected")
+    assert call_select_from_array(select, "array", "indices", "mesh", 2,
