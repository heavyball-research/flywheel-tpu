+
+def rearrange_pcp_tokens_in_place(buf: np.ndarray, num_current: int,
+                                  pcp_size: int) -> None:
+    """Zero padding and reorder the last token axis into PCP head-tail rows."""
+    two_p = 2 * pcp_size
+    if buf.shape[-1] % two_p:
+        raise ValueError("PCP token axis must divide by 2 * pcp_size")
+    chunk_size = buf.shape[-1] // two_p
+    row_perm = np.asarray(
+        [chunk for rank in range(pcp_size)
+         for chunk in (rank, two_p - 1 - rank)])
+    buf[..., num_current:] = 0
+    rows = buf.reshape(*buf.shape[:-1], two_p, chunk_size)
+    buf[...] = np.take(rows, row_perm, axis=-2).reshape(buf.shape)
+
+
+def select_pcp_query_layout(use_flywheel: bool, token_bucket: int) -> str:
+    return "contiguous" if use_flywheel and token_bucket <= 1024 else "head_tail"
+
+
+def maybe_rearrange_pcp_tokens_in_place(buf: np.ndarray, num_current: int,
+                                        pcp_size: int,
+                                        query_layout: str) -> None:
+    if query_layout == "head_tail":
+        rearrange_pcp_tokens_in_place(buf, num_current, pcp_size)
+    elif query_layout == "contiguous":
+        buf[..., num_current:] = 0
+    else:
+        raise ValueError(f"Unknown PCP query layout: {query_layout}")
+
+
+def pcp_last_token_index(num_current: int, token_bucket: int, pcp_size: int,
+                         query_layout: str) -> int:
+    if query_layout == "contiguous":
+        return num_current - 1
+    chunk_size = token_bucket // (2 * pcp_size)
+    row_perm = np.asarray([
+        chunk for rank in range(pcp_size)
+        for chunk in (rank, 2 * pcp_size - 1 - rank)
+    ])
+    inv_row = np.empty(2 * pcp_size, np.int64)
+    inv_row[row_perm] = np.arange(2 * pcp_size)
+    last = num_current - 1
+    return int(inv_row[last // chunk_size] * chunk_size + last % chunk_size)
+
+
+def build_pcp_query_metadata(query_layout: str, pcp_size: int,
+                             token_bucket: int, num_current: int,
+                             max_num_reqs: int) -> tuple[np.ndarray, np.ndarray]:
+    cu = np.zeros((pcp_size, max_num_reqs + 1), np.int32)
+    offsets = np.zeros((pcp_size, max_num_reqs), np.int32)
+    for rank in range(pcp_size):
+        if query_layout == "contiguous":
+            capacity = token_bucket // pcp_size
+            start = rank * capacity
+            valid = int(np.clip(num_current - start, 0, capacity))
