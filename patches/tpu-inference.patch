+class TestDensePrefill:
+
+    def test_heads_outer_fold_restores_the_runner_layout(self, monkeypatch):
+        q = jnp.arange(6 * 4 * 8,
+                       dtype=jnp.float32).reshape(6, 4, 8).astype(jnp.bfloat16)
+        k = jnp.arange(6 * 2 * 8,
+                       dtype=jnp.float32).reshape(6, 2, 8).astype(jnp.bfloat16)
+        v = -k
+        cache = jnp.zeros((4, 128, 4, 8), jnp.bfloat16)
+        seen = {}
+
+        def _fake_flywheel(q_in, k_in, v_in, **kwargs):
+            seen.update(kwargs)
+            # Note (david): heads-outer (heads, batch, seq, head_dim): the
+            # token axis splits into (batch, seq) under each head.
+            np.testing.assert_array_equal(
+                q_in, q.reshape(2, 3, 4, 8).transpose(2, 0, 1, 3))
+            np.testing.assert_array_equal(
+                k_in, k.reshape(2, 3, 2, 8).transpose(2, 0, 1, 3))
+            np.testing.assert_array_equal(
+                v_in, v.reshape(2, 3, 2, 8).transpose(2, 0, 1, 3))
+            return q_in
+
+        monkeypatch.setattr(fa, "flash_attn_func", _fake_flywheel)
+        monkeypatch.setattr(fa, "write_kv_cache", lambda *args: args[2])
+        output, updated = fa.flywheel_tpu_dense_prefill(q,
+                                                          k,
+                                                          v,
+                                                          cache,
+                                                          jnp.zeros((3, 8),
+                                                                    jnp.int32),
+                                                          jnp.zeros((1, ),
+                                                                    jnp.int32),
+                                                          batch_size=2,
+                                                          seq_len=3,
+                                                          sm_scale=0.5)
+
+        # Note (david): the unfold is the exact inverse of the fold, so an
+        # identity kernel hands q back in the runner's [T, N, D] layout.
+        assert output.shape == (6, 4, 8)
+        np.testing.assert_array_equal(output, q)
+        assert updated is cache
+        assert seen["token_major"] is False
+        assert seen["heads_outer_fold"] is True
+        assert "head_dim" not in seen
+        assert not {"rotary_cos", "rotary_sin", "rotary_k"} & set(seen)
+
+    def test_fused_q_rope_tables_match_apply_rope(self, monkeypatch):
+        seq_len, head_dim = 16, 128
+        q = jnp.zeros((2 * seq_len, 4, head_dim), jnp.bfloat16)
+        k = jnp.zeros((2 * seq_len, 2, head_dim), jnp.bfloat16)
+        cache = jnp.zeros((4, 128, 4, head_dim), jnp.bfloat16)
+        seen = {}
+
+        def _fake_flywheel(q_in, k_in, v_in, **kwargs):
+            seen.update(kwargs)
+            return q_in
+
+        monkeypatch.setattr(fa, "flash_attn_func", _fake_flywheel)
+        monkeypatch.setattr(fa, "write_kv_cache", lambda *args: args[2])
+        fa.flywheel_tpu_dense_prefill(q,
+                                        k,
+                                        k,
+                                        cache,
+                                        jnp.zeros((3, 8), jnp.int32),
+                                        jnp.zeros((1, ), jnp.int32),
+                                        batch_size=2,
+                                        seq_len=seq_len,
+                                        sm_scale=0.5,
+                                        fused_q_rope_theta=ROPE_THETA)
+
+        assert seen["rotary_k"] is False
+        assert seen["rotary_interleaved"] is False
+        cos, sin = seen["rotary_cos"], seen["rotary_sin"]
+        assert cos.shape == sin.shape == (seq_len, head_dim // 2)
+        assert cos.dtype == sin.dtype == jnp.float32
+        # Note (david): the kernel rotates in f32 with split halves, so the
+        # tables have to reproduce apply_rope bit for bit at positions
+        # 0..seq_len - 1 or the cached K and the rotated Q disagree.
+        x = jnp.asarray(
+            np.random.default_rng(0).standard_normal((seq_len, 3, head_dim),
+                                                     dtype=np.float32))
+        half = head_dim // 2
+        first, second = x[..., :half], x[..., half:]
+        cos_row, sin_row = cos[:, None, :], sin[:, None, :]
+        rotated = jnp.concatenate([
+            first * cos_row - second * sin_row,
+            second * cos_row + first * sin_row
+        ],
+                                  axis=-1)
+        expected = apply_rope(x, jnp.arange(seq_len, dtype=jnp.int32),
+                              head_dim, ROPE_THETA)
+        np.testing.assert_array_equal(np.asarray(rotated),
+                                      np.asarray(expected))
+
