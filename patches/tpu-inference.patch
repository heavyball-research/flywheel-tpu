+def test_mixed_batch_requires_leading_one_token_decodes():
+    # Note (david): a mixed step hands the leading num_decode rows to the
+    # decode kernel, so a batch whose prefix is not one query per request has
+    # to fail here instead of attending the wrong rows.
+    with pytest.raises(ValueError, match="decode requests first"):
+        fa.select_attention_phase(1, np.array([0, 4, 5]), np.array([4, 5]))
