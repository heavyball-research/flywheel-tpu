@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import copy
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from tpu_inference.core import core_tpu
+
+
+def make_config(pcp_size):
+    return SimpleNamespace(model_config=SimpleNamespace(dtype="bfloat16"),
+                           cache_config=SimpleNamespace(block_size=128,
+                                                        cache_dtype="auto"),
+                           scheduler_config=SimpleNamespace(max_num_seqs=1),
+                           sharding_config=SimpleNamespace(
+                               tp_size=2,
+                               prefill_cp_size=pcp_size,
+                               decode_cp_size=1,
+                               expert_size=1,
+                               model_dp_size=1,
+                               attn_dp_size=1,
+                               attn_dp_expert_size=1))
+
+
+@pytest.fixture
+def create_orchestrator(monkeypatch):
+    monkeypatch.setenv("USE_FLYWHEEL_TPU_KERNEL", "1")
+    monkeypatch.setattr(core_tpu, "JetThread", MagicMock())
+    monkeypatch.setattr(core_tpu.common_utils, "hbm_usage_bytes", lambda _: [])
+
+    def create(config, decode_config):
+        prefill, decode = MagicMock(), MagicMock()
+        prefill.model_executor.driver_worker.model_runner.vllm_config = config
+        decode.model_executor.driver_worker.model_runner.vllm_config = decode_config
+        return core_tpu._DisaggOrchestrator(config, MagicMock(), [prefill],
+                                            [decode], (4, ), (4, ))
+
+    return create
+
+
+@pytest.mark.parametrize("pcp_size", [1, 2, 4, 8])
+def test_matching_flywheel_pd_config_accepts_pcp(create_orchestrator, pcp_size):
+    config = make_config(pcp_size)
+    orchestrator = create_orchestrator(config, copy.deepcopy(config))
+    assert orchestrator._kv_block_size == 128 * pcp_size
+
+
+@pytest.mark.parametrize("field,value", [("tp_size", 4),
+                                         ("prefill_cp_size", 2)])
+def test_internal_pd_rejects_incompatible_mesh(create_orchestrator, field,
+                                               value):
+    config = make_config(4)
+    decode_config = copy.deepcopy(config)
+    setattr(decode_config.sharding_config, field, value)
+    with pytest.raises(ValueError, match="Incompatible FlyWheel PD"):
+        create_orchestrator(config, decode_config)
diff --git a/tests/core/test_tpu_pcp_scheduler_patch.py b/tests/core/test_tpu_pcp_scheduler_patch.py
