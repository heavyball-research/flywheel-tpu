+# SPDX-License-Identifier: Apache-2.0
+"""Cached-prefix dispatch and paged extend numerics, mixed batches included."""
+
+import functools
+from collections.abc import Callable
+from types import SimpleNamespace
+from typing import NamedTuple
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+
+from tpu_inference.layers.common import flywheel_tpu_attention as fa
+
+PAGE_SIZE, PAGES_PER_SEQ = 128, 3
+HEAD_DIM, QUERY_HEADS = 128, 4
+SM_SCALE = HEAD_DIM**-0.5
+FRESH_TOKENS = 256
+
+# Note (david): narrower than the longest request of these fixtures on
+# purpose: every sequence then spans several q blocks, so the kernel's
+# sequence-boundary blend has to hold, a block starting on the align8 grid
+# reaching back into the previous sequence's rows.
+VARLEN_BLOCK_SPAN = 128
+
+# Note (david): the kernels run in bf16 against an f32 numpy reference, so the
+# slack covers accumulation order rather than correctness.
+BF16_TOLERANCE = 0.035
+
+
+class StepBatch(NamedTuple):
+    """One serving step: its token buffer, its pages and its host metadata."""
+    q: jax.Array
+    k: jax.Array
+    v: jax.Array
+    kv_cache: jax.Array
+    block_table: np.ndarray
+    cu_q_lens: np.ndarray
+    kv_lens: np.ndarray
+    num_reqs: int
+
+
+# Note (david): PREFILL is fresh prefill requests alone; a decode row or a
+# request whose keys are partly in the pages sends the step to extend.
+@pytest.mark.parametrize(("cu_q_lens", "kv_lens", "num_decode", "expected"), [
+    pytest.param(
+        [0, 128, 256], [128, 128], 0, fa.PREFILL_PHASE, id="fresh_prompts"),
+    pytest.param(
+        [0, 128, 256], [256, 128], 0, fa.EXTEND_PHASE, id="cached_prefix"),
+    pytest.param([0, 1, 2], [257, 129], 2, fa.DECODE_PHASE, id="decode_only"),
+    pytest.param([0], [], 0, fa.PREFILL_PHASE, id="empty_step"),
+    pytest.param([0, 1, 18], [257, 145],
+                 1,
+                 fa.EXTEND_PHASE,
+                 id="decode_plus_cached_chunk"),
+    pytest.param([0, 1, 18], [257, 17],
+                 1,
+                 fa.EXTEND_PHASE,
+                 id="decode_plus_fresh_chunk"),
+    pytest.param([0, 1, 2, 130, 195], [257, 129, 128, 65],
+                 2,
+                 fa.EXTEND_PHASE,
+                 id="decodes_plus_fresh_prompts"),
+    pytest.param([0, 1, 2, 130, 195], [257, 129, 128, 300],
+                 2,
+                 fa.EXTEND_PHASE,
+                 id="decodes_plus_one_cached_prompt"),
+])
+def test_host_phase_uses_cached_lengths(cu_q_lens, kv_lens, num_decode,
+                                        expected):
+    assert fa.select_attention_phase(num_decode, np.asarray(cu_q_lens),
+                                     np.asarray(kv_lens)) == expected
+
