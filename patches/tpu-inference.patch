+def test_split_calls_the_decode_kernel_without_appending(monkeypatch):
+    """The decode rows read the tokens the writer already put in the pages,
+    and their padding rows never overwrite the chunk's own leading tokens."""
+    num_decode, chunk = 3, 20
+    batch = chunked_prefill_batch(2, num_decode, chunk, 137)
+    seen = {}
+
+    def _merged_kvcache(q_rows,
+                        kv_cache,
+                        v_cache,
+                        k_rows=None,
+                        v_rows=None,
+                        *,
+                        cache_seqlens,
+                        block_table,
+                        num_active,
+                        softmax_scale,
+                        cu_seqlens_q=None,
+                        causal=False):
+        # Note (david): only the decode rows reach flash_attn_with_kvcache,
+        # with the paged merged cache as the one k_cache operand.
+        assert v_cache is None and cu_seqlens_q is None and not causal
+        seen.update(k=k_rows,
+                    v=v_rows,
+                    rows=q_rows.shape[0],
+                    cache_seqlens=np.asarray(cache_seqlens),
+                    num_active=int(num_active))
+        return jnp.full(q_rows.shape, 7, q_rows.dtype), kv_cache
+
+    def _paged_varlen(q_heads, k_cache, v_cache, cu_seqlens_q, cu_seqlens_k, *,
+                      max_seqlen_q, max_seqlen_k, softmax_scale, causal,
+                      token_major, block_table, seqused_k, num_active):
+        assert q_heads.shape == (QUERY_HEADS, batch.q.shape[0], HEAD_DIM)
+        assert k_cache.shape == batch.kv_cache.shape
+        assert v_cache is None and cu_seqlens_k is None
+        assert token_major is False and softmax_scale == SM_SCALE
+        seen.update(cu_q_lens=np.asarray(cu_seqlens_q),
+                    kv_lens=np.asarray(seqused_k),
+                    block_table=np.asarray(block_table),
+                    varlen_num_active=int(num_active),
+                    varlen_causal=causal,
+                    max_seqlens=(max_seqlen_q, max_seqlen_k))
+        return jnp.full(q_heads.shape, 3, q_heads.dtype)
+
+    monkeypatch.setattr(fa, "write_kv_cache", lambda k, v, c, *args: c)
+    monkeypatch.setattr(fa, "flash_attn_with_kvcache", _merged_kvcache)
+    monkeypatch.setattr(fa, "flash_attn_varlen_func", _paged_varlen)
+    out, _ = fa.flywheel_tpu_attention(
+        batch.q,
+        batch.k,
+        batch.v,
+        batch.kv_cache,
+        jnp.asarray(batch.kv_lens),
+        jnp.asarray(batch.block_table.ravel()),
+        jnp.asarray(batch.cu_q_lens),
+        jnp.zeros(3, jnp.int32),
+        jnp.array([0]),
+        jnp.array([num_decode, num_decode, batch.num_reqs]),
+        phase=fa.EXTEND_PHASE,
+        sm_scale=SM_SCALE)
+    # Note (david): the DMA writer owns the append, so the decode kernel gets
+    # no K/V and takes the FULL kv_len, every row attending [0, kv_len).
+    assert seen["k"] is None and seen["v"] is None
+    np.testing.assert_array_equal(seen["cache_seqlens"],
+                                  batch.kv_lens[:seen["rows"]])
+    assert seen["num_active"] == num_decode
+    # Note (david): the prefill kernel's request window starts at the first
+    # prefill request, so its metadata is the tail of the step's and its cu
+    # values stay absolute offsets into q.
+    assert seen["varlen_num_active"] == batch.num_reqs - num_decode
+    assert seen["varlen_causal"]
+    num_slots = batch.kv_lens.size
+    np.testing.assert_array_equal(
+        seen["cu_q_lens"][:num_slots + 1 - num_decode],
+        batch.cu_q_lens[num_decode:])
+    np.testing.assert_array_equal(seen["kv_lens"][:num_slots - num_decode],
+                                  batch.kv_lens[num_decode:])
+    np.testing.assert_array_equal(
+        seen["block_table"].reshape(
+            num_slots, -1)[:num_slots - num_decode, :PAGES_PER_SEQ],
+        batch.block_table[num_decode:])
+    assert seen["block_table"].shape == (num_slots, PAGES_PER_SEQ)
+    assert seen["max_seqlens"] == (batch.q.shape[0], PAGES_PER_SEQ * PAGE_SIZE)
+    out = np.asarray(out)
+    np.testing.assert_array_equal(out[:num_decode], 7)
+    # Note (david): rows at or past num_decode are decode-kernel padding; here
+    # they are the chunk's own first tokens and stay with the prefill kernel.
+    assert seen["rows"] > num_decode
+    np.testing.assert_array_equal(out[num_decode:], 3)
