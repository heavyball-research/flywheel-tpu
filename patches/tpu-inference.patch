+@pytest.mark.parametrize("phase", [fa.DECODE_PHASE, fa.EXTEND_PHASE])
+@pytest.mark.parametrize(
+    "head_dim", [d for d in HEAD_DIMS if d not in fa.DECODE_HEAD_DIMS])
+def test_decode_rejects_padded_head_dim(phase, head_dim):
+    q = jnp.zeros((8, QUERY_HEADS, head_dim), jnp.bfloat16)
+    kv = jnp.zeros((8, 2, head_dim), jnp.bfloat16)
+    lens = jnp.zeros((2, ), jnp.int32)
+    with pytest.raises(NotImplementedError, match="decodes only head_dim"):
+        fa.flywheel_tpu_attention(q,
+                                  kv,
+                                  kv,
+                                  jnp.zeros((4, PAGE_SIZE, 4, 128),
+                                            jnp.bfloat16),
+                                  lens,
+                                  jnp.zeros((4, ), jnp.int32),
+                                  jnp.zeros((3, ), jnp.int32),
+                                  jnp.zeros((3, ), jnp.int32),
+                                  jnp.zeros((1, ), jnp.int32),
+                                  jnp.zeros((3, ), jnp.int32),
+                                  phase=phase,
+                                  sm_scale=head_dim**-0.5)
+
+
+@pytest.mark.parametrize("kv_heads", [1, 2])
+@pytest.mark.parametrize("mode,head_dim", PADDED_HEAD_DIM_CASES)
+def test_padded_head_dim_numerics(monkeypatch, head_dim, kv_heads, mode):
+    rng = np.random.default_rng(42)
+    is_dense = mode == "dense"
+
+    def values(shape):
+        return jnp.asarray(rng.normal(size=shape), jnp.bfloat16)
+
+    query_lengths = [1, 1] if mode == "decode" else [8, 8]
+    kv_lengths = ([129, 137] if mode in ("decode",
+                                         "extend") else query_lengths)
+    num_tokens = sum(query_lengths) if is_dense else 128
+    cache = values((4, PAGE_SIZE, 2 * kv_heads, head_dim))
+    batch = StepBatch(
+        q=values((num_tokens, QUERY_HEADS, head_dim)),
+        k=values((num_tokens, kv_heads, head_dim)),
+        v=values((num_tokens, kv_heads, head_dim)),
+        kv_cache=cache,
+        block_table=np.array([[2, 0], [3, 1]], np.int32),
+        cu_q_lens=np.array(
+            [0, query_lengths[0], sum(query_lengths)], np.int32),
+        kv_lens=np.array(kv_lengths, np.int32),
+        num_reqs=2,
+    )
+    expected, expected_cache = reference_attention(batch)
+    slices, count = build_slice_table(batch)
+    padded_dim = 128 if head_dim <= 128 else 256
+    cache_padding = [(0, 0)] * (cache.ndim - 1) + [(0, padded_dim - head_dim)]
+    cache = jnp.pad(cache, cache_padding)
+    patch_kernels(monkeypatch)
+    if jax.default_backend() != "tpu":
+        monkeypatch.setattr(fa, "write_kv_cache", slice_table_writer([]))
+    phase = (fa.DECODE_PHASE if mode == "decode" else
+             fa.EXTEND_PHASE if mode == "extend" else fa.PREFILL_PHASE)
+    run = fa.flywheel_tpu_attention
+    if jax.default_backend() == "tpu":
+        run = jax.jit(run,
+                      static_argnames=("phase", "sm_scale",
+                                       "varlen_block_span", "dense_batch_size",
+                                       "dense_seq_len", "fused_q_rope_theta"),
+                      donate_argnums=(3, ))
+        cache_pointer = cache.unsafe_buffer_pointer()
+    out, updated = run(
+        batch.q,
+        batch.k,
+        batch.v,
+        cache,
+        jnp.asarray(batch.kv_lens),
+        jnp.asarray(batch.block_table.ravel()),
+        jnp.asarray(batch.cu_q_lens),
+        jnp.asarray(slices.ravel()),
+        jnp.array([count]),
+        jnp.array([2, 2, 2] if mode == "decode" else [0, 0, 2]),
+        phase=phase,
+        sm_scale=head_dim**-0.5,
+        varlen_block_span=128,
+        dense_batch_size=2 if is_dense else -1,
+        dense_seq_len=8 if is_dense else -1,
+    )
+    assert out.shape == batch.q.shape
+    if jax.default_backend() == "tpu":
+        assert updated.unsafe_buffer_pointer() == cache_pointer
+    np.testing.assert_allclose(out[:sum(query_lengths)].astype(jnp.float32),
+                               expected[:sum(query_lengths)],
+                               atol=BF16_TOLERANCE,
+                               rtol=BF16_TOLERANCE)
+    np.testing.assert_array_equal(updated[..., :head_dim], expected_cache)
+    np.testing.assert_array_equal(updated[..., head_dim:], 0)
