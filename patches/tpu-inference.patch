+def fresh_prefill_batch(kv_heads: int, num_decode: int,
+                        chunks: tuple[int, ...]) -> StepBatch:
+    """A whole-prompt prefill step: num_decode one-token requests on long
+    cached contexts first, then one fresh request per entry of chunks, then an
+    unused request slot."""
+    rng = np.random.default_rng(23)
+
+    def _values(shape):
+        return jnp.asarray(rng.normal(size=shape), jnp.bfloat16)
+
+    num_reqs = num_decode + len(chunks)
+    num_slots = num_reqs + 1
+    num_pages = num_slots * PAGES_PER_SEQ
+    q = _values((FRESH_TOKENS, QUERY_HEADS, HEAD_DIM))
+    k, v = (_values((FRESH_TOKENS, kv_heads, HEAD_DIM)) for _ in range(2))
+    cache = _values((num_pages, PAGE_SIZE, 2 * kv_heads, HEAD_DIM))
+    # Note (david): each request owns its own pages, so no writer can disturb
+    # another request's prefix.
+    table = np.arange(num_pages,
+                      dtype=np.int32).reshape(num_slots, PAGES_PER_SEQ)
+    lengths = np.zeros(num_slots, np.int32)
+    # Note (david): staggered decode lengths long enough to span every page
+    # the slot owns, so a row reading another row's length shows up.
+    lengths[:num_decode] = 300 + np.arange(num_decode)
+    lengths[num_decode:num_reqs] = chunks
+    cu_q_lens = np.zeros(num_slots + 1, np.int32)
+    cu_q_lens[1:num_reqs + 1] = np.cumsum([1] * num_decode + list(chunks))
+    cu_q_lens[num_reqs + 1:] = cu_q_lens[num_reqs]
+    if (lengths.max() > PAGES_PER_SEQ * PAGE_SIZE
+            or cu_q_lens[num_reqs] > FRESH_TOKENS):
+        raise ValueError("the fixture's pages or token buffer are too small.")
+    return StepBatch(q=q,
+                     k=k,
+                     v=v,
+                     kv_cache=cache,
+                     block_table=table,
+                     cu_q_lens=cu_q_lens,
+                     kv_lens=lengths,
+                     num_reqs=num_reqs)
+
+
