@@ -0,0 +1,144 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Ling-3.0 KDA projections and state-cache bridge for TPU."""
+
+import jax.numpy as jnp
+import torch
+from torchax.interop import jax_view, torch_view
+from vllm.forward_context import get_forward_context
+from vllm.model_executor.layers.mamba.mamba_utils import \
+    is_conv_state_dim_first
+from vllm.model_executor.models.bailing_moe_v3 import \
+    BailingMoeV3KimiDeltaAttention
+
+from tpu_inference import envs
+from tpu_inference.layers.common.kda_attention import run_jax_kda_attention
+from tpu_inference.layers.common.linear_attention import \
+    get_linear_attention_metadata
+from tpu_inference.layers.common.sharding import ShardingAxisName
+from tpu_inference.layers.common.utils import \
+    reorder_concatenated_tensor_for_sharding
+from tpu_inference.models.vllm.vllm_model_wrapper_context import \
+    get_vllm_model_wrapper_context
+from tpu_inference.utils import get_mesh_shape_product
+
+
+def kda_attention_core_tpu(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    raw_gate: torch.Tensor,
+    beta_logits: torch.Tensor,
+    output: torch.Tensor,
+    layer_name: str,
+) -> None:
+    """Run the fused KDA kernel for one layer and rebind its state cache."""
+    vllm_context = get_vllm_model_wrapper_context()
+    forward_context = get_forward_context()
+    if isinstance(forward_context.attn_metadata, dict):
+        # Note (david): a hybrid model builds one KV cache group per layer
+        # type, so its forward context carries a per-layer metadata map.
+        metadata = forward_context.attn_metadata[layer_name]
+    else:
+        metadata = forward_context.attn_metadata
+    layer = forward_context.no_compile_layers[layer_name]
+    mesh = vllm_context.mesh
+    tp_size = get_mesh_shape_product(mesh, ShardingAxisName.ATTN_HEAD)
+    dp_size = get_mesh_shape_product(mesh, ShardingAxisName.ATTN_DATA)
+    num_heads = layer.num_heads
+    head_dim = layer.head_dim
+    kernel_size = layer.conv_size
+    if num_heads % tp_size != 0:
+        raise ValueError(f"KDA head count {num_heads} must be divisible by "
+                         f"TP size {tp_size}")
+    projection_dim = num_heads * head_dim
+    split_sizes = [projection_dim] * 3
+    qkv = reorder_concatenated_tensor_for_sharding(
+        jnp.concatenate((jax_view(q), jax_view(k), jax_view(v)), axis=-1),
+        split_sizes, tp_size, -1)
+    conv_weights = [
+        jax_view(conv.weight)
+        for conv in (layer.q_conv1d, layer.k_conv1d, layer.v_conv1d)
+    ]
+    assert all(weight.shape == (projection_dim, 1, kernel_size)
+               for weight in conv_weights)
+    conv_weight = reorder_concatenated_tensor_for_sharding(
+        jnp.concatenate(conv_weights, axis=0), split_sizes, tp_size, 0)
+    (query_start_loc, seq_lens, distribution, write_state_indices,
+     read_state_indices) = get_linear_attention_metadata(
+         metadata, vllm_context.vllm_config.cache_config, dp_size)
+    cache_index = vllm_context.layer_name_to_kvcache_index[layer_name]
+    conv_state, recurrent_state = vllm_context.kv_caches[cache_index]
+    assert conv_state.shape[1:] == (kernel_size - 1, 3 * projection_dim)
+    new_states, attn_out = run_jax_kda_attention(
+        j_mixed_qkv=qkv,
+        j_b=jax_view(beta_logits),
+        j_gate=jax_view(raw_gate),
+        conv_state=conv_state,
+        recurrent_state=recurrent_state,
+        j_conv_weight=conv_weight,
+        j_conv_bias=None,
+        j_A_log=jax_view(layer.A_log).reshape(num_heads),
+        j_dt_bias=jax_view(layer.dt_bias).reshape(projection_dim),
+        state_indices=write_state_indices,
+        read_state_indices=read_state_indices,
+        query_start_loc=query_start_loc,
+        distribution=distribution,
+        seq_lens=seq_lens,
+        n_kq=num_heads,
+        n_v=num_heads,
+        d_k=head_dim,
+        d_v=head_dim,
+        kernel_size=kernel_size,
+        mesh=mesh,
+        lower_bound=layer.lower_bound if layer.safe_gate else None,
+        beta_is_activated=False,
+    )
+    vllm_context.kv_caches[cache_index] = new_states
+    output.copy_(torch_view(attn_out.reshape(output.shape)))
+
+
+@BailingMoeV3KimiDeltaAttention.register_oot
+class VllmKimiDeltaAttention(BailingMoeV3KimiDeltaAttention):
+
+    def __init__(self, *args, **kwargs) -> None:
+        if not envs.USE_FLYWHEEL_TPU_LINEAR_KERNEL:
+            raise ValueError(
+                "Ling KDA on TPU requires USE_FLYWHEEL_TPU_LINEAR_KERNEL=1")
+        if is_conv_state_dim_first():
+            raise ValueError(
+                "Ling KDA on TPU requires sequence-major convolution states")
+        super().__init__(*args, **kwargs)
+        if self.num_speculative_tokens:
+            raise NotImplementedError(
+                "Ling KDA on TPU does not yet support speculative decoding")
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        positions: torch.Tensor,
+        output: torch.Tensor,
