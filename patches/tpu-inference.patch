+def test_ragged_prefill_runs_the_varlen_kernel_alone(monkeypatch):
+    """The PREFILL phase never runs a decode kernel: the ragged kernel gets
+    the step's own cu_seqlens and its output comes back untouched."""
+    batch = fresh_prefill_batch(2, 0, (137, 60))
+    seen = {}
+
+    def _no_decode_kernel(*args, **kwargs):
+        raise AssertionError("the PREFILL phase must not run a decode kernel")
+
+    def _varlen_kernel(q_in, k_in, v_in, cu_q, cu_k, **kwargs):
+        seen.update(cu_q=np.asarray(cu_q),
+                    cu_k=np.asarray(cu_k),
+                    max_seqlen_q=kwargs["max_seqlen_q"])
+        return jnp.full(q_in.shape, 3, q_in.dtype)
+
+    monkeypatch.setattr(fa, "write_kv_cache", lambda k, v, c, *args: c)
+    monkeypatch.setattr(fa, "flash_attn_varlen_func", _varlen_kernel)
+    monkeypatch.setattr(fa, "flash_attn_with_kvcache", _no_decode_kernel)
+    out, _ = fa.flywheel_tpu_attention(batch.q,
+                                         batch.k,
+                                         batch.v,
+                                         batch.kv_cache,
+                                         jnp.asarray(batch.kv_lens),
+                                         jnp.asarray(
+                                             batch.block_table.ravel()),
+                                         jnp.asarray(batch.cu_q_lens),
+                                         jnp.zeros(3, jnp.int32),
+                                         jnp.array([0]),
+                                         jnp.array([0, 0, batch.num_reqs]),
+                                         phase=fa.PREFILL_PHASE,
+                                         sm_scale=SM_SCALE,
+                                         varlen_block_span=VARLEN_BLOCK_SPAN)
+    # Note (david): one sequence per request at its real q offsets, then the
+    # zero-length tail the padded request slots already were.
+    np.testing.assert_array_equal(seen["cu_q"], batch.cu_q_lens)
+    np.testing.assert_array_equal(seen["cu_k"], batch.cu_q_lens)
+    assert seen["max_seqlen_q"] == VARLEN_BLOCK_SPAN
+    # Note (david): no row is written back into the kernel's output, which
