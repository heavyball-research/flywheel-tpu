+    def test_set_is_bounded_by_the_bucket_ladder(self):
+        # Note (david): each shape compiles its own backbone executable, so
+        # one bucket may reach at most log2(bucket / DENSE_MIN_SEQ_LEN) + 1.
+        bucket = 8192
+        shapes = {
+            fa.dense_prefill_shape([[seq] * (bucket // seq)], bucket)
+            for seq in range(1, bucket + 1) if bucket % seq == 0
+        } - {(-1, -1)}
+        assert len(shapes) == 7
+        assert shapes == {(bucket // s, s)
+                          for s in (128, 256, 512, 1024, 2048, 4096, 8192)}
