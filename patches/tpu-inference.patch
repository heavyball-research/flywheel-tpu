index 000000000..709e3acc3
--- /dev/null
+++ b/tests/core/test_tpu_pcp_scheduler_patch.py
@@ -0,0 +1,166 @@
+import inspect
+import os
+import subprocess
+import sys
+from types import SimpleNamespace
+
+import vllm.v1.core.sched.scheduler as scheduler_module
+import vllm.platforms
+
+from tpu_inference.core.sched.utils import patch_vllm_scheduler_for_tpu_pcp
+
+
+class FakeScheduler:
+
+    def __init__(self, vllm_config):
+        parallel = vllm_config.parallel_config
+        self.seen_dcp = parallel.decode_context_parallel_size
+        self.seen_pcp = parallel.prefill_context_parallel_size
+        raw_block_size = 128
+        self.allocated_blocks = -(-1025 // (raw_block_size * self.seen_dcp))
+        self.dcp_world_size = self.seen_dcp
+        self.pcp_world_size = self.seen_pcp
+
+
+ORIGINAL_FAKE_INIT = FakeScheduler.__init__
+
+
+def _reset_fake_scheduler(monkeypatch):
+    monkeypatch.setattr(FakeScheduler, "__init__", ORIGINAL_FAKE_INIT)
+    monkeypatch.delattr(FakeScheduler,
+                        "_tpu_pcp_cache_accounting_patched",
+                        raising=False)
+    monkeypatch.setattr(scheduler_module, "Scheduler", FakeScheduler)
+
+
+def _enable_tpu_new_model_design(monkeypatch):
+    platform = SimpleNamespace(is_tpu=lambda: True)
+    monkeypatch.setattr(vllm.platforms, "current_platform", platform)
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "1")
+
+
+def _config(dcp, pcp):
+    return SimpleNamespace(parallel_config=SimpleNamespace(
+        decode_context_parallel_size=dcp,
+        prefill_context_parallel_size=pcp,
+    ))
+
+
+def test_pcp_scheduler_uses_effective_context_size_and_restores_config(
+        monkeypatch):
+    _reset_fake_scheduler(monkeypatch)
+    _enable_tpu_new_model_design(monkeypatch)
+    patch_vllm_scheduler_for_tpu_pcp()
+    config = _config(dcp=1, pcp=2)
+    scheduler = FakeScheduler(config)
+    assert (scheduler.seen_dcp, scheduler.seen_pcp) == (2, 1)
+    assert scheduler.allocated_blocks == 5
+    assert (scheduler.dcp_world_size, scheduler.pcp_world_size) == (1, 2)
+    assert (config.parallel_config.decode_context_parallel_size,
+            config.parallel_config.prefill_context_parallel_size) == (1, 2)
+
+
+def test_pcp1_scheduler_path_is_unchanged(monkeypatch):
+    _reset_fake_scheduler(monkeypatch)
+    _enable_tpu_new_model_design(monkeypatch)
+    original = FakeScheduler.__init__
+    patch_vllm_scheduler_for_tpu_pcp()
+    config = _config(dcp=1, pcp=1)
+    scheduler = FakeScheduler(config)
+    assert scheduler.seen_dcp == scheduler.seen_pcp == 1
+    assert scheduler.allocated_blocks == 9
+    assert config.parallel_config.prefill_context_parallel_size == 1
+    assert FakeScheduler.__init__ is not original
+
+
+def test_scheduler_patch_is_idempotent(monkeypatch):
+    _reset_fake_scheduler(monkeypatch)
+    _enable_tpu_new_model_design(monkeypatch)
+    patch_vllm_scheduler_for_tpu_pcp()
+    installed = FakeScheduler.__init__
+    patch_vllm_scheduler_for_tpu_pcp()
+    assert FakeScheduler.__init__ is installed
+
+
+def test_scheduler_patch_preserves_constructor_signature(monkeypatch):
+    _reset_fake_scheduler(monkeypatch)
+    original_signature = inspect.signature(FakeScheduler)
+    patch_vllm_scheduler_for_tpu_pcp()
+    assert inspect.signature(FakeScheduler) == original_signature
+
+
+def test_installed_patch_preserves_non_tpu_scheduler(monkeypatch):
+    _reset_fake_scheduler(monkeypatch)
+    _enable_tpu_new_model_design(monkeypatch)
+    patch_vllm_scheduler_for_tpu_pcp()
+    monkeypatch.setattr(vllm.platforms, "current_platform",
+                        SimpleNamespace(is_tpu=lambda: False))
+    scheduler = FakeScheduler(_config(dcp=1, pcp=2))
+    assert (scheduler.seen_dcp, scheduler.seen_pcp) == (1, 2)
+    assert scheduler.allocated_blocks == 9
+
+
+def test_installed_patch_preserves_legacy_design_scheduler(monkeypatch):
+    _reset_fake_scheduler(monkeypatch)
+    _enable_tpu_new_model_design(monkeypatch)
+    patch_vllm_scheduler_for_tpu_pcp()
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "0")
+    scheduler = FakeScheduler(_config(dcp=1, pcp=2))
+    assert (scheduler.seen_dcp, scheduler.seen_pcp) == (1, 2)
+    assert scheduler.allocated_blocks == 9
+
+
+def test_scheduler_config_is_restored_when_constructor_raises(monkeypatch):
+
+    class RaisingScheduler:
+
+        def __init__(self, vllm_config):
+            assert vllm_config.parallel_config.decode_context_parallel_size == 2
+            assert vllm_config.parallel_config.prefill_context_parallel_size == 1
+            raise RuntimeError("constructor failed")
+
+    monkeypatch.setattr(scheduler_module, "Scheduler", RaisingScheduler)
+    _enable_tpu_new_model_design(monkeypatch)
+    patch_vllm_scheduler_for_tpu_pcp()
+    config = _config(dcp=1, pcp=2)
+    try:
+        RaisingScheduler(config)
+    except RuntimeError as error:
+        assert str(error) == "constructor failed"
+    else:
+        raise AssertionError("constructor must fail")
+    assert (config.parallel_config.decode_context_parallel_size,
+            config.parallel_config.prefill_context_parallel_size) == (1, 2)
+
+
+def test_general_plugin_installs_pcp_accounting_in_current_process(
+        monkeypatch):
+    from tpu_inference.layers.vllm import register_layers
+    from tpu_inference.models.vllm import experimental
+
+    _reset_fake_scheduler(monkeypatch)
+    _enable_tpu_new_model_design(monkeypatch)
+    monkeypatch.setattr(experimental, "register_models", lambda: None)
+    register_layers()
+    scheduler = FakeScheduler(_config(dcp=1, pcp=2))
+    assert (scheduler.seen_dcp, scheduler.seen_pcp) == (2, 1)
+    assert scheduler.allocated_blocks == 5
+
+
+def test_general_plugin_installs_pcp_accounting_in_fresh_process():
+    code = """
+from vllm.plugins import load_general_plugins
+from vllm.v1.core.sched.scheduler import Scheduler
+load_general_plugins()
+assert getattr(Scheduler, '_tpu_pcp_cache_accounting_patched', False)
+"""
+    environment = dict(os.environ,
+                       JAX_PLATFORMS="cpu",
+                       NEW_MODEL_DESIGN="1",
+                       VLLM_PLUGINS="register_layers")
+    result = subprocess.run([sys.executable, "-c", code],
+                            env=environment,
+                            capture_output=True,
+                            text=True,
+                            timeout=120)
+    assert result.returncode == 0, result.stdout + result.stderr
