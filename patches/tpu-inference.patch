+
+
+def test_precompile_select_helper_records_sparse_static_keyword():
+    manager = object.__new__(CompilationManager)
+    manager.runner = type("Runner", (), {
+        "mesh": "mesh",
+        "rank": 0,
+        "_select_from_array_fn": "select_fn",
+        "vllm_config": type("Config", (), {
+            "sharding_config": type("Sharding", (), {"prefill_cp_size": 2})()
+        })(),
+    })()
+    manager._run_compilation = MagicMock()
+    manager._precompile_select_from_array_helper(
+        "sparse", [16], [8], 7, pcp_sparse_gather=True)
+    assert manager._run_compilation.call_args.kwargs["call_kwargs"] == {
+        "pcp_sparse_gather": True
+    }
+    manager._run_compilation.reset_mock()
