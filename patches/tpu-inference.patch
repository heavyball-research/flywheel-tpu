+    def test_narrower_than_a_request_is_allowed(self):
+        # Note (david): the kernel bounds nothing by the span, so the cost
+        # model may pick 512 blocks for a 1000-token request.
+        assert fa.varlen_block_span([[1000, 24]], 1024) == 512
+
+    def test_the_pad_tail_widens_the_span(self):
+        # Note (david): the same eight page-sized requests cost the narrowest
+        # span that covers them when they fill their bucket, and a wider one
+        # once the bucket's unfilled tail -- a trailing sequence of its own in
+        # the kernel -- outweighs them.
+        assert fa.varlen_block_span([[128] * 8], 1024) == 256
+        assert fa.varlen_block_span([[128] * 8], 2048) == 512
+        assert fa.varlen_block_span([[128] * 8], 8192) == 1024
+
+    def test_cost_is_taken_per_dp_rank(self):
+        # Note (david): each rank pads its own copy of the bucket, so the
+        # ranks carry different tails and the step takes the span that suits
+        # the slowest of them, not the one their pooled lengths would ask for.
+        assert fa.varlen_block_span([[4096] * 2], 8192) == 2048
+        assert fa.varlen_block_span([[4096] * 2, [128] * 8], 8192) == 1024
+
+    def test_set_is_the_span_ladder(self):
+        # Note (david): a lone request always carries the rest of its bucket
+        # as one tail sequence, which pushes it to a wide span whatever its
+        # length; the narrow half of the ladder is reached by request COUNT.
+        bucket = 8192
+        values = {
+            fa.varlen_block_span([[bucket // count] * count], bucket)
+            for count in (1, 2, 4, 8, 16, 32, 64)
+        }
+        assert values <= set(fa.VARLEN_BLOCK_SPANS)
+        assert values == {256, 512, 1024, 2048}
+
+    @pytest.mark.parametrize("lengths_per_rank", [[[]], [[0, 0]], [[], []]])
+    def test_rejects_a_step_without_tokens(self, lengths_per_rank):
+        with pytest.raises(ValueError, match="at least one token"):
+            fa.varlen_block_span(lengths_per_rank, 16)
+
+    @pytest.mark.parametrize("lengths_per_rank",
+                             [[[1024, 1024]], [[512], [2048]]])
+    def test_rejects_more_tokens_than_the_bucket(self, lengths_per_rank):
+        # Note (david): the runner pads to a bucket at least as large as the
+        # busiest rank's token count, so an overflow is a caller bug and not
+        # a step whose tail happens to be negative.
+        with pytest.raises(ValueError, match="overflow"):
+            fa.varlen_block_span(lengths_per_rank, 2047)
+
+    @pytest.mark.parametrize(("padded", "expected"), [
+        (16384, (256, 512, 1024, 2048)),
+        (2048, (256, 512, 1024, 2048)),
+        (1024, (256, 512, 1024)),
+        (256, (256, )),
+        (128, (128, )),
+        (48, (48, )),
+    ])
+    def test_reachable_spans_are_the_precompile_set(self, padded, expected):
+        assert fa.varlen_block_spans(padded) == expected
+        picks = {
+            fa.varlen_block_span([[min(longest, padded)]], padded)
+            for longest in (1, 5, 137, 999, 4096, 32768)
+        }
+        picks |= {
+            fa.varlen_block_span([[padded // count] * count], padded)
+            for count in (1, 2, 4, 8, 16, 32, 64) if padded // count
+        }
+        assert picks <= set(expected)
