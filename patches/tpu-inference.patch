+        table = tables[0]
+        block_size = cache_config.mamba_block_size
+        read_column = jnp.maximum(history - 1, 0) // block_size
+        write_column = jnp.maximum(total - 1, 0) // block_size
+        read_state_indices = table[read_column][None].astype(jnp.int32)
