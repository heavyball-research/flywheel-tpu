+@pytest.mark.parametrize("separate_b_proj", [False, True])
+def test_forward_passes_unactivated_gate_and_beta(monkeypatch,
+                                                  separate_b_proj):
+    num_tokens, num_heads, head_dim = 4, 2, 4
+    projection_dim = num_heads * head_dim
+    q = torch.full((num_tokens, projection_dim), 1.0, dtype=torch.bfloat16)
+    k = torch.full((num_tokens, projection_dim), 2.0, dtype=torch.bfloat16)
+    v = torch.full((num_tokens, projection_dim), 3.0, dtype=torch.bfloat16)
+    gate = torch.full((num_tokens, projection_dim), -2.0, dtype=torch.bfloat16)
+    beta = torch.full((num_tokens, num_heads), -3.0, dtype=torch.bfloat16)
+    o_norm = SimpleNamespace(forward_native=Mock(
+        side_effect=lambda output, gate: output))
+    layer = SimpleNamespace(
+        separate_b_proj=separate_b_proj,
+        projection_size_per_partition=projection_dim,
+        local_num_heads=num_heads,
+        head_dim=head_dim,
+        prefix=LAYER_NAME,
+        qkv_proj=Mock(return_value=(torch.cat((q, k, v), -1), None)),
+        b_proj=Mock(return_value=(beta, None)),
+        qkvb_proj=Mock(return_value=(torch.cat((q, k, v, beta), -1), None)),
+        f_proj=Mock(return_value=(gate, None)),
+        g_proj=Mock(return_value=(torch.ones_like(q), None)),
+        o_norm=o_norm,
+        o_proj=Mock(side_effect=lambda value: (value, None)),
+    )
+
+    def _core(q, k, v, raw_gate, beta_logits, output, layer_name):
+        torch.testing.assert_close(raw_gate, gate)
+        torch.testing.assert_close(beta_logits, beta)
+        assert layer_name == LAYER_NAME
+        output.copy_(v.reshape(output.shape))
+
+    monkeypatch.setattr(kda_attention_op, "kda_attention_core_tpu", _core)
+    output = torch.zeros((num_tokens, projection_dim), dtype=torch.bfloat16)
+    kda_attention_op.VllmKimiDeltaAttention.forward(layer, torch.zeros_like(q),
+                                                    torch.arange(num_tokens),
+                                                    output)
+
+    torch.testing.assert_close(output, v)
+    assert o_norm.forward_native.call_count == 1
