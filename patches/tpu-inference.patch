+# limitations under the License.
+"""Per-step device timing of the multimodal encoder and the model forward.
+
+With STEP_TIMING_LOG_PATH set, every engine step that schedules tokens appends
+one JSON line to that file. Each phase ends on a `block_until_ready`, so the
+forward's dispatch no longer overlaps a still-running encoder: this is a
+measurement mode, not a serving one.
+"""
+
+import json
+import time
+from typing import Any, Optional
+
+import jax
+
+_CURRENT: Optional["StepTimer"] = None
+
+
+def current() -> Optional["StepTimer"]:
+    """The runner's timer, for code below the runner that times its own part
+    of a step; None when STEP_TIMING_LOG_PATH is off."""
+    return _CURRENT
+
+
+class StepTimer:
+    """Times the encoder and the forward of one engine step at a time."""
+
+    def __init__(self, path: str):
+        global _CURRENT
+        self._file = open(path, "a", encoding="utf-8")
+        self._started = 0.0
+        self._encoder_done = None
+        self._embeds_done = None
+        self._encoder_inputs = 0
+        self._encoder_output_tokens = 0
+        self._encoder_device_seconds = None
+        _CURRENT = self
+
+    def begin(self) -> None:
+        self._started = time.perf_counter()
+        self._encoder_done = None
+        self._embeds_done = None
+        self._encoder_inputs = 0
+        self._encoder_output_tokens = 0
+        self._encoder_device_seconds = None
+
+    def add_encoder_device(self, seconds: float) -> None:
+        """Adds one compiled encoder call, timed from on-device inputs.
+
+        The rest of the encoder phase is the host side: building the replay
+        buffers and moving them to the device.
+        """
+        self._encoder_device_seconds = (self._encoder_device_seconds
+                                        or 0.0) + seconds
+
+    def encoder_done(self, encoder_outputs: list[jax.Array]) -> None:
+        """Marks the end of the encoder phase once its outputs are on device.
+
+        A step that schedules no encoder input records no encoder time, and
+        its forward is timed from the start of the step.
+        """
+        if not encoder_outputs:
+            return
+        jax.block_until_ready(encoder_outputs)
+        self._encoder_done = time.perf_counter()
+        self._encoder_inputs = len(encoder_outputs)
+        self._encoder_output_tokens = sum(
+            int(output.shape[0]) for output in encoder_outputs)
+
+    def embeds_done(self, model_inputs: jax.Array) -> None:
+        """Marks the end of the input embedding, the multimodal merge included.
+
+        A multimodal model's forward starts from the merged embeddings, a
+        text-only one's from the token ids.
+        """
+        jax.block_until_ready(model_inputs)
+        self._embeds_done = time.perf_counter()
+
+    def forward_done(self, hidden_states: jax.Array, scheduler_output: Any,
+                     padded_num_tokens: int) -> None:
+        if not isinstance(hidden_states, jax.Array):
+            # block_until_ready leaves anything that is not an array alone, so
+            # timing an intermediate-tensor container would read dispatch time.
+            raise TypeError("StepTimer times a last-rank forward that returns "
+                            f"a jax.Array; got {type(hidden_states)}.")
+        jax.block_until_ready(hidden_states)
+        finished = time.perf_counter()
+        embed_started = (self._encoder_done
+                         if self._encoder_done is not None else self._started)
+        record = {
+            "time":
+            time.time(),
+            "num_scheduled_tokens":
+            dict(scheduler_output.num_scheduled_tokens),
+            "total_num_scheduled_tokens":
+            scheduler_output.total_num_scheduled_tokens,
+            "padded_num_tokens":
+            padded_num_tokens,
+            "encoder_inputs":
+            self._encoder_inputs,
+            "encoder_output_tokens":
+            self._encoder_output_tokens,
+            "encoder_s":
+            (self._encoder_done -
+             self._started if self._encoder_done is not None else None),
+            "encoder_device_s":
+            self._encoder_device_seconds,
+            "embed_s":
+            self._embeds_done - embed_started,
+            "llm_forward_s":
+            finished - self._embeds_done,
+        }
+        self._file.write(json.dumps(record) + "\n")
+        self._file.flush()
