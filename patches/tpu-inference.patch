+    select.assert_called_once_with("array",
+                                   "indices",
+                                   "mesh",
+                                   2,
+                                   pcp_sparse_gather=True)
+    select.reset_mock()
+    call_select_from_array(select, "array", "indices", "mesh", 1, False)
