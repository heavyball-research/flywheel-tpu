+# SPDX-License-Identifier: Apache-2.0
+"""Sharded fused KDA for Ling's raw per-key-channel gates."""
+
+import functools
+
+import jax
+
+from flywheel_tpu.linear_attention.kda import wrapper
+from tpu_inference.layers.common.linear_attention import \
+    run_sharded_linear_attention
+
+
+def run_jax_kda_attention(
+    j_mixed_qkv: jax.Array,
+    j_b: jax.Array,
+    j_gate: jax.Array,
+    conv_state: jax.Array,
+    recurrent_state: jax.Array,
+    j_conv_weight: jax.Array,
+    j_conv_bias: jax.Array | None,
+    j_A_log: jax.Array,
+    j_dt_bias: jax.Array,
+    state_indices: jax.Array,
+    query_start_loc: jax.Array,
+    distribution: jax.Array,
+    seq_lens: jax.Array,
+    n_kq: int,
+    n_v: int,
+    d_k: int,
+    d_v: int,
+    kernel_size: int,
+    mesh: jax.sharding.Mesh,
+    read_state_indices: jax.Array | None = None,
+    *,
+    lower_bound: float | None,
+    beta_is_activated: bool,
+) -> tuple[tuple[jax.Array, jax.Array], jax.Array]:
+    """Run KDA on the unactivated gate j_gate of shape [tokens, n_v * d_k].
+
+    lower_bound None decays with -exp(A_log) * softplus, a float clamps the
+    decay to that bound instead. beta_is_activated tells the kernel whether
+    j_b already went through its sigmoid.
+    """
+    kernel = functools.partial(wrapper.fused_conv1d_kda,
+                               lower_bound=lower_bound,
+                               beta_is_activated=beta_is_activated)
+    return run_sharded_linear_attention(
+        kernel, j_mixed_qkv, j_b, j_gate, conv_state, recurrent_state,
+        j_conv_weight, j_conv_bias, j_A_log, j_dt_bias, state_indices,
+        query_start_loc, distribution, seq_lens, n_kq, n_v, d_k, d_v,
+        kernel_size, mesh, read_state_indices)
