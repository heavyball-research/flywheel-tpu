+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+import vllm.config
+import vllm.platforms
+
+from tpu_inference.core.sched import utils as sched_utils
+from tpu_inference.platforms import tpu_platform
+
+
+def _install(monkeypatch, *, is_tpu):
+    class FakeVllmConfig:
+        def __init__(self, pcp_size=2):
+            self.parallel_config = SimpleNamespace(
+                prefill_context_parallel_size=pcp_size)
+
+        def _get_v1_model_runner_unsupported_features(self):
+            return ["prefill context parallel", "another unsupported feature"]
+
+    monkeypatch.setattr(vllm.config, "VllmConfig", FakeVllmConfig)
+    platform = MagicMock()
+    platform.is_tpu.return_value = is_tpu
+    monkeypatch.setattr(vllm.platforms, "current_platform", platform)
+    tpu_platform.TpuPlatform._install_v1_pcp_capability_shim()
+    return FakeVllmConfig
+
+
+def test_tpu_shim_removes_only_pcp_rejection(monkeypatch):
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "1")
+    config_cls = _install(monkeypatch, is_tpu=True)
+    assert config_cls()._get_v1_model_runner_unsupported_features() == [
+        "another unsupported feature"
+    ]
+
+
+def test_tpu_shim_preserves_non_tpu_validation(monkeypatch):
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "1")
+    config_cls = _install(monkeypatch, is_tpu=False)
+    assert config_cls()._get_v1_model_runner_unsupported_features() == [
+        "prefill context parallel", "another unsupported feature"
+    ]
+
+
+def test_tpu_shim_installation_is_idempotent(monkeypatch):
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "1")
+    config_cls = _install(monkeypatch, is_tpu=True)
+    installed = config_cls._get_v1_model_runner_unsupported_features
+    tpu_platform.TpuPlatform._install_v1_pcp_capability_shim()
+    assert config_cls._get_v1_model_runner_unsupported_features is installed
+    assert config_cls()._get_v1_model_runner_unsupported_features() == [
+        "another unsupported feature"
+    ]
+
+
+def test_installed_shim_preserves_pcp_rejection_for_legacy_design(monkeypatch):
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "1")
+    config_cls = _install(monkeypatch, is_tpu=True)
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "0")
+    assert config_cls()._get_v1_model_runner_unsupported_features() == [
+        "prefill context parallel", "another unsupported feature"
+    ]
+
+
+def test_installed_shim_preserves_pcp1_features(monkeypatch):
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "1")
+    config_cls = _install(monkeypatch, is_tpu=True)
+    assert config_cls(
+        pcp_size=1)._get_v1_model_runner_unsupported_features() == [
+            "prefill context parallel", "another unsupported feature"
+        ]
+
+
+def test_real_vllm_config_exposes_expected_capability_getter():
+    assert callable(getattr(
+        vllm.config.VllmConfig,
+        "_get_v1_model_runner_unsupported_features",
+        None,
+    ))
+
+
+def test_missing_upstream_validator_fails_clearly(monkeypatch):
+    monkeypatch.setattr(vllm.config, "VllmConfig", SimpleNamespace)
+    with pytest.raises(RuntimeError, match="is required for TPU PCP"):
+        tpu_platform.TpuPlatform._install_v1_pcp_capability_shim()
+
+
+def test_pcp1_does_not_install_shim(monkeypatch):
+    install = MagicMock()
+    monkeypatch.setattr(tpu_platform.TpuPlatform,
+                        "_install_v1_pcp_capability_shim", install)
+    config = MagicMock()
+    config.parallel_config.prefill_context_parallel_size = 1
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "1")
+    tpu_platform.TpuPlatform._maybe_install_v1_pcp_capability_shim(config)
+    install.assert_not_called()
+
+
+def test_pcp2_new_model_design_installs_shim(monkeypatch):
+    install = MagicMock()
+    scheduler_patch = MagicMock()
+    monkeypatch.setattr(tpu_platform.TpuPlatform,
+                        "_install_v1_pcp_capability_shim", install)
+    monkeypatch.setattr(sched_utils, "patch_vllm_scheduler_for_tpu_pcp",
+                        scheduler_patch)
+    config = MagicMock()
+    config.parallel_config.prefill_context_parallel_size = 2
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "1")
+    tpu_platform.TpuPlatform._maybe_install_v1_pcp_capability_shim(config)
+    install.assert_called_once_with()
+    scheduler_patch.assert_called_once_with()
+
+
+def test_legacy_model_design_does_not_install_shim(monkeypatch):
+    install = MagicMock()
+    scheduler_patch = MagicMock()
+    monkeypatch.setattr(tpu_platform.TpuPlatform,
+                        "_install_v1_pcp_capability_shim", install)
+    monkeypatch.setattr(sched_utils, "patch_vllm_scheduler_for_tpu_pcp",
+                        scheduler_patch)
+    config = MagicMock()
+    config.parallel_config.prefill_context_parallel_size = 2
+    monkeypatch.setenv("NEW_MODEL_DESIGN", "0")
+    tpu_platform.TpuPlatform._maybe_install_v1_pcp_capability_shim(config)
+    install.assert_not_called()
+    scheduler_patch.assert_not_called()
