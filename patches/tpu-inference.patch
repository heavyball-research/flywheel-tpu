+def _reference_vit(q, k, v, boundaries, scale):
+    expected = np.zeros(q.shape, np.float32)
+    for start, end in pairwise(boundaries):
+        if start == end:
+            continue
+        q_part, k_part, v_part = (np.asarray(x[:, start:end], np.float32)
+                                  for x in (q, k, v))
+        scores = np.einsum("bqhd,bkhd->bhqk", q_part, k_part)
+        scores *= 1.0 if scale is None else scale
+        weights = np.exp(scores - scores.max(axis=-1, keepdims=True))
+        weights /= weights.sum(axis=-1, keepdims=True)
+        expected[:, start:end] = np.einsum("bhqk,bkhd->bqhd", weights, v_part)
+    return expected
+
