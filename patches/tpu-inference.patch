+    @pytest.mark.parametrize(("bucket", "crossover"), [
+        (32768, 28673),
+        (98304, 92161),
+        (131072, 122881),
+    ])
+    def test_single_request_crossover(self, bucket, crossover):
+        # Note (david): both paths pay for the bucket's pad tail, so dense
+        # takes over only near the top of the bucket: at 0.875 of 32768 and
+        # 0.9375 of the two long buckets. Measured on one v6e chip with 3
+        # query heads of head_dim 256, the ragged kernel is faster at 0.8 of
+        # the 32768 bucket (2.08 ms against 2.39 ms dense) and slower at 0.9
+        # (2.49 ms), and faster at 0.9 of the 98304 bucket (19.07 ms against
+        # 19.81 ms) and slower at 0.95 (20.60 ms).
+        assert fa.dense_prefill_shape([[crossover - 1]], bucket) == (-1, -1)
+        assert fa.dense_prefill_shape([[crossover]], bucket) == (1, bucket)
+        # Note (david): the crossover is not a clean threshold, because the
+        # ragged step count drops wherever the tail loses a block. It does
+        # bracket the decision: every request in the bucket's last dense
+        # block is dense, and everything at or under three quarters of the
+        # bucket is ragged.
+        assert all(
+            fa.dense_prefill_shape([[length]], bucket) == (1, bucket)
+            for length in range(bucket - fa.DENSE_MAX_BLOCK + 1, bucket + 1))
+        assert all(
+            fa.dense_prefill_shape([[length]], bucket) == (-1, -1)
+            for length in range(bucket // 2 + 1, 3 * bucket // 4 + 1, 61))
+
+    def test_a_request_far_under_its_bucket_stays_ragged(self):
+        # Note (david): there is no absolute floor above which a lone request
+        # is dense. The same 110000-token prompt is dense at the 114688
+        # bucket and ragged at 131072, and a 104832-token one padded to
+        # 131072 measured 27.48 ms ragged against 34.97 ms dense (3 query
+        # heads of head_dim 256, one v6e chip). Length alone decides nothing;
+        # only its share of the bucket does.
+        assert fa.dense_prefill_shape([[110000]], 114688) == (1, 114688)
+        assert fa.dense_prefill_shape([[110000]], 131072) == (-1, -1)
+        assert fa.dense_prefill_shape([[104832]], 131072) == (-1, -1)
+
+    def test_a_request_far_under_a_long_bucket_is_dense_again(self):
+        # Note (david): the ragged kernel charges the whole unfilled tail its
+        # own block-diagonal, so a request holding a small fraction of a long
+        # bucket costs nearly what filling it would and the dense row wins
+        # back. Measured at the 131072 bucket: a 2048-token request takes
+        # 37.60 ms ragged (1 real plus 2016 tail steps) against 35.15 ms for
+        # the dense row.
+        assert fa.dense_prefill_shape([[2048]], 131072) == (1, 131072)
+        assert fa.dense_prefill_shape([[8192]], 131072) == (-1, -1)
