+# SPDX-License-Identifier: Apache-2.0
+"""Linear attention dispatch and state mapping through a real shard_map."""
+
+import functools
+from types import SimpleNamespace
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+from jax.sharding import Mesh
+
+from tpu_inference import envs
+from flywheel_tpu.linear_attention.gdn import wrapper as flywheel_wrapper
+from flywheel_tpu.linear_attention.kda import wrapper as kda_wrapper
+from tpu_inference.layers.common import (gdn_attention, kda_attention,
+                                         linear_attention)
+
+ENV_FLAG = "USE_FLYWHEEL_TPU_LINEAR_KERNEL"
+NUM_TOKENS = 8
+HEADS_PER_SHARD = 2
+HEAD_DIM = 128
+KERNEL_SIZE = 4
+QKV_DIM_PER_SHARD = 3 * HEADS_PER_SHARD * HEAD_DIM
+GATE_DIM_PER_SHARD = HEADS_PER_SHARD * HEAD_DIM
+NUM_STATE_SLOTS = 4
+WRITE_SLOT = 2
+READ_SLOT = 1
+# Note (david): a nonzero computed-token count puts the request on the resume
+# path, where the kernel reads an initial state from read_state_indices.
+NUM_COMPUTED_TOKENS = 16
+V3_MARKER = 1
+FLYWHEEL_MARKER = 2
+
+
+def make_linear_attention_inputs(tp_size: int) -> dict[str, object]:
+    devices = jax.devices("cpu")
+    if len(devices) < tp_size:
+        pytest.skip(f"Requires {tp_size} CPU devices")
+    mesh = Mesh(
+        np.array(devices[:tp_size]).reshape(1, 1, 1, 1, tp_size, 1, 1),
+        ("data", "pcp", "attn_dp", "attn_dp_expert", "model", "expert", "dcp"))
+    num_heads = HEADS_PER_SHARD * tp_size
+    qkv_dim = QKV_DIM_PER_SHARD * tp_size
+    conv_state_shape = (NUM_STATE_SLOTS, KERNEL_SIZE - 1, qkv_dim)
+    conv_state = jnp.arange(np.prod(conv_state_shape),
+                            dtype=jnp.float32).reshape(conv_state_shape)
+    recurrent_state = jnp.ones(
+        (NUM_STATE_SLOTS, num_heads, HEAD_DIM, HEAD_DIM), jnp.float32)
+    return {
+        "j_mixed_qkv": jnp.ones((NUM_TOKENS, qkv_dim), jnp.bfloat16),
+        "j_b": jnp.ones((NUM_TOKENS, num_heads), jnp.bfloat16),
+        "j_a": jnp.ones((NUM_TOKENS, num_heads), jnp.bfloat16),
+        "conv_state": conv_state,
+        "recurrent_state": recurrent_state,
+        "j_conv_weight": jnp.ones((qkv_dim, 1, KERNEL_SIZE), jnp.float32),
+        "j_conv_bias": None,
+        "j_A_log": jnp.ones((num_heads, ), jnp.float32),
+        "j_dt_bias": jnp.ones((num_heads, ), jnp.float32),
+        "state_indices": jnp.array([WRITE_SLOT], jnp.int32),
+        "read_state_indices": jnp.array([READ_SLOT], jnp.int32),
+        "query_start_loc": jnp.array([0, NUM_TOKENS], jnp.int32),
+        "distribution": jnp.array([0, 1, 1], jnp.int32),
+        "seq_lens": jnp.array([NUM_TOKENS + NUM_COMPUTED_TOKENS], jnp.int32),
+        "n_kq": num_heads,
+        "n_v": num_heads,
+        "d_k": HEAD_DIM,
+        "d_v": HEAD_DIM,
+        "kernel_size": KERNEL_SIZE,
+        "mesh": mesh,
+    }
+
+
+def test_flywheel_linear_attention_flag_reads_the_environment(monkeypatch):
+    monkeypatch.delenv(ENV_FLAG, raising=False)
+    assert envs.USE_FLYWHEEL_TPU_LINEAR_KERNEL is False
+    monkeypatch.setenv(ENV_FLAG, "1")
+    assert envs.USE_FLYWHEEL_TPU_LINEAR_KERNEL is True
+    monkeypatch.setenv(ENV_FLAG, "0")
+    assert envs.USE_FLYWHEEL_TPU_LINEAR_KERNEL is False
+
+
+@pytest.mark.parametrize("is_flywheel_kernel", [False, True])
+@pytest.mark.parametrize("tp_size", [1, 2])
+@pytest.mark.parametrize("has_separate_read_slot", [False, True])
+def test_gdn_dispatch_preserves_sharding_and_state_slots(
+        monkeypatch, is_flywheel_kernel, tp_size, has_separate_read_slot):
+    monkeypatch.setenv(ENV_FLAG, "1" if is_flywheel_kernel else "0")
+
+    def _run(marker, qkv, b, a, conv_state, recurrent_state, conv_weight,
+             conv_bias, a_log, dt_bias, query_start_loc, state_indices,
+             distribution, seq_lens, read_state_indices, *, n_kq, n_v, d_k,
+             d_v, kernel_size):
+        assert n_kq == n_v == HEADS_PER_SHARD
+        assert qkv.shape == (NUM_TOKENS, QKV_DIM_PER_SHARD)
+        assert qkv.dtype == jnp.bfloat16
+        new_conv_state = conv_state.at[state_indices].set(
+            conv_state[read_state_indices] + marker)
+        new_recurrent_state = recurrent_state.at[state_indices].set(
+            recurrent_state[read_state_indices] + marker)
+        output = jnp.full((qkv.shape[0], n_v * d_v), marker, qkv.dtype)
+        return (new_conv_state, new_recurrent_state), output
+
+    monkeypatch.setattr(gdn_attention.wrapper, "fused_conv1d_gdn",
+                        functools.partial(_run, V3_MARKER))
+    monkeypatch.setattr(flywheel_wrapper, "fused_conv1d_gdn",
+                        functools.partial(_run, FLYWHEEL_MARKER))
+    inputs = make_linear_attention_inputs(tp_size)
+    if not has_separate_read_slot:
+        inputs.pop("read_state_indices")
+    (conv_state,
+     recurrent_state), output = gdn_attention.run_jax_gdn_attention(**inputs)
+
+    marker = FLYWHEEL_MARKER if is_flywheel_kernel else V3_MARKER
+    read_slot = READ_SLOT if has_separate_read_slot else WRITE_SLOT
+    np.testing.assert_array_equal(output.astype(jnp.float32), marker)
+    np.testing.assert_array_equal(conv_state[WRITE_SLOT],
+                                  inputs["conv_state"][read_slot] + marker)
+    np.testing.assert_array_equal(conv_state[0], inputs["conv_state"][0])
+    np.testing.assert_array_equal(
+        recurrent_state[WRITE_SLOT],
+        inputs["recurrent_state"][read_slot] + marker)
+
+
+@pytest.mark.parametrize("tp_size", [1, 2])
+@pytest.mark.parametrize("lower_bound", [None, -5.0])
+@pytest.mark.parametrize("beta_is_activated", [False, True])
+def test_kda_forwards_raw_gate_and_gate_options(monkeypatch, tp_size,
+                                                lower_bound,
+                                                beta_is_activated):
+    inputs = make_linear_attention_inputs(tp_size)
+    inputs.pop("j_a")
+    gate_dim = GATE_DIM_PER_SHARD * tp_size
+    inputs["j_gate"] = jnp.arange(NUM_TOKENS * gate_dim,
+                                  dtype=jnp.float32).reshape(
+                                      NUM_TOKENS,
+                                      gate_dim).astype(jnp.bfloat16)
+    inputs["j_dt_bias"] = jnp.arange(gate_dim, dtype=jnp.float32)
+
+    def _run(qkv, b, g, conv_state, recurrent_state, conv_weight, conv_bias,
+             a_log, dt_bias, query_start_loc, state_indices, distribution,
+             seq_lens, read_state_indices, **options):
+        assert options["n_kq"] == options["n_v"] == HEADS_PER_SHARD
+        assert options["lower_bound"] == lower_bound
+        assert options["beta_is_activated"] == beta_is_activated
+        assert g.shape == (NUM_TOKENS, GATE_DIM_PER_SHARD)
+        assert dt_bias.shape == (GATE_DIM_PER_SHARD, )
+        return (conv_state, recurrent_state), g + dt_bias
+
+    monkeypatch.setattr(kda_wrapper, "fused_conv1d_kda", _run)
+    (conv_state,
+     recurrent_state), output = kda_attention.run_jax_kda_attention(
+         **inputs,
+         lower_bound=lower_bound,
+         beta_is_activated=beta_is_activated)
+
+    np.testing.assert_array_equal(output,
+                                  inputs["j_gate"] + inputs["j_dt_bias"])
+    np.testing.assert_array_equal(conv_state, inputs["conv_state"])
+    np.testing.assert_array_equal(recurrent_state, inputs["recurrent_state"])
+
+
+@pytest.mark.parametrize("cache_mode", ["none", "align"])
+def test_linear_attention_metadata_keeps_dp_local_slots(cache_mode):
+    metadata = SimpleNamespace(
+        padded_num_reqs=2,
+        query_start_loc=jnp.array([0, 8, 0, 0, 4, 0], jnp.int32),
+        seq_lens=jnp.array([24, 0, 20, 0], jnp.int32),
+        request_distribution=jnp.array([0, 1, 1, 0, 1, 1], jnp.int32),
+        mamba_state_indices=jnp.array([2, 0, 3, 0], jnp.int32),
+        block_tables=jnp.array([[1, 2, 3], [0, 0, 0], [4, 5, 6], [0, 0, 0]],
+                               jnp.int32),
+    )
+    cache_config = SimpleNamespace(mamba_cache_mode=cache_mode,
+                                   mamba_block_size=8)
+
+    (query_start_loc, seq_lens, distribution, write_state_indices,
+     read_state_indices) = linear_attention.get_linear_attention_metadata(
+         metadata, cache_config, dp_size=2)
+
+    np.testing.assert_array_equal(query_start_loc, [0, 8, 0, 4])
+    np.testing.assert_array_equal(seq_lens, [24, 20])
+    np.testing.assert_array_equal(distribution, metadata.request_distribution)
+    np.testing.assert_array_equal(write_state_indices,
+                                  [3, 6] if cache_mode == "align" else [2, 3])
+    np.testing.assert_array_equal(read_state_indices,
+                                  [2, 5] if cache_mode == "align" else [2, 3])
